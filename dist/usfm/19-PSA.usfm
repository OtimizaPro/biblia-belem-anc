\v 19 [רְצוֹן־יְרֵאָ֥יו] [יַעֲשֶׂ֑ה] [וְֽאֶת־שַׁוְעָתָ֥ם] e-[OBJ] [וְיוֹשִׁיעֵֽם]
\v 20 guardiao yhwh a e-[OBJ] [כָּל־הָרְשָׁעִ֣ים] e-[OBJ] todo [sem-traducao] [sem-traducao]
\v 21 [תְּהִלַּ֥ת] yhwh [יְֽדַבֶּ֫ר] [פִּ֥י] E-abençoou todo [שֵׁ֥ם] nome [לְעוֹלָ֥ם] [וָעֶֽד]
\c 146
\p
\v 1 louvai [הַלְלִ֥י] [נַ֝פְשִׁ֗י] [אֶת־יְהוָֽה] a yhwh
\v 2 [אֲהַלְלָ֣ה] yhwh [בְּחַיָּ֑י] [אֲזַמְּרָ֖ה] [לֵֽאלֹהַ֣י] [בְּעוֹדִֽי]
\v 3 a [בִנְדִיבִ֑ים] [בְּבֶן־אָדָ֓ם] [׀] [שֶׁ֤אֵֽין] a-ele a-ele
\v 4 [תֵּצֵ֣א] [ר֭וּחוֹ] habitou [לְאַדְמָת֑וֹ] no-dia [הַ֝ה֗וּא] [אָבְד֥וּ] [עֶשְׁתֹּנֹתָֽיו]
\v 5 [אַשְׁרֵ֗י] [שֶׁ֤אֵ֣ל] Jacó [בְּעֶזְר֑וֹ] [שִׂ֝בְר֗וֹ] sobre yhwh
\v 6 [עֹשֶׂ֤ה] céus [שָׁ֘מַ֤יִם] a [אֶת־הַיָּ֥ם] e-[OBJ] todo que [לְעוֹלָֽם]
\v 7 fez [מִשְׁפָּ֨ט] [׀] deu [נֹתֵ֣ן] pão yhwh yhwh [מַתִּ֥יר]
\v 8 yhwh [׀] [פֹּ֘קֵ֤חַ] yhwh yhwh [זֹקֵ֣ף] yhwh yhwh [אֹהֵ֥ב]
\v 9 yhwh [׀] a [אֶת־גֵּרִ֗ים] [יָת֣וֹם] [וְאַלְמָנָ֣ה] [יְעוֹדֵ֑ד] [וְדֶ֖רֶךְ] ímpios [יְעַוֵּֽת]
\v 10 [יִמְלֹ֤ךְ] yhwh [׀] [לְעוֹלָ֗ם] [אֱלֹהַ֣יִךְ] [צִ֭יּוֹן] [לְדֹ֥ר] louvai [הַֽלְלוּ־יָֽהּ]
\c 147
\p
\v 1 louvai [יָ֨הּ] porque bom [זַמְּרָ֣ה] nosso-Elohim porque [נָאוָ֥ה] [תְהִלָּֽה] [sem-traducao]
\v 2 [בּוֹנֵ֣ה] [יְרוּשָׁלַ֣͏ִם] yhwh [נִדְחֵ֖י] Israel [יְכַנֵּֽס]
\v 3 [הָ֭רֹפֵא] [לִשְׁב֣וּרֵי] coração [וּ֝מְחַבֵּ֗שׁ] [לְעַצְּבוֹתָֽם]
\v 4 [מוֹנֶ֣ה] [מִ֭סְפָּר] [לַכּוֹכָבִ֑ים] [לְ֝כֻלָּ֗ם] [שֵׁמ֥וֹת] chamaria
\v 5 grande [אֲדוֹנֵ֣ינוּ] e-grande [לִ֝תְבוּנָת֗וֹ] [אֵ֣ין] não-há [sem-traducao]
\v 6 [מְעוֹדֵ֣ד] [עֲנָוִ֣ים] yhwh [מַשְׁפִּ֖יל] ímpios ate terra
\v 7 [עֱנ֣וּ] a-yhwh [בְּתוֹדָ֑ה] [זַמְּר֖וּ] [לֵאלֹהֵ֣ינוּ] [בְכִנּֽוֹר]
\v 8 [הַֽמְכַסֶּ֬ה] [שָׁמַ֨יִם] [׀] [בְּעָבִ֗ים] a-terra [לָאָ֣רֶץ] [מָטָ֑ר] os-montes [הָרִ֣ים]
\v 9 [נוֹתֵ֣ן] [לִבְהֵמָ֣ה] [לַחְמָ֑הּ] para-os-filhos-de tarde que [יִקְרָֽאוּ]
\v 10 não [בִגְבוּרַ֣ת] [הַסּ֣וּס] [יֶחְפָּ֑ץ] não [הָאִ֣ישׁ] o-homem [sem-traducao]
\v 11 [רוֹצֶ֣ה] yhwh a [אֶת־הַֽמְיַחֲלִ֥ים] a
\v 12 [שַׁבְּחִ֣י] [יְ֭רוּשָׁלִַם] a yhwh [אֱלֹהַ֣יִךְ] [צִיּֽוֹן]
\v 13 porque [בְּרִיחֵ֣י] [שְׁעָרָ֑יִךְ] [בֵּרַ֖ךְ] abençoou [בְּקִרְבֵּֽךְ]
\v 14 [הַשָּׂם־גְּבוּלֵ֥ךְ] [שָׁל֑וֹם] [חֵ֥לֶב] [חִ֝טִּ֗ים] [יַשְׂבִּיעֵֽךְ]
\v 15 [הַשֹּׁלֵ֣חַ] [אִמְרָת֣וֹ] terra até [יָר֥וּץ] [דְּבָרֽוֹ]
\v 16 [הַנֹּתֵ֣ן] [שֶׁ֣לֶג] [כַּצָּ֑מֶר] [כְּ֝פ֗וֹר] [כָּאֵ֥פֶר] [יְפַזֵּֽר]
\v 17 [מַשְׁלִ֣יךְ] [קַֽרְח֣וֹ] [כְפִתִּ֑ים] diante-de [קָ֝רָת֗וֹ] quem [יַעֲמֹֽד]
\v 18 [יִשְׁלַ֣ח] [דְּבָר֣וֹ] [וְיַמְסֵ֑ם] habitou [ר֝וּח֗וֹ] [יִזְּלוּ־מָֽיִם] águas
\v 19 [מַגִּ֣יד] [*דברו] [**דְּבָרָ֣יו] [לְיַעֲקֹ֑ב] [חֻקָּ֥יו]
\v 20 não fez [כֵ֨ן] para-todo nação [וּמִשְׁפָּטִ֥ים] não [הַֽלְלוּ־יָֽהּ]
\c 148
\p
\v 1 louvai [יָ֨הּ] [׀] a yhwh de os-céus [בַּמְּרוֹמִֽים] [sem-traducao]
\v 2 [הֽ͏ַלְל֥וּהוּ] todo [הַֽ֝לְל֗וּהוּ] [כָּל־*צבאו] todo
\v 3 [הַֽ֭לְלוּהוּ] [שֶׁ֣מֶשׁ] [וְיָרֵ֑חַ] [הַ֝לְל֗וּהוּ] todo luz luz
\v 4 [הַֽ֭לְלוּהוּ] [שְׁמֵ֣י] os-céus [וְ֝הַמַּ֗יִם] [אֲשֶׁ֤ר] [׀] de-cima-de
\v 5 [יְֽ֭הַֽלְלוּ] a yhwh que ele ele ordenou
\v 6 [וַיַּעֲמִידֵ֣ם] [לָעַ֣ד] para-sempre [חָק־נָ֝תַ֗ן] deu e-não
\v 7 [הַֽלְל֣וּ] a yhwh de a-terra e-todo
\v 8 fogo [וּ֭בָרָד] [שֶׁ֣לֶג] [וְקִיט֑וֹר] espírito [סְ֝עָרָ֗ה] fez [דְבָרֽוֹ]
\v 9 [הֶהָרִ֥ים] e-todo árvore fruto [וְכָל־אֲרָזִֽים] e-todo
\v 10 [הַֽחַיָּ֥ה] e-todo animal réptil asa
\v 11 reis-de terra e-todo [וְכָל־שֹׁ֥פְטֵי] [אָֽרֶץ] e-todo [sem-traducao] terra
\v 12 [בַּחוּרִ֥ים] e-também [זְ֝קֵנִ֗ים] [עִם־נְעָרֽ͏ִים] com
\v 13 [יְהַלְל֤וּ] a nome yhwh porque [שְׁמ֣וֹ] sozinho [ה֝וֹד֗וֹ] [עַל־אֶ֥רֶץ] sobre terra
\v 14 [וַיָּ֤רֶם] [קֶ֨רֶן] [׀] [לְעַמּ֡וֹ] para-todo [לְֽכָל־חֲסִידָ֗יו] aos-filhos-de Israel com [הַֽלְלוּ־יָֽהּ]
\c 149
\p
\v 1 [הַ֥לְלוּיָ֨הּ] [׀] [שִׁ֣ירוּ] [לַֽ֭יהוָה] novo [חָדָ֑שׁ] [תְּ֝הִלָּת֗וֹ] [בִּקְהַ֥ל]
\v 2 [יִשְׂמַ֣ח] Israel [בְּעֹשָׂ֑יו] filhos-de [יָגִ֥ילוּ] [בְמַלְכָּֽם]
\v 3 [יְהַֽלְל֣וּ] [שְׁמ֣וֹ] [בְמָח֑וֹל] [בְּתֹ֥ף] [וְ֝כִנּ֗וֹר] [יְזַמְּרוּ־לֽוֹ]
\v 4 porque yhwh yhwh [יְפָאֵ֥ר] [עֲ֝נָוִ֗ים] [בִּישׁוּעָֽה]
\v 5 [יַעְלְז֣וּ] [חֲסִידִ֣ים] [בְּכָב֑וֹד] [יְ֝רַנְּנ֗וּ] sobre
\v 6 [רוֹמְמ֣וֹת] El [בִּגְרוֹנָ֑ם] [וְחֶ֖רֶב] [פִּֽיפִיּ֣וֹת] [בְּיָדָֽם]
\v 7 [לַעֲשׂ֣וֹת] [נְ֭קָמָה] [בַּגּוֹיִ֑ם] [תּֽ֝וֹכֵחֹ֗ת] não
\v 8 [לֶאְסֹ֣ר] [מַלְכֵיהֶ֣ם] [בְּזִקִּ֑ים] [וְ֝נִכְבְּדֵיהֶ֗ם] [בְּכַבְלֵ֥י] [בַרְזֶֽל]
\v 9 [לַעֲשׂ֤וֹת] [בָּהֶ֨ם] [׀] [מִשְׁפָּ֬ט] [כָּת֗וּב] ele ele [לְכָל־חֲסִידָ֗יו] louvai [sem-traducao]
\c 150
\p
\v 1 [הַ֥לְלוּיָ֨הּ] louvai El [בְּקָדְשׁ֑וֹ] [הֽ͏ַ֝לְל֗וּהוּ] na-expansão-de [עֻזּֽוֹ]
\v 2 [הַֽלְל֥וּהוּ] [בִגְבוּרֹתָ֑יו] [הֽ͏ַ֝לְל֗וּהוּ] [כְּרֹ֣ב] [גֻּדְלֽוֹ]
\v 3 [הַֽ֭לְלוּהוּ] [בְּתֵ֣קַע] [שׁוֹפָ֑ר] [הַֽ֝לְל֗וּהוּ] [בְּנֵ֣בֶל] [וְכִנּֽוֹר]
\v 4 [הַֽ֭לְלוּהוּ] [בְּתֹ֣ף] [וּמָח֑וֹל] [הַֽ֝לְל֗וּהוּ] [בְּמִנִּ֥ים] [וְעוּגָֽב]
\v 5 [הַֽלְל֥וּהוּ] [בְצִלְצְלֵי־שָׁ֑מַע] ouviu [בְּֽצִלְצְלֵ֥י] [תְרוּעָֽה]
\v 6 todo [הַ֭נְּשָׁמָה] [תְּהַלֵּ֥ל] [יָ֗הּ] louvai [sem-traducao]
