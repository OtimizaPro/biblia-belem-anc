\ide UTF-8
\h Êxodo
\toc1 Êxodo
\toc2 Êxodo
\toc3 EXO
\mt1 ÊXODO
\c 1
\p
\v 1 e-estes nomes-de filhos-de Israel os-vindos Egito-para com Jacó homem e-casa-sua vieram
\v 2 Reuben Simeão Levi e-Judá
\v 3 Issacar Zebulom e-Benjamim
\v 4 Dã e-Naftali Gade e-Aser
\v 5 e-foi todo alma saídos-de coxa-de Jacó setenta ser e-José foi em-Egito
\v 6 E-morreu José e-todo e-tudo e-todo a-geração a-aquela
\v 7 e-filhos-de Israel frutificaram e-pulularam e-multiplicaram e-multiplicaram-se em-muito muito e-encheu-se a-terra eles
\v 8 E-levantou rei-de novo sobre Egito que não conheceu a José
\v 9 E-disse a eis eis povo filhos-de Israel muito nós de-nós
\v 10 vamos sejamos-sábios a-ele para-que-não multiplique e-será porque aconteçam guerra e-juntar-se-á também ele sobre inimigos-nossos e-lutará contra-nós e-subirá de a-terra
\v 11 e-puseram sobre-ele príncipes-de tributos para afligir-o com-cargas-suas E-edificou cidades-de provisões para-Faraó a Pitom e-a Ramessés
\v 12 e-como afligiam ele assim multiplicava e-assim espalhava-se e-aborreceram-se de-diante-de filhos-de Israel
\v 13 e-fizeram-servir Egito a filhos-de Israel com-dureza
\v 14 e-amarguraram a vidas-suas com-serviço duro com-argamassa e-com-tijolos e-em-todo serviço no-campo את todo serviço-deles que serviram neles com-dureza
\v 15 E-disse rei Egito às-parteiras as-hebreias que nome a-uma Sifrá e-nome-de a-segunda Puá
\v 16 E-disse quando-ajudardes-no-parto a as-hebreias e-verdes sobre ele se ele ele e-matareis a-ele e-se filha ela e-viverá
\v 17 e-temeram as-parteiras a Elohim e-não fizeram como palavra a-elas rei Egito e-fizeram-viver a os-meninos
\v 18 E-chamou rei-de Mitzrayim E-disse E-disse a-elas por-que fizestes a-coisa esta e-fizeram-viver a os-meninos
\v 19 e-disseram as-parteiras a que não não como-as-mulheres as-egípcias as-hebreias porque vivazes elas antes-de vir a-elas a-parteira e-dão-à-luz
\v 20 e-fez-bem Elohim às-parteiras e-multiplicou o-povo e-multiplicaram-se muito
\v 21 e-houve porque temeram as-parteiras a a-eles E-fez a-eles casas
\v 22 E-ordenou Faraó para-todo dizendo para-dizer todo o-filho o-nascido ao-rio lançareis-o e-todo a-filha fareis-viver
\c 2
\p
\v 1 E-andou homem de-casa-de Levi E-tomou a filha-de Levi
\v 2 e-concebeu a-mulher e-deu-à-luz filho E-viu ele porque ele ele e-escondeu-o três meses
\v 3 e-não pôde mais escondê-lo e-tomou para-ele arca-de junco e-betumou-a com-betume e-com-pez e-pôs nela a o-menino e-pôs no-junco sobre beira-de o-rio
\v 4 e-pôs-se irmã-dele de-longe para-saber que- a-ele a-ele
\v 5 e-desceu filha-de Faraó para-lavar-se sobre o-rio e-donzelas-dela caminhando E-viu mão no-meio-de e-viu a a-arca em-meio-de o-junco e-enviou a serva-dela e-tomou-a
\v 6 e-abriu e-viu-o a o-menino e-eis- menino chorando E-disse sobre-ele e-disse de-meninos-de os-hebreus este
\v 7 E-disse irmã-dele a filha-de Faraó para-ti e-chamarei para-ti de ama-de-leite de para-ti e-amamentará para-ti a o-menino
\v 8 e-disse para-ela filha-de פַּרְעֹה vai e-foi a-donzela e-chamou a mãe o-menino
\v 9 E-disse para-ela filha-de פַּרְעֹה leva a o-menino o-este e-amamenta-o para-mim e-eu e-tomou a teu-salário e-tomou a-mulher o-menino e-amamentou-o
\v 10 e-cresceu o-menino e-trouxe-o para-filha-de Faraó e-foi para-ela para-filho e-chamou E-disse que e-disse porque de as-águas משה-o
\v 11 e-houve em-os-dias aqueles e-cresceu Moisés e-saiu a seus-irmãos E-viu com-cargas-suas E-viu homem egípcio golpeando homem hebreu de-seus-irmãos
\v 12 e-voltou-se aqui e-ali E-viu que não-há homem e-golpeou a o-egípcio e-escondeu-o na-areia
\v 13 e-saiu no-dia o-segundo e-eis dois homens hebreus E-disse E-disse ao-malvado por-que golpeias teu-companheiro
\v 14 E-disse quem te-pôs para-homem príncipe e-juiz sobre-nós para-matar-me tu disse como mataste a o-egípcio e-temeu Moisés E-disse certamente conhecido a-palavra
\v 15 E-ouviu Faraó a a-palavra este e-buscou para-matar a Moisés de-diante-de Moisés de-diante-de פַּרְעֹה e-habitou em-terra-de מִדְיָן e-habitou sobre o-poço
\v 16 e-para-sacerdote מִדְיָן sete filhas e-vieram e-tiraram e-encheram a os-bebedouros para-dar-de-beber rebanho seu-pai
\v 17 e-vieram os-pastores e-expulsaram-nas E-levantou Moisés e-salvou-as e-deu-de-beber a seu-rebanho
\v 18 e-vieram a רְעוּאֵל E-disse E-disse por-que apressastes o-dia o-dia
\v 19 e-disseram homem egípcio ele-livrou-nos da-mão-de os-pastores e-também tirando ela-tirou para-nós e-deu-de-beber a o-rebanho
\v 20 E-disse a filhas-dele e-onde-ele por-que isto vós-abandonastes a a-ele chamai para-ele e-ele-comerá pão
\v 21 e-ele-consentiu Moisés para-habitar a E-colocou E-deu a Zípora filha-dele para-Moisés
\v 22 e-deu-à-luz filho E-chamou a nome-de-ele que disse disse forasteiro eu-fui em-terra-de estranha
\v 23 e-houve em-os-dias do-muitos os-aqueles E-morreu rei Egito e-eles-gemeram filhos-de Israel de o-trabalho e-eles-clamaram e-ela-subiu clamor-deles a Elohim de o-trabalho
\v 24 E-ouviu Elohim a gemido-deles e-lembrou Elohim a aliança-dele a Abraão a Isaque e-com Jacó
\v 25 E-viu Elohim a filhos-de Israel e-soube Elohim
\c 3
\p
\v 1 e-Moisés ser apascentando a rebanho-de Jetro sogro-dele sacerdote Midiã e-ele-conduziu a o-rebanho atrás-de o-deserto E-veio a monte-de Elohim Horebe
\v 2 E-viu anjo-de yhwh a-ele em-chama-de fogo de-meio-de E-viu E-viu e-eis a-sarça queimando no-fogo e-a-sarça não-ela consumida
\v 3 E-disse Moisés desviarei agora e-eu-verei o-grande a-visão a-grande este por-que não queima a-sarça
\v 4 E-viu yhwh que desviou para-ver E-chamou a-ele Elohim de-meio-de a-sarça E-disse Moisés Moisés E-disse eis-me
\v 5 E-disse a te-aproximes aqui de-cima-de sandálias-tuas que pés-teus porque tu que tu estando-em-pé ele terra-de santidade ela
\v 6 E-disse eu Elohim-de pai-teu Elohim-de Abraão Elohim-de Isaque e-Elohim-de Jacó e-ele-escondeu Moisés rosto-dele que temer de-olhar a Elohim
\v 7 E-disse yhwh viu vi a aflição-de povo-meu que em-Egito e-a de-diante-de ouvi que opressores-seus porque conheci a dores-suas
\v 8 e-desci para-livrar-o da-mão-de Egito e-para-fazer-subir-o de a-terra aquela a terra boa e-larga a terra fluindo-de leite e-mel a lugar-de o-cananeu e-o-heteu e-o-amorreu e-o-perizeu e-o-heveu e-o-jebuseu
\v 9 e-agora eis clamor-de filhos-de Israel veio a-mim e-também vi a a-opressão eles Egito oprimindo a-eles
\v 10 e-agora vai e-enviarei-te a Faraó e-faze-sair a povo-meu filhos-de Israel de-Egito
\v 11 E-disse Moisés a quem eu que porque irei a Faraó e-que farei-sair a filhos-de Israel de-Egito
\v 12 E-disse porque estarei contigo e-este que eu porque eu enviei-te em-fazeres-sair-tu a o-povo sobre servireis a Elohim sobre a-montanha a-esta
\v 13 E-disse Moisés a eis eu eu veio a filhos-de a-eles e-disser a-eles Elohim-de pais-vossos enviou-me a-vós e-disserem a-mim que- nome-seu que disse a-eles
\v 14 E-disse Elohim a Moisés EU-SOU que E-disse E-disse assim dirás a-filhos-de Israel EU-SOU enviou-me a-vós
\v 15 E-disse ainda Elohim a Moisés assim dirás yhwh filhos-de Israel yhwh Elohim-de pais-vossos Elohim-de Abraão Elohim-de Isaque e-Elohim-de Jacó para-sempre a-vós este nome-meu para-sempre e-esta memória-minha para-geração geração
\v 16 vai e-reunirás a anciãos-de Israel e-dirás yhwh yhwh Elohim-de pais-vossos apareceu a-mim Elohim-de Abraão Isaque dizendo para-dizer visitar visitei a-vós a-vós o-feito para-vocês em-Egito
\v 17 e-disse farei-subir a-vós de-aflição-de Egito a terra o-cananeu e-o-heteu e-o-amorreu e-o-perizeu e-o-heveu e-o-jebuseu a terra que-flui leite e-mel
\v 18 e-ouvirão a-voz-tua e-virás tu e-anciãos-de Israel a rei Egito a-ele yhwh yhwh Elohim-de os-hebreus encontrou-nos e-agora e-agora o-caminho-de por-favor caminho três-de dias no-deserto e-sacrificaremos a-יהוה Elohim-nosso
\v 19 e-eu soube que não dará a-vós rei Egito para-ir e-não com-mão forte
\v 20 e-enviarei a mão-minha e-ferirei a Egito em-todo maravilhas-minhas que eu-farei em-meio-dele e-depois-de assim enviará a-vós
\v 21 e-darei a favor o-povo- este em-olhos-de que e-será não ides não ireis vazios
\v 22 e-pedirá mulher de-vizinha-dela e-de-habitante-de casa-dela objetos-de prata ouro ouro e-vestimentas e-poreis sobre filhos-vossos e-sobre filhas-vossas e-despojareis a Egito
\c 4
\p
\v 1 e-respondeu Moisés E-disse e-eis não crerão em-mim e-não ouvirão que porque dirão não yhwh a-ti yhwh
\v 2 E-disse a-ele yhwh em-mão-tua E-disse cajado
\v 3 E-disse lança-o terra-para e-lançou-o terra-para e-houve para-serpente e-fugiu Moisés de-face-dele
\v 4 E-disse yhwh a Moisés enviou mão-tua e-segura em-cauda-dele sua-mão mão-dele e-segurou e-houve E-foi para-cajado em-palma-dele
\v 5 para-que creiam porque apareceu yhwh yhwh Elohim-de pais-deles Elohim-de Abraão Elohim-de Isaque e-Elohim-de Jacó
\v 6 E-disse yhwh a-ele ainda traze- por-favor mão-tua e-trouxe sua-mão mão-sua em-seio-seu e-ele-tirou-a sua-mão mão-sua leprosa como-a-neve
\v 7 E-disse retorna mão-tua a seio-teu sua-mão mão-sua a seio-seu e-ele-tirou-a de-seio-seu e-eis- ela-retornou como-carne-sua
\v 8 e-será se não para-ti para-ti e-não eles-ouvirão para-voz-de o-sinal o-primeiro e-eles-crerão para-voz-de o-sinal o-último
\v 9 e-será se não também também para-dois-de os-sinais estes e-não eles-ouvirão para-voz-tua e-tu-tomarás de-águas-de o-rio e-tu-derramarás e-sejam e-serão as-águas que tu-tomarás e-sejam o-rio e-serão para-sangue na-terra-seca
\v 10 E-disse Moisés a yhwh por-mim não não homem eu também também também também também também desde-então a que porque pesado-de boca eu língua eu
\v 11 E-disse yhwh a-ele quem nome boca para-o-homem ou quem- ele-coloca mudo ou surdo ou que-vê ou cego eu yhwh yhwh
\v 12 e-agora vai e-eu estarei com boca-tua e-eu-ensinarei-te que tu-falarás
\v 13 E-disse por-mim Adonai envia- por-favor por-mão-de tu-enviarás
\v 14 e-acendeu-se- yhwh yhwh E-disse E-disse não-é-que אַהֲרֹן irmão-teu o-levita eu-sei porque ele ele-falará ele sai eis-que- ele saindo para-encontro-teu e-ele-te-verá e-ele-se-alegrará em-coração-seu
\v 15 e-tu-falarás a-ele e-tu-colocarás a as-palavras em-boca-sua e-eu estarei com boca-tua e-com- boca-sua e-eu-ensinarei a-vós את que vós-fareis
\v 16 e-ele-falará- a-ti para-ti a ele e-será ele ele-será- para-ti para-boca e-tu será- para-ele para-Elohim
\v 17 e-a o-bastão este tu-tomarás em-mão-tua que farás- nele a os-sinais
\v 18 E-andou Moisés e-voltou a Jetro sogro-seu E-disse a-ele irei por-favor e-voltarei a irmãos-meus que em-Egito vida E-disse vivos E-disse Jetro para-Moisés vai em-paz
\v 19 E-disse yhwh a Moisés em-Midiã vai retornou Egito porque morreram todo os-homens os-que-buscam a alma-tua
\v 20 E-tomou Moisés a mulher-sua e-a filhos-seus e-fez-montar-os sobre o-jumento E-tomou terra-para Egito E-tomou Moisés a bastão-de o-Elohim em-mão-sua
\v 21 E-disse yhwh a Moisés em-ir-teu para-voltar Egito-para viu todo os-prodígios que coloquei em-mão-tua e-farás-os diante-de Faraó e-eu fortalecerei a coração-dele e-não enviará a o-povo
\v 22 e-dirás a Faraó disse yhwh yhwh filhos-de primogênito-meu Israel
\v 23 e-disse a-ti enviou a filhos-de e-servirá-me e-recusaste eis eu eu matando a filho-teu primogênito-teu
\v 24 e-houve no-caminho na-hospedaria e-encontrou-o yhwh e-buscou matá-lo
\v 25 e-tomou Zípora pedra e-cortou a prepúcio-de filho-seu e-tocou E-disse que porque tu sangues tu para-mim
\v 26 e-desistiu nós então disse noivo-de sangues para-circuncisões
\v 27 E-disse yhwh a Arão vai para-encontro-de Moisés o-deserto-para E-andou e-encontrou-o em-monte-de o-Elohim e-beijou- para-ele
\v 28 e-contou Moisés para-Arão objeto-direto todo yhwh yhwh que enviou-o e-a todo os-sinais que ordenou-o
\v 29 E-andou Moisés e-Arão e-reuniram a todo anciãos-de filhos-de Israel
\v 30 e-falou Aarão את todo as-palavras yhwh palavra yhwh a Moisés E-fez os-sinais para-olhos-de o-povo
\v 31 e-creu o-povo e-ouviram porque yhwh yhwh a filhos-de ver e-que viu a aflição-deles e-inclinaram-se e-prostraram-se
\c 5
\p
\v 1 e-depois vieram Moisés e-Aarão e-disseram a Faraó yhwh disse yhwh Elohim-de Israel enviou a povo-meu e-celebrem para-mim no-deserto
\v 2 E-disse Faraó quem yhwh que escutarei em-voz-dele para-enviar a não não conheci a yhwh não a Israel não enviarei
\v 3 e-disseram Elohim-de os-hebreus encontrou-se sobre-nós iremos por-favor o-caminho-de três-de dias no-deserto e-sacrificaremos para-יהוה Elohim-nosso para-que-não encontre-nos com-a-pestilência ou com-a-espada
\v 4 E-disse para-eles rei Egito por-que Moisés e-Aarão fazeis-cessar a o-povo de-obras-dele ide para-trabalhos-forçados-vossos
\v 5 E-disse Faraó eis muitos agora a-terra a-terra eles eles de-trabalhos-forçados-deles
\v 6 E-ordenou פַּרְעֹה no-dia o-aquele a os-feitores no-povo dizendo oficiais-dele para-dizer
\v 7 não continuareis para-dar palha para-o-povo para-fazer-tijolos as-tijolos como-ontem e-hoje eles e-eles-irão e-eles-colherão a-eles palha
\v 8 e-a ordem as-tijolos eles eles fazendo ontem antes-de-ontem colocareis não não nós de-ele eles desceiros eles sobre dizendo eles clamando dizendo venhamos sacrifiquemos א-לוהינו
\v 9 se-tornará-pesada a-obra sobre os-homens e-farão--- nela e-a clamarão em-palavras-de--- mentira
\v 10 e-saíram de-mandatários o-povo e-de-seus-oficiais e-disseram a dizendo dizendo disse disse Faraó não-sou a-vós a-vós teven
\v 11 vocês ide tomai a-vós teven de-o-que encontrareis que não-há impuro de-vossa-trabalho palavra
\v 12 e-dispersou o-povo em-todo terra Egito para-colher kash- la-teven-
\v 13 ve-han-nogshim- atzim- dizendo khalu- ma-ashechem- palavra-de dia be-yomo- como bi-heyet- ha-teven-
\v 14 va-yukhu- oficiais-de filhos-de Israel que colocaram em-eles opressores-de dizendo dizendo não não esgotaram-vos rasgastes-vos para-branco como-ontem anteontem também ontem também o-dia
\v 15 e-vieram oficiais-de filhos-de Israel e-clamaram a dizendo dizendo por-que fazes assim para-os-teus-servos
\v 16 pedra não-há deu para-o-servos-teus e-para-pedras dizendo para-nós fazei e-eis servos-teus machucados e-pecado povo-tua
\v 17 E-disse n-rasos vós n-rasos sobre assim vós dizendo-os vamos-nós n-sacrificaremos para-יהוה
\v 18 e-agora ide serviremos-ele e-tijolo não a-vós a-vós e-o-interno para-os-tijolos dará-vos
\v 19 e-eles-veem de-oficiais filhos-de eles eles dizendo dizendo não tirar-vós dos-tijolos-vossos palavra-de dia em-dia-de-o
\v 20 e-eles-encontraram-se a Moisés e-com Arão estando-plantados para-enfrentá-los em-sair-de-eles de-a פַּרְעֹה
\v 21 e-disseram a-eles veira yhwh sobre-vós veyishpot que hibashatem a reicheinu be-einei Pharaoh uve-einei seus-servos para-dar cherev byeidam para-nos-matar-:
\v 22 e-estabeleceu-se Moisés a yhwh E-disse Adonai por-que o-mau ao-povo esta por-que isto me-destinaste
\v 23 e-desde-o-tempo eu-vi a Faraó para-falar em-tu-nome foi-mau ao-povo esta e-o-salve não salvaste a o-seu-povo
\c 6
\p
\v 1 E-disse yhwh a Moisés agora verás que farei que porque com-a-mão forte os-enviará e-com-a-mão forte os-expulsará de-a-terra-o
\v 2 e-falou Elohim a E-disse a-ele a-ele yhwh yhwh
\v 3 e-eu-apareci a Abraão a Isaque e-a Jacó yhwh não e-meu-nome a-eles não conheci-me para-eles
\v 4 e-tambem ergui-eu a aliança-minha com-elas-os a-eles a-eles a terra terra a terra moradas-deles-os que moraram em-ela
\v 5 e-tambem eu ouvi a clamor-de filhos-de Israel que Egito servos eles e-elembrei-me a em-pacto-meu
\v 6 portanto disse filhos-de Israel yhwh yhwh e-sairei debaixo-de de-baixo-de sílulas Egito e-salvarei vos de-servidão-de-eles e-redimir-eu vos com-braco estendida e-com-juízos grandes-
\v 7 e-eu-tomarei a-vocês para-mim para-povo e-eu-serei a-vós para-אלהים e-vocês-sabereis que eu yhwh אֱלֹהִים-de-vós o-que-tirou vos debaixo-de sendes Egito
\v 8 e-eu-trarei vos a a-terra que eu-elevei a minha-mão para-dar a-ela le-abraham para-Isaque e-para-JaŃob a-vós essa-a a-vós yhwh eu yhwh
\v 9 e-falou Moisés assim a filhos-de Israel e-não ouviram a espírito de-curto espírito e-de-trabalho dura-:
\v 10 e-falou yhwh a Moisés dizendo
\v 11 veio palavra a פַּרְעֹה rei Egito e-enviará a filhos-de Israel de-a-terra-o
\v 12 e-falou Moisés diante-de yhwh dizendo eis filhos-de Israel não ouviu a-mim e-como me-ouvam פַּרְעֹה e-eu erem lábios-verso
\v 13 e-falou yhwh a Moisés e-a Aharon- e-ele-comandou-os a filhos-de Israel e-a פַּרְעֹה rei Egito para-sair a filhos-de Israel de-terra-de Egito
\v 14 Estas cabeças-de casa-de pais-deles filhos-de Reuven- primogênito-de Israel Chenoch- e-Palu- Chezron- Estas estes famílias-de Reuven-verso
\v 15 e-filhos-de Shimon- Yemu'el ve-Yamin ve-Ohad ve-Yakin ve-Tsohar ve-Shaul filho-de Estas estes famílias-de Simeão
\v 16 ve-Eleh Shmot filhos-de Levi le-Toldotam Gérson e-Coate e-meu-amargura e-dois chayyei Levi sete e-trinta e-cem anos
\v 17 filhos-de Gerson para-meu-filho e-Shimi para-famílias-deles
\v 18 e-filhos-de Qehat Anrão e-Izar e-Chevron e-Uziel e-dois chayyei Qehat três e-trinta e-cem anos
\v 19 e-filhos-de miseria Mahli e-Mushi Estas famílias-de o-levita para-os-filhos-deles
\v 20 E-tomou Amram a Joquebede a-ele a-ele para-esposa a-ele a-ele a אַהֲרֹן e-a Moisés e-dois chayyei Amram sete e-trinta e-cem anos
\v 21 e-filhos-de Isar Coré e-Nofeg e-Zicri
\v 22 e-filhos-de Uziel Misha-el e-Eltsafan e-Sitri
\v 23 E-tomou Arão a Elisheba filha-de Amminadab a-ele Nasom a-ele a-ele e-deu-à-luz para-ele a Nadav e-a Abihu a Elazar e-a Itamar
\v 24 e-filhos-de Qorach Assir e-ekana e-abiasaf Estas famílias-de o-karchi-:
\v 25 e-elazar filho-de Arão tomou- a-ele a-ele putiael a-ele a-ele e-deu-à-luz Estas a pinchas estes cabeças-de pais os-levitas para-famílias-deles
\v 26 ele אַהֲרֹן e-Mosheh que disse yhwh a-eles extraiu-os a filhos-de Israel da-terra-de Egito sobre exércitos-deles-verso
\v 27 eles os-falando a faráoh rei-de Egito para-sair ele filhos-de Israel de-Egito ele Moisés e-Aarão
\v 28 e-houve no-dia palavra yhwh a Moisés em-terra-de Egito
\v 29 e-ele-falou yhwh a Moisés dizendo yhwh yhwh palavra a Faraó rei Egito a todo que eu palavra para-ti
\v 30 E-disse Moisés diante-de yhwh eis eu cortar lábios-de-duas e-como ele-ouvirá a-mim פַּרְעֹה
\c 7
\p
\v 1 E-disse yhwh a Moisés viu dei-te Elohim para-o-Faraó e-Aharon será será profeta-tu
\v 2 tu Tedeber a todo que eu-direi-te e-Aharon irmão-teu Yedaber a Faraó e-ele-mandará a filhos-de Israel de-a-terra-o
\v 3 e-eu eu-dificultarei a coração Faraó e-aumentarei a seus-sinais e-a seus-milagres em-terra-de Egito
\v 4 e-não ouvirá a-mim-vocês Faraó e-darei a minha-mão em-Egito e-sairei-eu a exércitos-meus a povo-de-mim filhos-de Israel de-terra-de Egito em-julgamentos grandes
\v 5 e-sabem Mitzrayim porque yhwh yhwh bentoti a yadi sobre Egito vehotsetiti a filhos-de Israel deles
\v 6 E-fez Moisés e-Arão como-que ordenou yhwh eles assim fizeram
\v 7 umoshe filho-de oitenta ano e-Aaron filho-de três ushmonim ano em-seu-falar a פַּרְעֹה
\v 8 E-disse yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 9 que yedaber a-vos Faraó dizendo deite a-vós maravilha e-dirás a Arão toma a cane-teu haja diante-de Pharaoh seja para-o-crocodilo
\v 10 E-veio Moisés e-Aarão a Faraó e-ele-fizeram assim conforme yhwh yhwh e-ele-jogou Arão a cane-seu diante-de Pharaoh e-houve servos-dele E-foi para-o-crocodilo
\v 11 E-chamou também Faraó aos-sábios e-aos-feiticeiros e-ele-fizeram também eles os-sábios Egito em-lhes-fogos assim
\v 12 e-ele-throw-them homem o-sua-bastão e-foram para-os-taninos e-ele-devorou bastao-de- אַהֲרֹן a de-sua-bastoes
\v 13 e-ele-se-firmou coração Faraó e-não ouviu a-eles conforme palavra yhwh
\v 14 E-disse yhwh a Moisés pesado coração Faraó de-recusar para-enviar o-povo
\v 15 vai a o-Pharaoh eis sai saindo a-marear e-voc-se-estabelecer-a para-o-encontro-dele sobre língua o-Yor e-a-maté que se-tornar para-serpente  tomarei  em-mão-teu
\v 16 e-dirás a-ele yhwh Elohim-de os-Hebreus enviaram-me a-ti dizendo enviou a povo-meu e-worship-me no-deserto e-eis não ouviste até assim-:
\v 17 assim disse yhwh com-isto sabereis que eu yhwh eis eu ferindo- com-o-bastão que em-minha-mão sobre as-águas que no-Nilo e-ser-vos-tornar-ão em-sangue-:
\v 18 e-a-peixe que morrerás morra e-o-veneno o-nilo e-se-contaminaram Egito águas águas de o-rio
\v 19 E-disse yhwh a Moisés disse a arão toma teu-bastão e-estende-a tua-mão sobre das-aguas Egito sobre rios-de-eles sobre rio-de-eles e-sobre lagos-de-eles e-sobre todo esperança aguas-de-eles e-serão- sangue e-será sangue em-todo terra Egito e-na-arvores e-na-pedras
\v 20 e-ele-fizeram- assim-que Moisés e-Aharon como-que ordenou yhwh e-ele-alçou com-a-bastona e-ele-feriu a as-águas que no-Nilo aos-olhos-de פַּרְעֹה e-perante-os-olhos-de servos-dele e-ele-virou-se todo as-águas que no-Nilo para-sangue
\v 21 e-a-peixe que no-yor morreu e-estragou-se o-rio e-não puderam águas para-beber e-houve de o-yor E-foi o-sangue em-todo terra Egito
\v 22 e-fizeram- assim os-sábios Egito em-seus-luxos e-ele-firmou coração-de Faraó e-não ouviu yhwh conforme palavra yhwh
\v 23 e-ele-virou Faraó E-veio a casa-dele e-não beber para-seu-coracao também a-esta
\v 24 e-eles-cavaram todo Egito em-torno-de águas águas que não não puderam para-beber de-a-águas o-rio
\v 25 e-ele-fill sete-de dias atrás-de bater yhwh a o-rio
\v 26 E-disse yhwh a Moisés veio a a-ele e-dirás disse yhwh disse yhwh enviou a povo-meu e-servirâ-me
\v 27 e-se tu tu eis eu eu castigo a todo seu limite nos-carpados:
\v 28 e-swarm o-n-ilho sapos e-subiram e-entraram em-a-casa-teu e-no-quarto de-dormir-teu e-sobre de-cama-teu e-no-casa servos-teus e-no-povo-teu e-no-forno-teu e-no-vestimentas-teu
\v 29 e-em-choro uBeAmakha e-em-todo servos-teus eles-subirão os-sapos
\c 8
\p
\v 1 E-disse yhwh a Moisés disse a Arão desvia a tua-mão- com-a-magia sobre as-nhara sobre os-ilhos e-sobre os-estagnos veha'ala a as-rãs sobre terra Egito
\v 2 e-virou Arão a sobre sobre de-a-água Egito e-ele-subiu a-rã e-ela-cobriu a terra Egito
\v 3 e-eles-fizeram- assim os-sábios em-seus-magias e-eles-subiram a as-rãs sobre terra Egito
\v 4 E-chamou Faraó para-moshe e para Aharon E-disse invocai-vos a yhwh e-disciplinar os-sapos de mim e do meu e lançarei a o-povo e sacrifiquem para-יהוה
\v 5 E-disse Moisés para-o-faraó se-ornar em-mim para-quando eu-apelo para-ti a-ti e-para-o-seu-povo para-cortar as-rãs de-vós e-de-tua-casa somente no-Nilo vocês-permanecerão
\v 6 E-disse para-o-manhã E-disse como-a-palavra-tua para-que saberás porque não como-יהוה Elohim-nosso
\v 7 e-virão-se os-sapos de-tu e-de-a-casa-tua e-de-o-servidor-tu e-do-povo-tu somente no-río permanecer-vos-eis
\v 8 e-ele-saiu Moisés e-Aarão de-com Faraó e-clamou Moisés a yhwh sobre palavra os-sapos que nome a-Faraó
\v 9 E-fez yhwh conforme-a-palavra-de Moisés e-morreram os-sapos de nas-casas de nas-áreas e-de as-terra-s
\v 10 e-ele-reuniram eles chamarim ermines e-ela-estragou-se a-terra
\v 11 E-viu פַּרְעֹה que era a-livreira e-o-grave a coração-dele e-não ouviu a-eles conforme yhwh yhwh
\v 12 E-disse yhwh a Moisés disse a Arão inclina a a-terra e-derribe a o-pó a-terra e-acontecerá para-os-formigas em-todo terra Egito
\v 13 e-ele-fizeram- assim e-ele-inclinou-se Arão a sua-mão com-sua-bastona a-terra a o-pó a-terra e-sobre-os-animais o-vermes a-terra ser todo poeira-de a-terra foi de-vermes em-todo terra Egito
\v 14 e-fizeram assim os-sábios em-seus-caracteristicas para-sair a os-cinzentos e-não poderiam e-foi e-sobre-os-animais em-o-homem e-na-bestas
\v 15 e-disseram os-sábios a Faraó dedo ela ela e-estreitou-se coração-de Faraó e-não ouviu yhwh conforme palavra yhwh
\v 16 E-disse yhwh a Moisés o-amanhecer na-manhã e-tome-posiçâo diante-de eis hein saindo a-a-gôa a-ele a-ele disse yhwh yhwh enviou povo-meu e-servirâ-me
\v 17 que se não-tu enviador a povo-meu eis-me emissor em-tu e-em-teus-servos e-no-seu-povo e-em-tuas-casas a a-peste-de-insetos e-eles-encherão as-casas a-terra a he-aráv e-também a terra que e-ele-s sobre-ela
\v 18 e-hifleteeti no-dia o-aquele a terra go-shen que meu-povo ficou-em-pé para-não para-não ser- nome tarde que saberás yhwh eu a-terra em-meio-de a-terra
\v 19 e-postarei resgate entre povo-meu e-entre povo-teu para-manhã será o-sinal a-esta
\v 20 E-fez yhwh assim E-veio tarde pesado casa-seu Faraó e-Beit servos-dele e-em-todo terra Egito a-terra de-diante-de de-faces-de a-plaga
\v 21 E-chamou פַּרְעֹה a Moisés E-disse E-disse ide zibchu le-elohemekhem na-terra
\v 22 E-disse Moisés não nakhon para fazer assim que abominação-de Egito nizbazh a-yhwh Elohim-nosso eis nizbazh a toavat Egito le-einehem e-não yiskelunuh
\v 23 o-caminho-de três-de dias nelikh no-deserto vezavakhnu para-יהוה Elohim-nosso conforme diga a-nós
\v 24 E-disse פַּרְעֹה eu e-solte vos e-zarbeieis a-יהוה Elohim-vosso no-deserto somente afaste-se não vocês-afastem para-andar clamei em-meu-lugar
\v 25 E-disse Moisés eis eu saindo- -de-você e-eu-orarei a yhwh e-se-apartará o-grilo -de-Faraó -de-seus-servos -e-de-seu-povo amanhã- somente a José para-não o-tel para-não enviou a o-povo para-sacrificar para-יהוה
\v 26 e-ele-saiu Moisés de-com Faraó e-ele-suplicou a yhwh
\v 27 E-fez yhwh conforme-a-palavra-de Moisés e-removeu o-terrível de-faraó de-seus-servos e-de-seu-povo não permaneceu um
\v 28 e-ele-afirmou Faraó a também também na-vez esta e-não enviou a o-povo
\c 9
\p
\v 1 E-disse yhwh a Moisés veio a a-ele e-tu-falarás yhwh assim disse yhwh Elohim-de os-hebreus enviou a povo-meu e-servirâ-me
\v 2 que se tu tu para-libertar e-vos mantém-se em-eles
\v 3 eis mão-de yhwh ho-yah be-miknecha que no-campo ba-susim ba-chamorim em-gamalim em-o-amanhecer e-no-rebanho palavra muito muito
\v 4 e-separou yhwh entre de-o-pecuário Israel e-entre de-o-pecuário Egito e-não morra de-todo para-filhos-de Israel palavra
\v 5 e-colocou yhwh na-festa dizendo amanhã fará yhwh a-palavra este na-terra
\v 6 E-fez yhwh a a-coisa o-este de-amanhã E-morreu todo de-o-pecuário Egito e-de-o-pecuário filhos-de um não morreu um
\v 7 e-enviou Faraó e-eis não morreu de-o-rebanho Israel até um e-se-tornou-grande coração Faraó e-não enviou a o-povo
\v 8 E-disse yhwh a Moisés e-a a-vós tomai para-vocês enchei vossas-farcas cinza o-ovelha e-espargeu-o Moisés aos-céus para-olhos-de Faraó
\v 9 e-foi até-a-poeira sobre todo terra Egito e-será sobre o-homem e-sobre o-gado para-schichin florescendo abawbuot em-todo terra Egito
\v 10 ve-yikhu a piach ha-kibshan e-pararam diante-de פַּרְעֹה ele a-ele Moisés e-houve E-foi schichin abawbuot florescendo e-sobre-os-animais u-vabahemah
\v 11 e-não puderam os-escritores para-estar diante-de de-diante-de de-diante-de o-sufocado porque foi o-sufocado em-os-escritores e-em-todo Egito
\v 12 e-ele-fortaleceu yhwh a coração Faraó e-não ouviu a-eles como yhwh yhwh a Moisés
\v 13 E-disse yhwh a Moisés o-manhã de-manhã e-ele-se-estabeleceu diante-de Faraó a-ele a-ele yhwh disse yhwh Elohim-de os-hebreus enviou a povo-meu e-eles-me-servirão
\v 14 que em-o-tempo desta eu enviou a todo das-minha-preguic a para-o-teu-coracao e-em-seus-servos-teus e-no-povo-teu que conheceras porque não-há como-mim em-todo a-terra
\v 15 que agora enviei-eu a minha-mao e-eu-ameacei a-ti e-com o-povo-teu no-dizer e-tu-escondeste-te de a-terra
\v 16 e-entretanto por-causa-de esta te-elevei-te por-causa-de para-exibir-te a minha-força e-para-o conta nome-meu em-todo a-terra
\v 17 ainda-tu elevado em-o-povo-meu para-não lança-os
\v 18 eis-me manda-chover como tempo-de amanhã gelo pesado muito que não foi como-este em-Egito de-o o-dia foi-fundada-a e-até agora
\v 19 e-agora enviou a-ovelha a de-teu-rebanho e-a a-ti que a-ti no-campo todo o-homem e-o-animal que será-achado-a no-campo e-não será-coletado-o a-casa e-descerá sobre-eles o-gelo e-morreram
\v 20 o-teme a yhwh yhwh de-escravos Faraó ele-livrou a seus-escravos e-a de-seu-banhado a as-casas
\v 21 e-que não nome seu-coracao yhwh palavra yhwh e-olvidou a seus-escravos e-a suas-propriedades no-campo
\v 22 E-disse yhwh a desvia a mão-tua e-seja os-céus E-foi gelo em-todo terra Egito sobre o-homem e-sobre o-gado e-sobre todo erva-de o-campo em-terra-de Egito
\v 23 e-ele-esticou Moisés a seu-bastão sobre dar e-yhwh deu sons e-gelo e-ela-andou fogo yhwh e-ele-choveu yhwh barrad sobre terra Egito
\v 24 e-houve barad ve-esh mitlakhat no-meio-de habbarad pesado muito que não foi kamohu em-todo terra era meaz haytah legoy
\v 25 vayyakh o-barad em-todo terra Egito a todo que no-campo de-homem e-até animal e-a todo erva o-campo bateu o-barad e-a todo árvore o-campo quebra
\v 26 somente em-terra-de goshen que nome filhos-de não ser foi barad
\v 27 e-enviou פַּרְעֹה E-chamou para-moshe e-para-aaron E-disse a-eles pecado-eu a-vez yhwh o-justo e-eu e-o-seu-povo os-malvados
\v 28 clamem a yhwh e-muita de-ser vozes Elohim e-com-gelo e-eu-enviaria vos e-não voces-aumentariam para-estar-parado-verso-final
\v 29 E-disse a-ele Moisés quando-sair-eu a a-cidade eu-separarei a kapay a yhwh não e-cessarão e-o-gelo não que ainda a-terra saberás porque para-יהוה a-terra
\v 30 e-tu e-seus-servos-teus eu-sei que ainda-não temerão-eles de-diante-de yhwh Elohim
\v 31 e-a-lã e-o-trigo nucata que ha-seora aviv e-a-palha gibol
\v 32 ve-hachita ve-hakusemet não nuku que afilot até-aqui
\v 33 e-saiu Moisés de-com Faraó a a-cidade vayifros as-suas-mãos a yhwh e-eles-pararam as-vozes e-o-gelo e-chuva não foi-espalhado para-terra
\v 34 E-viu פַּרְעֹה porque parou a-chuva e-o-gelo e-as-vozes e-continuou para-o-pecar e-ele-dificultou ele ele e-seus-servos
\v 35 e-ele-fortaleceu coração Faraó e-não enviou a filhos-de Israel como yhwh yhwh por-mão-de Moisés
\c 10
\p
\v 1 E-disse yhwh a Moisés veio a Faraó porque eu dificultei a coração-seu e-a Estas seus-servos para-que minha seus-sinais estes em-o-centro-dele
\v 2 e-para-o-fim-de você-contará em-o-ouvido seu-filho e-filho-de seu-filho a que brinquei-eu-com em-Egito e-a sinais-meus que coloquei yhwh e-voces-sabereis porque eu yhwh
\v 3 E-veio Moisés e-Aharon a Faraó a-ele a-ele yhwh disse yhwh Elohim-de os-Ebraelitas até quando de-que-voces-se-recusaram para-anotar de-perante-mim enviou povo-meu e-va-abdu-ni
\v 4 que se tu tu para-shalach a meu-povo eis-me multiplicarei ma-char ar-beh bi-gvul-cha
\v 5 ve-kisah a a-terra a-terra e-não podia li-roth e-coma a-terra ve-achal a Jetro a-vós a-restante e-coma de o-barad a-vós a todo o-arvore o-crescente para-vocês de o-campo
\v 6 e-cheios-de teus-batim וּבָתֵּ֣י todo seus-servos וּבָתֵּ֣י todo Egito que não viram avós-teus e-avós avós-teus até o-dia sobre a-terra até o-dia esta e-virou-se e-ele-saiu de-com פַּרְעֹה
\v 7 e-disseram servos-de Faraó a-ele até será for este a-nós para-apanhar enviou a os-homens e-servirão a yhwh que antes que-sabes porque perdida Egito
\v 8 e-os-estabeleceram a Moisés e-com E-disse a Faraó E-disse a-eles para-voces-andem quem a yhwh os-elohim-seus quem e-quem os-andantes
\v 9 E-disse Moisés com-os-jovens-nossos e-com-os-idosos-nossos nós-andaremos em-nossos-vanos e-nos-construindo em-nois-ovelhas e-nos-gado iremos que festa- yhwh para-nós
\v 10 E-disse a-eles haja assim yhwh com-vocês como eu-enviarei vos e-com crianças-vos que porque diante diante-de faces-vos
\v 11 não assim vai-em por-favor os-homens e-serve que yhwh porque a-ela vós eles e-ele-expeliu face-de de-com face-de Faraó
\v 12 E-disse yhwh a Moisés estenda a-tua-mão sobre terra Mitzrayim em-o-grilo e-ele-suba sobre terra a-terra e-ele-coma a todo erva a-terra a todo que deixou o-gelo
\v 13 e-virou Moisés a em-o-sicoma sobre terra Egito e-yhwh dirigiu-se espírito-de para-o-leste na-terra todo ser e-Espírito-de e-todo a-noite a-manhã foi e-o-vento do-leste levantou a o-arvèh:
\v 14 e-subiu o-arvèh sobre todo terra Egito e-ele-estabeleceu-se em-todo território Egito muito muito em-o-sua-frente não multiplicarei assim arvèh não e-depois-dele não ele-será- assim
\v 15 e-ele-cobriu a olho todo a-terra e-comeu a-terra a-terra a todo a-árvore a-terra e-את todo fruto o-arvore que hoteir habbarad e-não notar todo yerek em-a-arvore uveaseve o-campo em-todo terra Egito
\v 16 vayemaher Faraó para-chamar para-moshe uleahaaron E-disse chatati para-יהוה אֱלֹהִים-de-vocês e-para-vos
\v 17 e-agora eleva por-favor pecado-eu porém desta-vez e-o-implorar-vos a-yhwh vosso-Elohim e-disciplinar de-sobre-mim somente a a-mortes a-esta
\v 18 e-ele-saiu de-com Faraó e-ele-implorou a yhwh
\v 19 e-ele-virou yhwh espírito-de mar muito muito e-ele-levantou a a ervilha e-tocou-ele-o não sof multiplicarei um arvève um em-todo fronteira-de Egito
\v 20 e-estreitou yhwh a coração Faraó e-não enviou a filhos-de Israel
\v 21 E-disse yhwh a Moisés desvia mão-tua e-seja os-céus E-foi escuridão sobre terra Egito e-andará escuridão
\v 22 e-virou Moisés a mão-sua e-houve os-céus E-foi treva- escuridão em-todo terra Egito três dias
\v 23 não viram homem a o-seu-irmão e-não levantaram-se homem de-em-sob-dele três-de ser luz filhos-de Israel foi luz em-mesmo-lugares-deles
\v 24 E-chamou Faraó a E-disse E-disse vão-vocês servem a yhwh somente rebanho-de-vocês e-no-seu-campo se-reúna também tuf-vosso irei com-vos
\v 25 E-disse Moisés também tu dareis em-mão-nossa sacrifícios e-oferendas e-faremos para-יהוה Elohim-nosso
\v 26 e-também de-nosso-pecúlio irei não não permanecerá que nós de-mim para-lavrar para-servir a yhwh Elohim-nosso e-nós não nossa-conhecimento que nos-adoraremos a yhwh até vindo-nos ali
\v 27 e-ele-fortaleceu yhwh a coração Faraó e-não pai para-enviá-los
\v 28 e-ele-disse a-ele Faraó vai de-mim-sobre a-ti para-ti a você-aumentará que face-de porque em-dia-de morrerás face-de morrerás
\v 29 E-disse Moisés assim falaste não ajuntarei ainda ver teu-rosto
\c 11
\p
\v 1 E-disse yhwh a Moisés ainda um um traria sobre Faraó e-sobre Egito depois-de assim enviará vos deste quando-ele-o-enviar toda expeliu expulsará vós deste-lado
\v 2 diga- por-favor em-orelhas-de o-povo e-eles-perguntarão homem de-junto-de companheiro-seu e-mulher de-junto-de sua-companheira objetos-de prata ouro ouro
\v 3 E-colocou yhwh a favor o-povo em-olhos-de também também o-homem Moisés grande muito em-terra-de Egito em-olhos-de servos-de- Faraó e-no-livro o-povo
\v 4 E-disse Moisés assim disse yhwh meio-da-noite a-noite eu saindo no-meio-de Egito
\v 5 e-morre todo primeiro-nato em-terra-de Egito de-primeiro-nato Faraó o-que-está-sentado até trono-dele até primogênito-de a-escrava que e-tudo os-cheiros animal-doméstico em-primogênito animal
\v 6 e-seja gritaria grande em-todo terra Egito que não não tornou-se não não acrescenta
\v 7 e-para-todo filhos-de Israel não não cão de-sua-língua para-homem e-até animal a-fim-de sabereis que yhwh entre entre e-entre e-entre Israel
\v 8 e-desceram todo Estas estes a-mim dizendo a-mim tu saia tu e-todo o-povo que em-tu-pés e-depois-de assim eu-sairei e-ele-saiu de-com פַּרְעֹה com-seu-escolhido também
\v 9 E-disse yhwh a Moisés não ele-ouvirá a-vós Faraó para-fim-de multidões meus-sinais em-terra-de Egito
\v 10 e-Moshe e-Aharon o-fez-e a todo os-moftim estes diante-de yhwh yhwh a coração Faraó e-não enviou a filhos-de Israel de-a-terra-o
\c 12
\p
\v 1 E-disse yhwh a Moisés e-a Arão dizendo Egito para-dizer
\v 2 o-hodesh este a-vós cabeça meses resheon ele a-vós le-chadshi ha-shana
\v 3 dabru a todo dizendo Israel dizendo be-asor no-mês a-eles e-eles-tomem para-ela-os homem o-cor-de-cabra para-casa-de os-pais o-cor-de-cabra para-a-casa
\v 4 e-se ele-se-faça-pequeno o-da-casa de-ser e-tome ele ele e-o-seu-vizinho o-próximo a casa-dele em-taxa-de almas homem de-conformidade-com que-o-comessem vocês-tornarão sobre o-cordeiro
\v 5 cordeiro perfeito macho filho-de será a-vós a-vós de os-camurças e-de os-cabritos vocês-tomarão
\v 6 e-será a-vós para-misericórdia até quatro dez dia no-mês este e-sacrificarão ele todo assembleia congregação-de- entre entre os-pardais
\v 7 e-tomarão de o-sangue sobre duas-de as-molduras sobre o-entrante sobre ele que comerão a-ele neles
\v 8 e-comerão a a-carne na-noite esta em-fogão- fogo e-massas sobre amargos o-comerão
\v 9 a nós do-que-ele por-favor e-cozido cozido que porque se em-fogão- fogo cabeça-dele sobre pés-dele e-sobre kirbo
\v 10 e-não nós dele até nós e o que restou de-ele até manhã no fogo serão consumidos
\v 11 e-assim-aqui comereis ele vossas-entranhas cinturados vossos-calçados em-vossos-pés e-vossos-bastões em-mão-vossa e-voces-comeram ele com-pressa Páscoa ele para-יהוה
\v 12 e-passarei em-terra- Egito na-noite deste e-ferrei todo primogênito em-terra-de Egito de-homem e-até animal e-em-todo Elohim-de yhwh fazerei os-julgamentos eu yhwh
\v 13 e-será o-sangue a-vós para-um-sinal sobre as-casas que vós nome e-vi a o-sangue e-passei-para em-voces e-não será em-vos nega-f le-mash-chit be-hak-koti em-terra-de Egito
\v 14 e-será o-dia ha-zeh a-vós le-zich-aron ve-chag-getem ele chag para-יהוה para-gerações-vossas chuq-at eternidade te-chagu-hu
\v 15 shib-aat dias massots tocheleu somente no-dia harishon tashbithu fermento de-vossas-casas que todo comedor azedo e serão cortados a-alma aquela de-Israel desde-dia o-primeiro até dia o-sétimo
\v 16 e-no-dia o-primeiro מִקְרָא־ santidade e-no-dia o-sétimo será a-vós será a-vós todo trabalho não será feito em-elas ele sozinho será comido a-vós alma ele sozinho será feito a-vós
\v 17 e-vós-guardareis a que porque o-dia o-dia esta הוציתי a exércitos-vos da-terra Egito e-vós-guardareis a o-dia eternidade para-gerações-vos chuq-at eternidade
\v 18 no princípio em-quatro dez dia no mês na-atardecer comereis panes pães sem fermento até dia o-primeiro e-vinte no-mês no-o-crepúsculo
\v 19 sete dias סאור não será-encontrada em-vosso que todo comedor fermento e-será-eliminada a-alma aquela da-congregação Israel no-estrangeiro e-no-circunciso a-terra
\v 20 todo não não comereis em-todo móshəvōteḵem comereis matzot:
\v 21 E-chamou Moisés para-todo anciãos-de E-disse E-disse a-eles mis-ku a-vós para-vós rebanho-de le-mish-pach-to-chem ve-sha-chat-u o-passo
\v 22 e-tomareis agud-dat ezob e-tubaltem be-dam que be-saf ve-higashetem a ha-mashqof e-a duas ha-mezuzot de não que be-saf e-vós não tetzau homem mi-petach- casa-dele até manhã
\v 23 e-passou yhwh para-negof a Egito e-verá a ha-dam sobre o-mashqof e-sobre yhwh os-mezuzot e-passeou yhwh sobre o-fetach e-não dará o-mashchit para entrar a em-vossoas-casas para-negof
\v 24 e-vos-guardastes a a-coisa esta por-tempo para-ti e-aos-seus-filhos até eternidade
\v 25 e-será porque vai-vos a a-terra yhwh a-vós yhwh para-vocês como-que palavra e-vós-guardareis a o-trabalho a esta
\v 26 e-será porque eles-dire-ão a-vós filhos-vos que o-trabalho a-vós para-vocês
\v 27 e-disse-reis ofertar- ele ele a-יהוה que Pásca sobre casas-de filhos-de Israel em-Egito negro-seu a Egito e-a nossas-casas e-salvou e ardeu o-povo e-prostraram-se
\v 28 e-caminharam filhos-de Israel como-que ordenou yhwh yhwh Moisés e-Aarão assim fizeram
\v 29 e-houve em-meio a-noite e-yhwh bateu todo primeiro-nato em-terra-de Egito de-a-primeira Faraó o-que-está-sentado sobre até até primogênito-de o-exilado que em-casa-de e-tudo e-todo animal-doméstico animal
\v 30 E-levantou פרעה noite ele e-todo seus-servos e-todo Egito e-foi gritaria grande em-Egito porque não-há casa que não há nome morreu
\v 31 E-chamou para-Moshe e-para-Aaron noite E-disse levantem-se saiam de-meio-de povo-meu também vós também filhos-de Israel e-vão servi a yhwh para-falar-vos
\v 32 também rebanho-vos também em-vosso-boi tomem como-que falastes e-andei e-bendistes também de-mim
\v 33 ela fortaleceu-se Mitzrayim sobre o-povo para-pressa para-guerra que a-terra porque disseram-eles todos-nós mortos
\v 34 e-levantou o-povo a ainda-não antes-de que-se-farte de-seus-restos enroladas em-suas-vestes sobre de-seus-lombos
\v 35 e-filhos-de Israel fizeram conforme-a-palavra-de Moisés e-perguntaram do-Egito objetos-de ouro e-vessãis ouro e-vestes
\v 36 E yhwh dar a favor o-povo em-olhos-de Egito e perguntaram-lhes e tiraram a Egito
\v 37 E-OS-ELES-SAIRAM filhos-de Israel de-ruamess sukkotá c'shesh- centenas mil pé os-hagbarim apenas mancha:
\v 38 e-também tarde subir subiu com-eles e-rebanhos e-gado do-rebanho muito muito
\v 39 e-fizeram-assar a o-pão que extrairam de-o-Egito pães-de-forma que não não fermentado porque forçaram desde-Mitsrayim e-não puderam para-se-demorar a-eles justiça não fizeram para-eles
\v 40 e-moshab filhos-de Israel que habitaram em-Egito trinta ano e-quatro centenas anos
\v 41 e-houve de-fim trinta ano e-quatro centenas ano e-houve [בְּעֶ֙צֶם֙] o-dia esta todo tzivot yhwh de-terra-de Egito
\v 42 noite de-shimurim ele a-yhwh לְהוֹצִיאָ֖ם da-terra Egito ele noite o-este a-yhwh de-shimurim para-todo filhos-de Israel para-gerações-eles
\v 43 E-disse yhwh a Moisés esta esta lei o-pascha todo filho-de נֵכָ֖ר נֶכְרָה não comerá em-ele
\v 44 e-todo servo homem de-aquisição- ele e-teceu a-ele então ele-comerá em-ele
\v 45 estrangeiro vesakir não ele-comerá- em-ele
\v 46 em-casa um e-o-eche-le não tirar de a-casa de não fora e-ossos não vocês-partirão- nele-verso
\v 47 todo עֲדַ֥ת Israel ele a-ele
\v 48 e-quando Yagur contigo ger ואsha Pesach para-יהוה a-ele a-ele todo macho ve-az se-aproximará la-asoto a-terra ke-ezrach a-terra e-todo arel não yochal em-ele
\v 49 lei uma será la-ezrach e para o estrangeiro הַגָּ֥ר בְּתוֹכְכֶֽם׃
\v 50 va-yasu todo filhos-de Israel como-que yhwh yhwh a Moisés e-com אַהֲרֹן assim fizeram
\v 51 e-houve בְּעֶ֖צֶם o-dia esta tire-ou yhwh a filhos-de Israel de-terra-de Egito sobre exércitos-deles-verso
\c 13
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 santo-de para-mim todo primogênito pedra-da todo ventre-o e-sobre-os-animais Israel ele e-no-animal para-mim ela
\v 3 E-disse Moisés a o povo lembra-te a o-dia o-este que sai-vos de-Egito que escravos mão be-chozek mão tire-ou yhwh vos deste e-não será comido azedo-o
\v 4 o-dia vós sain-do em-o-mês o-primavera
\v 5 e-foi porque yhwh yhwh a terra o-canaanita e-o-het e-o-amorreu e-o-hivite e-o-jebuseu que jura-vou para-ti terra para-ti terra fluindo-de leite e-mel e-servirás a o-trabalho a-esta no mês- a-esta
\v 6 sete dias comerás de-mazze e-no-dia o-sétimo festa a-yhwh
\v 7 massas-de-farinha yeakhel a sete os-dias e-não a-ti a ti fermentado a-ti será-visto para-ti fermento em-todo גְּבֻלֶֽךָ׃
\v 8 e-contarás para-o-seu-filho no-dia aquele dizendo por-causa-de este fez yhwh a-mim na-saída-meu de-Egito
\v 9 e-será a-ti por-sinal sobre da-tua-mão entre entre os olhos para-que ser-ás yhwh yhwh que porque com a mão forte extrair-te yhwh de-Egito
\v 10 e-guardarás a a-regulação esta para-a-sua-festa de-dias dia-e-noite
\v 11 e-será porque yhwh yhwh a terra o-kenaani a-ti jurou a-ti para-ti e-dar-a para-ti
\v 12 e-passarás todo primeiro-de ventre a-יהוה e-todo animal-doméstico seger será a-ti será para-ti ha-zkharyim para-יהוה
\v 13 e-todo peter chomer resgatar-ás bobo-she e-se não e-tudo e-arpo-to homem em-primogênito homem be-banecha tífdeh
\v 14 e-será porque yishalheka bincha dizendo Leomar que a-ele e-dirás mão be-chozek yhwh hotzi-anu yhwh de-misraim de-casa-de servos
\v 15 e-houve porque hiqsha Paro- para-enviar-nos- e-matou yhwh todo primogênito em-terra-de homem de-primeira animal-doméstico e-até primogênito-de animal sobre assim eu que-sacrifica a-יהוה todo a-pomba o-útero os-masculinos e-todo em-primogênito filhos-de eu-redimir-eu
\v 16 e-era para-sinal sobre sua-mão entre entre que porque mão mão yhwh yhwh de-Egito
\v 17 e-houve em-enviarmos פרעה a o-povo e-não o-caminho-de terra caminho que filisteus ele que ele disse disse Elohim para-que-não ינחם o-povo בראותם guerra ושבו Míseremah
\v 18 ויסוב Elohim a o-povo o-caminho-de o deserto mar-de סוף וחמושים subiram filhos-de Israel dizendo Egito
\v 19 E-tomou Moisés a עצמות José que porque השבע השביע a dizendo Israel dizendo פָּקֹ֨ד יִפְקֹ֤ד Elohim vos וְהַעֲלִיתֶ֧ם a עַצְמֹתַ֛י de-este אִתְּכֶֽם׃
\v 20 e-partiram de-tendas e-acamparam com-eles em-extremidade-de o-meadero
\v 21 e-יהוה andou em-frente-de-eles dia em-amostra nuvem para-acampar-eles o-caminho e-o-noite em-a-coluna fogo para-iluminar a-eles para-andar de-dia e-noite
\v 22 não ele-se-move coluna o-nuvem diariamente e-coluna noite noite diante-de o-povo
\c 14
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 palavra a filhos-de Israel e-eles-voltam-se e-acamparão diante-de boca-de entre entre e-entre o-mar ha-yam diante-de בַּ֣עַל norte em-seu acamparam sobre o-mar:
\v 3 e-disse Faraó aos-filhos-de Israel estavam-confusos eles em-a-terra fechar sobre-eles o-meadero
\v 4 e-forte-eu-tornarei a coração-de Pharaoh e-perseguiu depois-deles e-exaltarei em-Pharaoh e-em-todo חֵיל֔וֹ yhwh Egito porque eu yhwh e-fizeram assim
\v 5 e-foi-dito como-rei Egito que correu o-povo e-virou-se para-o-coracao  פרעה e-de-sus-servos a o-povo e-disseram que isto fizemos porque enviamos-nos a Israel de-sus-servos
\v 6 e-ajuntou-se a seu-carro tomou amav tomou com-ele-verso
\v 7 E-tomou seis-de centenas רֶ֙כֶב֙ e-tudo e-todo carros Egito e-os-príncipes sobre tudo-o
\v 8 e-ele-fortaleceu yhwh a coração Faraó rei Egito e-ele-perseguiu depois-de filhos-de Israel e-filhos-de Israel יֹצְאִים com-mão subiu
\v 9 e perseguiram Egito depois-deles e-os-atingiram elas os-acampamentos sobre o-mar todo סוּס֙ carros Faraó -e-sua-parasha e-o-exército-seu sobre boca-minha as-chiros diante-de Baal norte
\v 10 e-Pharaoh ofereceu e-ele-levantaram filhos-de Israel a os-seus-olhos e-eis do-Egito viajando depois-deles muito muito e-clamaram filhos-de Israel a yhwh
\v 11 e-disseram a Moisés a-por-não não-há túmulos em-Egito para tomarmos para morrermos no-deserto que isto fizeste tu para nos levarmos de-Egito
\v 12 não-é este a-palavra que falamos a-você dizendo dizendo nós dele e-nos-adoraremos que bom porque bom a-nós servo a Egito de-morte-nossa no-deserto
\v 13 E-disse Moisés a o-povo a v-trepareis h-vos-posicionareis yhwh a a-vós o-dia que ele-fará para-vocês o-dia o-dia não v-vistes a Mitzrayim o-dia não a-som-brevariais para-ver-los mais até eternidade
\v 14 yhwh lutará a-vós e-vós v-calareis-vos
\v 15 E-disse yhwh a Moisés que v-gritarais a-mim palavra a filhos-de Israel e-eles-partirão-verso
\v 16 e-tu elevem a a-tua-mata e-estenda a yadcha sobre o-mar no-meio-de o-mar filhos-de Israel em-meio-de o-mar na-terra-firmada-verso
\v 17 e-eu eis-me e fortaleça a coração Egito e venham apos-eles e seja respeitada perante Faraó e-em-todo seu exército em-suas-carretas e-em-seus-cavalos
\v 18 e conhecerão Egito porque yhwh yhwh em-a-honra-dele em-faraó em-seu-cavalo e-em-sus-cavalos
\v 19 e-partiu anjo os-Elohim o-que-vai diante-de acampamento-de Israel E-andou de-após-eles e-partiu coluna da-névoa de-diante-deles e-parou de-eles
\v 20 E-veio entre acampamento-de Egito e-entre e-entre Israel E-foi e-houve e-o-trevas e-ele-iluminou a a-noite e-não se-achegou este a este todo a-noite
\v 21 e-ele-esticou Moisés a mão-sua sobre yhwh e-ele-conduziu יהוה a o-mar com-vento do-norte Azza- todo a-noite e-colocou as-águas o-mar para-o-deserto e-eles-partiram as-águas
\v 22 e chegaram a filhos-de no-meio-de o-mar o-mar em-a-terra-firmo a-eles a-eles a-muralha de-seu-lado-direito e-de-seu-lado-esquerdo
\v 23 e-eles-perseguiram Egito e-vieram de-elles todo sus Faraó rikbo- e-seus-cavaleiros a o-mar o-mar:
\v 24 e-houve em-Ashmorah a-manhã e-ele-olhou yhwh a acampamento-de Egito em-a-coluna fogo e-nuvem e-ele-se-alçou a acampamento-de Egito
\v 25 e-ele-se-retirou a roda de-sua-marcos e-ele-o-conduziu com-dificuldade E-disse Egito forçadamente de-diante-de Israel que yhwh lutou a-eles com-Egito
\v 26 E-disse yhwh a Moisés estende a mão-tua sobre ha-yam e-voltarão as-águas sobre Egito sobre rikbo- e-sobre os-parashim
\v 27 e-ele-inclinou-se Moisés a mão-sua sobre o-mar e voltou manhã em-frente manhã para-o-eitan e-Misraim nós-sairemos yhwh e-estremeu no-meio-de o-mar Egito em-meio-de o-mar:
\v 28 e-voltaram as-águas e-cobriram a o-carro a-todo os-parashim para-todo força Faraó os-que-vêm atrás-de-eles no-mar não permaneceu neles até um
\v 29 e-filhos-de Israel andaram na-terra no-meio-de o-mar e-os-água a-eles muralha de-seu-direito e-de-seu-esquerdo
\v 30 e-Yoshua yhwh no-dia a-esse a Israel de-mão-de E-viu E-viu Israel a Egito o-mar sobre beira-de o-mar:
\v 31 E-viu Israel a a-mão a-grande que yhwh yhwh em-Egito e-eles-tremeliram o-povo a yhwh e-eles-crederam em-יהוה e-em-Moshe seu-servo
\c 15
\p
\v 1 então cantei Moisés e filhos-de Israel a a canção esta dizendo e-disseram dizendo eu canto para yhwh porque orgulho arrogância cavalo e seu cavaleiro Rama no mar:
\v 2 minha-forteza e-cantares-meu Yah e-foi a-mim li-yeshuah este meu-elohim e-anvehu Elohim-de pai-meu va-arommenhuhu
\v 3 yhwh homem guerra yhwh nome-dele
\v 4 marckhot Pharaoh ve-chilo yarah bayam umibhar shalishav tubbu beyam- juncos
\v 5 fundos os-cobri-los desceram em-garras como pedra:
\v 6 yeminecha yhwh santo com-poder teu-direito yhwh terrifica inimigo:
\v 7 E-POR-MUITOS a-tua-altitude destruirás teus-inimigos lançará teu-ira o-comerá como-cinzas
\v 8 e-no-espírito teu-rosto foram-envolvidos águas estabeleceram-se כְמוֹ־ derretidos correndo congela-o abismos בְּלֶב־ mar-
\v 9 disse inimigo eu-perseguirei seguirei-o dividirei despojos os-encherá nafshi espalharei espada-meu torresmo-seu minha-mão:
\v 10 raspou-você em-vento-teu e-o-ocultaste mar mergulharam-eles como-ferro em-agua majestosos-eles
\v 11 quem kamoka yhwh quem quem como dedicado no santuário assustador hinos fez milagres:
\v 12 tu estendeste a tua mão direita os engoliu terra
\v 13 tu lançaste por tua misericórdia com ז֣וּ resgataste levaste pela tua força a morada Sua santidade:
\v 14 ouçam povo-es tremem terror agarrado habitantes-de fesliteiros
\v 15 então se-espantaram chefes-de Edom de-cervos Moabe tomá-los terremoto derretem-se todo habitantes-de Canaan
\v 16 caia em-eles terror e-pavor grande braço-tua se-fazerão como-a-pedra até passará yhwh yhwh até passará com ז֥וּ compraste-tu
\v 17 introduzirás-os e-plantarás-os em-monte-de herança-tua lugar para-a-sua-estadia tu-fizeste yhwh do-sanctuário Adonai estabeleceram יָדֶֽיךָ׃
\v 18 yhwh ele-reinará para-sempre para-sempre
\v 19 que veio cavalo פרעה em-o-sua-carroagem e-em-seus-cavalos no-mar e-estabeleceu-se yhwh sobre-eles a o-mar ha-yam e-filhos-de Israel andaram no-meio-de o-mar o-mar:
\v 20 e-tomou Miriam a nebiya a-irmã de-Aaron a o-tamborim em-mã e-saiu-a todo as-mulheres depois-dela em-tumpos e-no-maioles
\v 21 e-respondeu-a a-eles Miriam cantem para-יהוה porque elevado-o exultou-a ס֥וּס e-seu-cavaleiro elevada-a no-mar-verso-final
\v 22 e-partiu-ele-se Moisés a Israel מִיַּם- Suf e-saíram a no deserto- Shur e-foram três- יָמִ֛ים em-o-midbar e-não encontraram-os águas
\v 23 e-vieram amarada-a e-não puderam para-beber-ele águas de-amarado-o que amaros eles sobre assim קָרָֽא־ shema-ha- amara
\v 24 e-ele-queixou-se o-povo sobre Moisés dizendo que- nós-beberemos
\v 25 e-ele-gritou a yhwh yhwh árvore madeira e lançou a as-águas e-eles-deram-doçura as-águas a-ele nome para-ele חֹ֥ק וּמִשְׁפָּ֖ט e ali ele-o-provou
\v 26 E-disse se audição à-voz-de לְקוֹל yhwh Elohim-teus e-o-retirado em-o-sus farás e-a-ouves para-as-mandamentos-seus e-guardas todo os-preceitos-seus todo a-doença que eu-postei que não yhwh sobre-ti porque eu yhwh te-curador
\v 27 e-vieram o-que-dizem e ali dois dez olhos águas e-setenta tamareiros e-acamparam- nome sobre as-águas
\c 16
\p
\v 1 e-eles-partiram de-eilim e-vieram todo congregação-de filhos-de Israel a e-entre sin que entre dia e-entre Si-na-y בַּחֲמִשֹּׁ֨ה dez dia para-o-mês o-segundo para-saírem de-terra-de Egito
\v 2 todo congregação-de filhos-de Israel sobre Moisés e-sobre אַהֲרֹן no-deserto
\v 3 e-disseram a-para-eles filhos-de Israel quem יִתֵּן morrer-nos por-mão-de- yhwh em-terra-de Egito em-nossa-sentença sobre pão a-carne em-comer-nos pão para serdes saciados porque saiestes nós a o-deserto esta para-matar a todo הַקָּהָ֥ל este bar'ava:
\v 4 E-disse yhwh a Moisés eis-me a-vós pão pão de os-céus e-sairá o-povo e-las-recolham palavra-de dia be-yomo- para-propósito-de forçadamente-o se-andará em-a-lei-meu se não
\v 5 e-foi no-dia o-sexto e-eles-prepararão a que trará-os e-foi sobre sobre dia recolherão dia dia
\v 6 E-disse Moisés e-Aarão a todo tarde Israel que yhwh porque yhwh saírei vos de-terra-de Egito
\v 7 e-manhã e-vós-ver-eis a yhwh yhwh em-a-ouvido-seu a queixas-vos sobre que e-nós o-que porque sobre-nós
\v 8 E-disse Moisés deitando-se yhwh a-vós na-noite em-a-carne para-comer e-pão na-manhã para-satisfazer em-ouvir yhwh a queixas-vos que vós מַלִּינִ֖ם sobre-ele e-nós o-que que sobre nós vossas-reclamações porque sobre yhwh
\v 9 E-disse Moisés a Arão disse a todo a congregação filhos-de yhwh que diante-de yhwh porque ouviu a vossas-reclamações-verso-final
\v 10 e-houve כְּדַבֵּ֤ר Arão a todo congregação-de filhos-de Israel e-voltaram-se yhwh a-deserto e-eis glória-de yhwh apareceu em-a-nuvem
\v 11 e-falou yhwh a Moisés dizendo
\v 12 ouvi a reclamações filhos-de Israel palavra dizendo entre entre os-araviãs comereis carne e-no-manhã vocês-se-satisfarão- que e saberéis yhwh eu yhwh Elohim-vosso
\v 13 e-houve na-noite e-ele-subiu a-súplica e-ela-cobriu a o-acampamento era foi de-a-decepção do-ora ao-redor o-lager
\v 14 e subiu a escabecim o tal e-eis sobre face-de o deserto fino espalhado fino como uma tampa sobre a-terra
\v 15 e viram filhos-de Israel e-disseram homem a ele que não porque não E-disse que ele ele Moisés a-eles dar yhwh a-vós para-alimento yhwh a-vós para-alimento
\v 16 este a-palavra que ordenou yhwh líquto nós homem de-conformidade-com áklo ómer lagulgoléth de-número nafshetékhem homem láasher em-o-seu-tenda vocês-tomarão
\v 17 e-fizeram assim filhos-de Israel e-eles-colheram o-muito e-o-pouco
\v 18 e-eles-mediram em-o-omeron e-não o-preferiu o-muito e-o-pouco não o-faltou homem de-a a-co-lo l-a-q-t-u
\v 19 E-disse Moisés a-eles homem a nós dele até manhã
\v 20 e-não ouviu a Moisés nós homens do-que-ele até manhã v-y-r-u-m t-o-l-a-ay-im v-y-b-a-sh e-ira-se sobre-eles Moisés
\v 21 e recolheram ele ba-voker de-manhã homem cada que eles começassem a comer e quente o-sol e tocou
\v 22 e-houve em-o-dia no-dia l-a-q-t-u pão pão segundo o-omem para-o-um e-vieram todo príncipes-de a-congregação e-eles-disseram para-Moisés
\v 23 E-disse a-eles ele que palavra yhwh Sabbaton Sabbat- Kodesh a-yhwh amanhã- a que t'afu eifu e-a que- t'bashelu b'shulu a-vós todo ha'odef הַנִּ֧יחוּ yhwh para-de-guarda até a-manhã
\v 24 e-os-colocaram ele até a-manhã conforme ordenou Moisés e-não o-ameaçado e-ulceração não ela-foi em-ele
\v 25 E-disse Moisés comê-lo o-dia porque o-dia o-dia o-dia não não encontrar-no no-campo
\v 26 seis-de dias recolham-no e-no-dia o-setimo sabáth não ele-será- em-ele
\v 27 e-aconteceu no-dia o-sétimo saíram de o-povo para-coletar e-não acharam
\v 28 E-disse yhwh a Moisés até a-onde de-voces לשמור as-minhas-mandamentos e-de-mim-leis
\v 29 olhem porque dar a-vós para-vós o sétimo ele assim a-vós no-dia a-vós pão o-sexto pão dias descanse homem em-lugar-dele a sairá no-dia de seu lugar no-dia o sétimo
\v 30 e-eles-assentaram-se o-povo no-dia o-sétimo
\v 31 e-eles-chamaram casa-de Israel a nome-de-ele de e-ele como-semente gad la-van e-o-sabor como-de-espuma com-mel
\v 32 E-disse Moisés este a-palavra que ordenou yhwh enchei o-omer nós para-de-guarda para-gerações-de-vocês para-a-cau-sa-de e-verão a o pão que eu-eu-comi vos no-deserto בּוֹחֲצִיעַי vos de-terra-de Egito
\v 33 E-disse Moisés a Arão qach uma uma e-tenha lá cheio-de ele de yhwh ele diante-de yhwh para-de-guarda para-gerações-de-vocês
\v 34 como ordenou yhwh a Moisés e-ele-o-colocou de-Aaron diante-de da-testemunho para-guarda
\v 35 e-filhos-de Israel comam a o-ma-nãh quarenta ano até deles-os a terra morando-a a terra comeram-e até deles-os a fim-o terra כְּנָֽעַן
\v 36 e-a-omer décima-a a-árvore ele
\c 17
\p
\v 1 e-partiram-e todo assembleia-a filhos-de Israel do-midbar- yhwh lemaseihem sobre boca-de águas e-acamparam em-Rפידים e-não-há águas para-beber-ele o-povo
\v 2 e-estava-cheio o-povo com Moisés e-disseram águas para-nós E-disse a-eles E-disse para-eles comigo que a-multidão comigo que- vocês-experimentarão a yhwh
\v 3 e se-desejava nome o-povo água e desfaleceu o-povo sobre E-disse E-disse por-que isto vocês nos levantaste do-Egito para matar de-mim-me e-a filhos-de e-a minha posse no deserto
\v 4 e-clamou Moisés a dizendo dizendo que eu-farei ao-povo esta ainda pouco e-apedreje-me
\v 5 E-disse yhwh a Moisés passagem diante-de o-povo e-toma contigo מִזִּקְנֵי Israel e-mat-teu que golpeaste em-ele a o-rio pe-go em-a-mão-tua e-andaste
\v 6 eis-me ficou-em-pé para-diante-tu ali sobre o-saliente em-Horebe e atingirás na-rocha e saíram nós águas e-bebeste o-povo E-fez assim Moisés aos-olhos-de anciãos-de Israel
\v 7 E-chamou nome o-lugar massá e-mrívah sobre riv filhos-de Israel e-sobre nasstam a dizendo dizendo yhwh yhwh b-qirbbenuv se não.
\v 8 E-veio עֲמָלֵק e lutou com Israel birfidim
\v 9 E-disse Moisés a יְהוֹשֻׁעַ בְּחַר- lanu homens ve-tsé [מָחָ֗ר] eu amanhã eu-sou estava de pé sobre cabeça das colinas ומטה Elohim BYADHI:
\v 10 E-fez Josué como-que palavras-de a-ele Moisés para-lutar ba-amalek umoshe Aarão e-Hur subiram cabeça a montanha;
\v 11 e-foi como-que ele-elevará Moisés sua-mão e-sejusgado Israel vekaʾasher ele-descansará sua-mão e-sejusgado Amaleque
\v 12 e-mãos-de Moisés pesados e-eles-tomaram- pedra e-os-colocaram abaixo-dele e-sentou sobre-ela e-Aharon e-Hur tamechu be-yadaiv um um um e-houve E-foi suas mãos Emuna até veio o-sol
\v 13 ve-ya-chalosh יְהוֹשֻׁעַ a Amalek e-a amav à-boca-de com-espada
\v 14 E-disse yhwh a Moisés esta esta zikaron no-livro veshim em-orelhas-de Yehoshua porque maho eu-apagarei debaixo-de macho Amaleque de-debaixo-de os-céus
\v 15 E-edificou Moisés מִזְבֵּ֑חַ E-chamou seu-nome yhwh dele-é
\v 16 E-disse porque mão sobre trono Yah guerra a-yhwh contra-Amaleque geração geração
\c 18
\p
\v 1 E-ouviu de-Jetro sacerdote Midiã cons- sogro Moisés a todo que fez Elohim לְמֹשֶׁ֔ה e-a-israel povo-seu yhwh tire-ou yhwh a Israel de-Egito
\v 2 E-tomou Jetro cons- sogro Moisés a Tsipora mulher-de Moisés depois seus-enviados
\v 3 e-a segundo be-ne-ha que nome o-primeiro ger-shom que disse forasteiro eu-fui em-terra-de estranha
\v 4 e-nome-de o-primeiro Eleazar porque Elohim-de pai-meu no auxílio e me resgatou de espada פַּרְעֹה
\v 5 E-veio yit-ro cho-ten Moisés u-ba-na-vau e-esposa-dele a Moisés a o-deserto que ele cho-ne nome monte-de Elohim
\v 6 E-disse a Moisés eu seu cunhado Jetro veio a-ti e sua mulher e-dois-de com-ela com ela:
\v 7 e-saiu Moisés ao-encontro-de sogro-seu e-abaixou-se e-beijou- a-ele e perguntaram homem-de para-o-amigo-seu para-paz e-vieram a-tenda
\v 8 e-disse Moisés para-o-cunhado-seu את todo que yhwh yhwh para-Pharaoh sobre sobre odeiras Israel a todo a-maldição que encontraram-seu yhwh e-ele-salvou-os yhwh
\v 9 e uniu-os Jetro sobre todo a-boa yhwh fez yhwh a Israel que resgatou-o de-mão-de Egito
\v 10 E-disse Jetro bendito yhwh que salvou a-vós de-mão-de Egito e-de-mão-de Faraó que resgatou a debaixo-de de-debaixo-de mão-de Egito
\v 11 agora soube porque yhwh yhwh que o-Elohim porque badavar que zadu sobre-eles
\v 12 E-tomou Yitro choten Moisés holocausto uzvachim para-אלהים E-veio Arão e-tudo anciãos-de Israel para comer pão com choten Moisés diante-de Elohim
\v 13 e-houve de-amanhã e-habitou Moisés para-julgar a o-povo e-ele-estabeleceu o-povo sobre Moisés de o-amanhecer até no entardecer
\v 14 E-viu cons- sogro Moisés a todo que ele E-disse para-o-povo E-disse que tu o-este que tu tu para-o-povo madua' tu habitante- apenas contigo e-todo o-povo stood sobre-ti de manhã até tarde
\v 15 E-disse Moisés para-o-sogro porque virá a-mim o-povo para-buscar Elohim
\v 16 porque a-eles para-eles palavra veio a-mim entre entre e-entre e-entre companheiro-seu e-anunciarei a de-leis Elohim e-a das-sua-ordens
\v 17 E-disse o-sogro Moisés a-ele não bom a-palavra tu tu fez
\v 18 a-decayimento você-decaina também tu também o-povo este que contigo porque seja-grave de-tu a-palavra não poderás faz-o apenas de ti:
\v 19 Agora ouviu no teu voz aconselha-te e-seja Elohim contigo foi tu ao povo em-frente-a הָֽאֱלֹהִ֔ים e trazeste tu a as-palavras a Elohim
\v 20 e-adverti-los a-eles a os-regulamentos e-a a-eles e-anunciaste para-ela-os a o-caminho irão nela e-a o-trabalho que fazem
\v 21 e-tu TECHAZEH de-todo o-povo ANASH'E- CHAYIL YIREI' Elohim homens-de EMET SON'EI' BATZA' VESAM'THA' ALHEM príncipes-de milhares príncipes-de centenas príncipes-de cinquenta e-príncipes-de dez
\v 22 e-julgaram a o-povo em-todo tempo o-grande todo a-coisa o-grande o-pequeno a-ti e-todo a-palavra o-pequeno julgarão-os eles e-aliviar me'al-eka וְנָשְׂא֖וּ contigo
\v 23 mãe a a-coisa o-este farás e-ordenou-te Elohim e-poderás ficou-em-pé e-também todo o-povo esta sobre de-seu-lugar virá em paz
\v 24 E-ouviu Moisés à-voz-de o-marido-dele E-fez todo que disse
\v 25 e escolheu Moisés homens de força de-todo eles E-deu a-eles cabeças sobre o-povo príncipes-de milhares príncipes-de centenas príncipes-de cinquenta e-príncipes-de dez
\v 26 e-julguem a o-povo em-todo o-tempo a a-coisa o-difícil o-pequeno a eles e-todo a-palavra o-pequeno e-julgarão eles
\v 27 e-enviou Moisés a o-marido-dele a-ele a-ele a terra-dele
\c 19
\p
\v 1 em-o-mês o-terceiro para-sair filhos-de Israel da-terra no-dia em-o-dia esta entraram deserto-de Sinai
\v 2 e-partiram de-Rפידים e-vieram deserto-de Sinai e-acamparam no-deserto e-acampou-se- nome diante diante-de o-monte
\v 3 e-moshe subir a E-chamou a-ele yhwh yhwh dizendo o-monte dizendo assim dirás para-casa-de Jacó e-anunciaste para-filhos-de Israel
\v 4 vós vistes que fiz Lemitsrayim e-levantei vos sobre as-asas penas e-traggo vos para-mim
\v 5 e-agora se ouvinte ouvi-reis com-a-minha-voz e-vos-guardastes e-sereis da-minha-aliança e-fosteis para-mim segregada de-todo os-povos porque para-mim todo a-terra
\v 6 e vós ser-vós-vos-vereis- para-mim reino-de sacerdotes e-povo Estas estas-estes as-palavras que falarias a filhos-de Israel
\v 7 E-veio Moisés E-chamou para-os-anciãos o-povo e-colocou em-frente-a-eles a todo as-palavras os-estes que yhwh yhwh
\v 8 e-responderam todo o-povo yachdav e-disseram todo yhwh palavra yhwh façamos-nós e-estabeleceu-se Moisés a palavras-de o-povo a yhwh
\v 9 E-disse yhwh a eis eu eu veio para ti em-entre o-nuvem por-causa-de ouvirá o-povo em-minhas-palavras contigo e-também em-te crerão para-sempre e-revelou Moisés a palavras-de o-povo a yhwh
\v 10 E-disse yhwh a Moisés vai a o-dia e-os-santificarei o-dia e-amanhã e-lavarem-se-as-roupas suas-vestes-verso-final
\v 11 e-sejam prontos para-o-dia o terceiro que no-dia no-dia descer-á yhwh yhwh todo o-povo sobre monte-de Sinai
\v 12 e-limitarás a o-povo dizendo dizendo a-vós a-vós subida na-montanha e-tocarás em-a-sua-extremidade todo morrendo na-montanha morrer será-morto
\v 13 não tocarás mão mão porque sacudirás será-sacudido ou jorrará não se animal se homem não viva em-a-duração-do-trombeta o-trombeta eles subam em-o-monte
\v 14 e desceu Moisés de o-monte a o-povo e-os-consagrou a o-povo e-eles-lavaram as-vestes-deles
\v 15 E-disse a o-povo sejam prontos para-três dias a vocês-virão a mulher
\v 16 e-houve no-dia o-terceiro para-serem a-manhã e-houve vozes e-raios e-nuvem pesado sobre o-monte e-som de-trumpete muito muito e-tremeu todo o-povo que no-lager
\v 17 e-saiu Moisés a o-povo para-encontro-de os-elohim de o-acampamento va-yit-ya-tsăbū em-baixo o-monte
\v 18 -e montanha Sinai ashan kullo de-diante-de que yarad sobre-ele yhwh no-fogo e-subiu asano ke'ashen hakchibshan e-tremeu todo muito muito
\v 19 e-houve voz o-shofar  הולך  e-forte muito Moisés יְדַבֵּ֔ר וְהָאֱלֹהִ֖ים responderá-o em-a-voz
\v 20 e desceu yhwh sobre monte-de Sinai a E-chamou yhwh E-chamou yhwh para-Moshe a cabeça o-monte e-ofereceu Moisés
\v 21 E-disse yhwh a Moisés רֵ֖ד o-testemunha no-povo-o para-que-não para-ver a nós para-ver e-caiu dele muito
\v 22 e-também hakohanim os-que-se-aproximam a yhwh se-santificarão para-que-não yhwh neles yhwh
\v 23 E-disse Moisés a yhwh não podera o-povo para subir a monte-de Sinai dizendo você a testemunha neles para-dizer o cercado a muito e santificá-lo:
\v 24 E-disse a-ele yhwh vai- desce tu tu e-Aharôn contigo e os sacerdotes e-o povo a destruam para-subir a yhwh para-que-não que se espalhe- em-eles
\v 25 e-desceu Moisés a E-disse E-disse a-eles
\c 20
\p
\v 1 e-falou Elohim a todo as-palavras dizendo para-dizer
\v 2 eu yhwh Elohim-teu que saí-te de-terra-de Egito de-casa escravos
\v 3 não sera- para-ti Elohim outros sobre minhas-faces
\v 4 não farás- para-ti ídolo- e-todo imagem que nos-céus- de-a-cima e-que em-a-terra de-a-baixo e-que na-agua de-abaxo debaixo-de
\v 5 não a-eles para-eles e-não que porque yhwh yhwh Elohim-teu El zeloso que-visita pecado avós sobre filhos sobre tri-nos e-sobre quad-ro-s a-o-inim-ho
\v 6 e-faz chan-dor para-milhares a-am-o-s e-para-guardadores-de mandamentos-meus
\v 7 não e-le-va a nome-de yhwh que não porque yhwh pur-gar-a yhwh a que e-le-va a nome-de-ele para-a-vaidade-verso-final
\v 8 lembra-te a dia o-sábado para-santificá-lo
\v 9 seis dias servirás e-fazes todo trabalho-teu
\v 10 e-dia o-sétimo sábado- a-yhwh Elohim-teu não farás todo tu você- e-filhoteu- e-filha-teu servo-teu e-escravateu e-em-vossoanimal e-estrangeiro-teu que em-a-porta-de-tuas
\v 11 que seis- dias yhwh yhwh a os-céus e-a a-terra no-dia o mar e-a todo yhwh contra-eles e-ele-descansou no-dia o sétimo sobre sim abençoou yhwh a dia a-sabáte e-ele-o-consagrou
\v 12 honra a Avicha e-a mãe-tua para-que sobre a-terra sobre האדמה que para-ti seus-elohim deu para-ti
\v 13 não não-matarás
\v 14 não não-terás-covarde
\v 15 não não-rou-bas
\v 16 não res-pon-da em-o-seu-amigo até mentira
\v 17 não tachmod casa re'ekha não desejarás mulher-de re'eka ve-avdo va-amato e-seu-boi e-tudo e-todo que lere'eka
\v 18 e-todo o-povo vendo-os a as-vozes voz os que brilham e-את voz-de E-viu e-a o-monte fumo-será E-viu o-povo e-eles-tremeluziram e-eles-pararam-se de-a-longe
\v 19 e-disseram a Moisés daber- tu com-nos e-será-ouvida El יְדַבֵּר immanu Elohim para-que-não morram-vos
\v 20 E-disse Moisés a o-povo que v-trepareis porque para-a-razão-de tentações vos veio o-Elohim e-por-causa-de seráis-vós para-não sobre vossas-caras para-não pecareis-vos
\v 21 e-estabeleceu o-povo de-longe umoshe se-aproximou a a-escuridão que nome Elohim
\v 22 E-disse yhwh a Moisés assim tu teirim a filhos-de Israel que vistes-vós porque de os-céus falei com-vos
\v 23 não fazeis comigo deos prata e-Elohim-de ouro não fazeis a-vós
\v 24 altar-de terra farás- para-mim e-imoltes sobre-ele a vossas-ofertas e-a vossos-sacrifícios-de-paz a rebanho-vosso e-a vossas-ovelhas em-todo o-lugar que lembrarei a meu nome- irei a-ti e-bençã-o-te
\v 25 e-se altar-de pedras tu-farás para-mim não que a-elas cortou porque espada-tua levantou-te sobre-ela e-vilefez-a
\v 26 e-não subirás em-alturas sobre de-meu-altar que não serás-revelado erva-teu sobre-ele
\c 21
\p
\v 1 e-estes os-juízos que ta-shim diante-deles
\v 2 que tique-he servo hebree seis dois ele-serve e-bash-seveeth saia la-chafshee gratuitamente
\v 3 se be-gapho yavo be-gapho sairá se ele mulher ele וְיָצְאָה mulher-sua com-ele-verso
\v 4 se adonai-o dê a-ele filhos ve-yalda- a-ele filhos ou filhas a-mulher ve-ilade-ha תִּהְיֶה֙ para-a-sua-madama e-ele saia em-o-seu
\v 5 e-se disse diga יֹאמַר֙ o-escravo amou-ei a Adonai não mulher-sua e-a filhos-de não אֵצֵא livre-seu
\v 6 e-aproximou-ele adonai-o a Elohim e-aproximou-ele a a porta ou a a-moldura e-ferrou seu-adonai para-sempre a-sua-orelha em-a-marca e-serviu-o para-sempre
\v 7 e-quando venderá homem a não para-escrava não sairás como-a-saída os-escravos
\v 8 se ruim em-os-olhos de-seu-adonai que ele-desejou-a e-redimiu-a para-o-povo estrangeiro não reinará para-vender-a em-o-seu-vestido em-ela
\v 9 e-se para-o-seu-filho será-dada-a conforme-o-julgamento das-filhas fará- a-ela
\v 10 se outra יִקָּח־ a-ele שֹׁאֵרָהּ não וְעֹנַתָ֖הּ não יִגְרַע׃
\v 11 e-se não אֵלֶּה não faz-o para ela וְיָצְאָה חִנָּם não כַּסֶּפֶת׃
\v 12 מַכֶּה homem וָמֵת morrendo será-morto
\v 13 וַאֲשֶׁר֙ não צָדָה וְהָאֱלֹהִ֖ים אִנָּ֣ה לְיָד֑וֹ וְשַׂמְתִּ֤י a-ti lugar que יָנ֖וּס ali
\v 14 e-quando יָזִ֥ד homem sobre re-a-hu לְהָרְג֣וֹ בְעָרְמָ֑ה de-com altar-meu תִּקָּחֶ֖נּוּ para a morte
\v 15 e que atinge seu-pai e sua mãe morrendo será-morto
\v 16 e que rouba homem e o vende e é achado em sua mão morrendo será-morto
\v 17 e maldiz seu-pai e sua mãe morrendo será-morto
\v 18 e-quando se disputarão homens e atingirá homem a companheiro-seu em-pé ou em-águpe e-não mor-te e-caiu para-cam-a:
\v 19 se ar-rise e-andará fora sobre de-sua-cara e-pur-a o-ma-chado somente sua-sentada irá dar e curará curará
\v 20 e-quando atingirá homem a seu servo ou a debaixo sua-mão e morrerá em-lugar-de sua-mão vengará-se vengará-se
\v 21 entretanto se dia ou dois dias não não que porque ele ela
\v 22 e-quando vencerão אֲנָשִׂים וְנָגְפוּ mulher הָרָה e-eles-sairão יְלָדֶיהָ será será אָסֹון עָנֹשׁ יֵעָנֵשׁ como יָשִׁית sobre-ele בַּ֣עַל a-mulher וְנָתַן בִּפְלִלִים׃
\v 23 e-se será yihye e-tu-darás debaixo debaixo-de alma
\v 24 olho debaixo olho שֶׁן debaixo שֶׁן mão debaixo mão רֶגֶל debaixo רָגֶל׃
\v 25 כּוֹויָה debaixo כּוֹויָה פֶּץַע debaixo פָּץַע חַבורָה debaixo חַבורָה׃
\v 26 e-quando irá atingir homem a olho seu servo ou a olho debaixo e corromperá livremente enviará em-baixo-de sua face
\v 27 e-se dente seu servo ou dente seu servo dejará cair debaixo enviará em-baixo-de שנה׃
\v 28 e-quando יחג boi a homem ou a mulher ומות סקל יסקל השור e-não יאכל a em-carne-sua e-baal השור נקי׃
\v 29 e-se ovelha -nagach- ele desde-mol -shilshom- e-hu'ad em-seus e-não guardará-o e-matará homem ou mulher o-touro irá-queimar e-também em-ló será-morto
\v 30 se kôper yûšath sobre-ele vênatan pîdêyon naphshô conforme-tudo que yûšath sobre-ele
\v 31 ou filho yiggach ou bat yiggach como-o-julgamento para-ele será-feito para-ele
\v 32 se servo יִגַּח השור ou אָמַה כּסֶף trinta שְׁקָלִים dará לַאֲדֹנָיו וְהַשׁוֹר יִסַּקֵל׃
\v 33 e-quando יִפְתַּח homem בָּור ou- porque irá homem bur e-não cobrirá e cairá- lá burro ou cavalo:
\v 34 senhor do bur pagará prata יָשִׁיב לִבְעַלֵּיהוּ וְהַמֵּת ele-será- para-ele
\v 35 e-quando יִגַּפ שׁוֹר־ homem a boi re-a-hu ומות וּמָכְרוּ a הַשׁוֹר o-vivo וְחָצֻ a com-prata-seu e-também a o morto יֵחֱצוּן׃
\v 36 ou 노다' que boi נגג' ele de-ontem anteontem e-não ישמרנו' בעלאו שלא' pague שור debaixo השור והמת ele-será- para-ele
\v 37 que יגנב- homem boi ou שוה e-o-carne ou e-o-vendido cinco debaixo pagará em-lugar-de debaixo e-quatro-de ovelhas debaixo-de o-cordeiro
\c 22
\p
\v 1 se no-ferrete será-encontrado o-ladrão e-atingirá e-morrerá a-ele a-ele דּוֹמִים׃
\v 2 se זַרְחָה o-sol sobre-ele a-ele a-ele שַׁלֵּם pagará a-ele não-há a-ele וְנֻמַּכּר בְּגִנְבָּתוֹ׃
\v 3 se הִמְצֵא֩ תִּמְצֵא בְּיָדוֹ הַגִּנְבָּה משׁור até vida até שׂה vivos dois ישׁלם׃
\v 4 que  yab'er- homem שׂדה ou כרם וְשׁילַח֙ a וּבִעֵר em-campo-de acher mitev שׂדהוּ e bom o jardim
\v 5 porque sairá אֵ֜שׁ e encontrará espinhos e seremos comidos trigo ou a germinação ou o-campo paz pagará o que faz passar a a que arde:
\v 6 porque dê homem a seu companheiro prata ou instrumentos para guardar e furtado de-casa-de o-homem se será-encontrado o-ladrão pague dois
\v 7 se não será achado o גַּנָּ֔ב e וְנִקְרַ֥ב de בַּֽעַל־ a-casa a sua-mão se não enviou mão-sua na בִּמְלֶ֥אכֶת seu-amigo
\v 8 sobre todo palavra-de a פֶּ֡שַׁע sobre shór sobre o חֲ֠מוֹר sobre a שֶׂ֨ה até a שַׂלְמָ֜ה sobre todo o אֲבֵדָ֗ה que dira porque ele este até הָֽאֱלֹהִ֔ים yavo palavra-de dois-deles que יַרְשִׁיעֻן֙ Elohim pague dois לְרֵעֵֽהוּ׃
\v 9 porque dê homem a seu companheiro חֲמ֨וֹר ou boi ou שֶׂ֛ה e-todo animal לִשְׁמֹ֑ר וּמֵ֛ת ou- נִשְׁבַּ֥ר ou- nishba não viu
\v 10 de-o-selo yhwh תִּהְיֶה֙ entre dois-deles se não sua-mão mão-sua בִּמְלֶ֣אכֶת e-tome e tomará dele e-não pagará;
\v 11 e-se ladrão roubará dele pagará a ele;
\v 12 se golpeador golpeará יְבִיאֶהוּ até não não ישׁלם׃
\v 13 e-quando יִשַׁאֵל homem de-com re-a-hu וְנִשַׁבֵּר ou morreu בְּעָלָיו não-há com-ele שַׁלֵּם ישׁלם׃
\v 14 se בְּעָלָיו não não יְשַׁלֵּם ele שָׂכִיר ele veio בִּשְׂכָרֽוֹ׃
\v 15 e-quando יְפַתֶּ֣ה homem בְּתוּלָ֛ה que não com-ela וְשָׁכַ֣ב com-ela para-ele יִמְהָרֶ֥נָּה a-ele para-mulher
\v 16 se מָאֵ֧ן יְמָאֵ֛ן אָבִ֖יהָ a-ele a-ele prata יִשְׁקֹ֔ל כְּמֹ֖הַר as vírgidas:
\v 17 a feiticeira não viverá:
\v 18 todo dormir morrendo animal morrer será-morto
\v 19 sacrificador aos elohim(es) ele o abominará: para-não a-yhwh sozinho
\v 20 e estrangeiro não arrependimento e-não será apertado porque גרים fosteis em-terra-de Egito
\v 21 todo אלמנה não não תענוון׃
\v 22 se אנוה ele que porque se צעוק יצעק a-mim ouviu אֵשְׁמַע צעקתו׃
\v 23 והרה אפיתי והרגתי vos com a espada e-sejam נְשֵׁיכֶם אֲלָמֹות וּבְנֵיכֶם יְתוֹמִים׃
\v 24 se כּסֶף תַּלְוֶה a עַמּי a הֶעָנִי֙ a-ele não תִהְיֶה a-ele כְּנוֹשֶׁה não תְּשַׂימ֥וּן sobre-ele נֶֽשֶׁךְ׃
\v 25 se חָבֹ֥ל תַּחְבֹּ֖ל שַׂלְמַ֣ת re'ekha até veio a-ele תְּשִׁיבֶ֥נּוּ a-ele
\v 26 que ela para-a-sua-conta הִ֥וא שִׂמְלָת֖וֹ ela בַּמֶּ֣ה יִשְׁכָּ֔ב e-foi porque יִצְעַ֣ק a-mim וְשָׁמַעְתִּ֖י porque חַנּ֥וּן eu
\v 27 Elohim não תְקַלֵּ֑ל וְנָשִׂ֥יא בְעַמְּךָ֖ não תָאֹֽר׃
\v 28 מְלֵאָתְךָ֥ וְדִמְעֲךָ֖ não תְאַחֵ֑ר em-primogênito בָּנֶ֖יךָ tu-darás para-mim
\v 29 assim farás para-te para-o-ovelho-te shib-aat será será no-dia mãe-dele no-dia o-sétimo dar-vos-vou para-mim
\v 30 e-para-os santidade ser-vós-vais a-mim e-carne no-campo não não vós-comereis para-o-cão ele a-ele
\c 23
\p
\v 1 não levardes-vos ouviu שָׁוְא a תַּשְׁבִּית mão-tua com perverso-o להיות até violência
\v 2 não תִהְיֶה אחרי- muitos לרעות e-não תענה sobre muito לנטות atrás-de muitos להטות׃
\v 3 והDAL não תֶהְדַּ֖ר בְּרִיבֽוֹ׃
\v 4 que תִפְגַּ֞ע שׁ֧וֹר אֹֽיִבְךָ֛ ou חֲמֹר֖וֹ תֹּעֶ֑ה retornar תְּשִׁיבֶ֖נּוּ a-ele
\v 5 porque תִרְאֶ֞ה חֲמ֣וֹר שׂונאתך debaixo em-lugar-de משהאו והchalkalta a-ele a-ele עזוב תעזוב com-ele-verso
\v 6 não תטה משפט איבונך בְּרִיבֽוֹ׃
\v 7 מדבר־ שֶׁׁקֶר תִּרְחָ֑ק ונקי e-צדיק que תּהֲרֹג porque não אַצְדּיָק perverso
\v 8 וְשׁוֹחַד não תִּקָּח que הַשׁוֹחַד יְעַוֵּר פִּיקְחִים וִֽיסַלֵּף palavras-de צַדּיָקִים׃
\v 9 e o estrangeiro não será apertado e-vós vós conheceréis a alma o estrangeiro porque estrangeiros fostes em-terra-de Egito
\v 10 e-seis dois sowaste a a tua terra e-ajuntarás a suas produções
\v 11 e a sétima será deixada e a despojará e comerão avíons seu povo e restarão comerás animal-de o-campo assim farás para seu jardim para suas oliveiras:
\v 12 seis dias farás suas obras e no dia ha-shevi-i תִּשְׁבֹּ֑ת para-que יָנ֗וּחַ שֽׁוֹרְךָ֙ וַחֲמֹרֶ֔ךָ וְיִנָּפֵ֥שׁ filho-de אֲמָתְךָ֖ וְהַגֵּֽר׃
\v 13 וּבְכֹ֛ל que disse a-vós תִּשָּׁמֵ֑רוּ e-ali Elohim não não não não יִשָּׁמַ֖ע sobre teu-boca:
\v 14 três pés- comemorar- a-mim ano-
\v 15 a chag os-maizot- guardar- sete-de comerás comer- maizot como- eu-te-ordenei- לְמֹועֶד֙ novo הָאֲבִיב֑ porque em-ele יָצְאָתָ֣ de-Egito e-não יֵרָאוּ֥ face-de vazios
\v 16 וְחַ֥ג הַקֹּצִ֗יר בְּכוּרֵ֣י suas obras que תִּזְרַ֗ע no-campo וְחַ֥ג האסיפ בצאת השנה באספך a מעשיך de o-campo
\v 17 três פעמים בשנה יראה todo זכורך a face-de yhwh yhwh
\v 18 não תזבח sobre  חָמֵ֖ץ   דַּם־   זִבְחִ֑י  e-não yalin gordura-de  חַגִּ֖י  até manhã
\v 19 רֵאשִׁ֗ית   בִּכּוּרֵי֙   אַדְמָ֣תְךָ   תָּבִ֕יא  casa yhwh teu-Elohim não  תְבַשֵּׁ֥ל   גְּדִ֖י  sua-mãe mãe-de ele
\v 20 eis eu enviou מַלְאָךְ diante-de-ti לִשְׁמָרְךָ בַּדָּ֑רֶךְ וְלַהֲבִ֣יאֲךָ a o-lugar que הֲכִנֹֽתִי׃
\v 21 הישמר מִפָּנָ֛יו וּשְׁמַ֥ע בְּקֹל֖וֹ a תַּמֵּ֣ר que não não yasua que porque nome-meu em-o-centro-dele
\v 22 que se ouviu תִּשְׁמַע֙ em-voz-dele e farás todo que eu falar e aborrecer a teu inimigo e comprimir-te-ei a teus apertadores
\v 23 porque irei minha angelos ante ti e trarei-te a o-emori e-o-heteu e separarei וְהַֽכְּנַעֲנִ֔י o-hivi e-o-jebuseu e o farás arder
\v 24 não terás por adoração aos seus elohim e-não os farás servir e-não você-fará que porque destruirás destruirás e quebrarás quebrarás as suas estâtuas
\v 25 e servireis a yhwh Elohim-vosso e abençoe a o teu pão e-a as tuas águas e eu tirarei doença do-teu-interno
\v 26 não ser-ás cicatriz e eu arrebentar na tua terra a número os teus dias e eu preencher
\v 27 a minha dor Eu lançarei diante-de-ti e a morte a todo o-povo que virá com-eles e eu darei a todo seus inimigos a-ti na face:
\v 28 e lançarei a a fome diante-de-ti e a desolação a do Hivite a o-cananeu e-a do Hítie de-a-frente-de-você-versículo-final
\v 29 não o arrependerei dele de ti diante no ano um para-que-não a-terra a-terra sem semear e multiplicarei animal-de vivente-de o-campo
\v 30 pouco מְעַ֛ט o arrependerei dele de-diante-de-você até que e te ferirei e herdarei a a-terra
\v 31 e beberei a גּוֹבְלֵךְ מִיַּם- Suf e-até mar que וּמִמִּדְבָּר até o-rio que darei a-terra a habitantes-de a-terra וְגֵרַשׁתָּם de-diante-tua
\v 32 não a-eles a-eles וְלֵאֱלֹהֵיהֶם em-brisa
\v 33 não יִשַׁבּוּ בְּאַרְצֶךָ para-que-não יַחֲטִיאוּ a-ti que porque תַּעֲבֹד a a-ti porque será para-ti para-laço
\c 24
\p
\v 1 e-a disse folhas-de sobe tu yhwh tu e-Aarão Nadabe e-Avi-hu-a e-setenta מִזִּקְנֵי Israel e-vos-inclinar-eis de-longe:
\v 2 e-avancar Moisés sozinho a yhwh não não e-avançarão não não eles-subirão com-ele-verso
\v 3 E-veio Moisés e-disse para-o-povo a todo yhwh יהוה e-a todo as-julgamentos voz um o-povo voz um yhwh todo as-palavras que palavra yhwh serão-feitas:
\v 4 e-escreveu Moisés a todo yhwh yhwh e-ele-levantou-se E-edificou e-ele-construiu debaixo em-lugar-de o-monte e-ambas dez מַצֵּבָ֔ה לִשְׁנֵ֥ים dez tribos-de Israel
\v 5 e-enviou a נַעֲרֵי֙ filhos-de Israel וַיּֽ͏ַעֲל֖וּ עֹלֹ֑ת וַֽיִּזְבְּח֞וּ זְבָחִ֧ים שְׁלָמִ֛ים a-yhwh פָּרִֽים׃
\v 6 E-tomou Moisés metade o-sangue וַיָּ֖שֶׂם בָּאַגָּנֹ֑ת וַחֲצִ֣י o-sangue זָרַ֖ק sobre o-altar
\v 7 E-tomou livro a-aliança E-chamou em-orelhas-de o-povo e-disseram todo que yhwh yhwh נַעֲשֶׂ֥ה וְנִשְׁמָֽע׃
\v 8 E-tomou Moisés a o-sangue וַיִּזְרֹ֖ק E-disse eis E-disse eis דַֽם־ yhwh que sobre yhwh com-vocês sobre todo as-palavras as estas
\v 9 e-ofereceu Moisés e-Arão Nadav e-Avi-hu-a e-setenta de-anciãos-de Israel
\v 10 e-eles-viram a Elohim-de Israel e-embaixo-de רַגְלָ֗יו כְּמַעֲשֵׂה֙ לִבְנַ֣ת o safir -cezem os-céus -para-se purificar:
\v 11 e-a os que saem filhos-de não não sua-mão sua-mão e viram a Elohim e comeram e beberam:
\v 12 E-disse yhwh a folhas-de sobe a-mim a montanha -seja- a-ti E darei-lhe a ti a tabelas a pedra e a lei e o mandamento que escrevi-os para ensiná-los:
\v 13 E-levantou Moisés e Josué seu servo e-ofereceu Moisés a monte-de Elohim
\v 14 e-a disse disse sentai até nisto até que retornaremos a-vós e-eis אַהֲרֹן e-Hur com-vocês quem Ba'al de-ber yigash a-eles
\v 15 e-ofereceu Moisés a o-monte vayekas ha-eanan a o-monte
\v 16 vayishkon kavod- yhwh sobre monte-de Sinai vayekashehu ha-eanan E-chamou dias no-dia a Moisés no-dia ha-shevi-i de-meio ha-eanan:
\v 17 וּמַרְאֵה֙ glória-de yhwh כְּאֵ֥שׁ אֹכֶ֖לֶת na-cabeça o-monte aos-olhos-de filhos-de Israel
\v 18 E-veio Moisés no-meio-de ha-eanan e-subiu a e-houve E-foi Moisés no monte dia dia noite noite
\c 25
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 palavra a filhos-de Israel e-eles-tomarão- a-mim Terumá me'et todo homem que יִדְּבֶ֣נּוּ coração-dele תִּקְח֖וּ a תְּרוּמָתִֽי׃
\v 3 ve-zot הַתְּרוּמָ֔ה que תִּקְח֖וּ de-lhes ouro e-prata e-niqureth:
\v 4 e-tekeli e-púrpura e-carmesim segundo e-seis e-azim:
\v 5 e-peles oveis vermelhas-muito e-peles tachashim וַעֲצֵ֥י שִׁטִּֽים׃
\v 6 שֶׁ֖מֶן לַמָּאֹ֑ר בְּשָׂמִים֙ לְשֶׁ֣מֶן o-mishcha וְלִקְטֹ֖רֶת הַסַּמִּֽים׃
\v 7 pedras-de- שֹׁ֕הַם וְאַבְנֵ֖י מִלּוֹאִים לָאֵפוֹד וְלַחֹשֶׁן׃
\v 8 וְעָשׂוּ a-mim מִקְדַּשׁ וְשָׁכַנְתִּי em-meio-de-eles
\v 9 כְּכֹל que eu vista אוֹתֶיךָ֔ a תַּבְנִיט o-tabernáculo e-a תַּבְנִיט todo seu recipiente e-assim façam
\v 10 e façam arca madeiras-de acácia dois palmos e meio seu-comprimento e um palmo e meio em-ele-o-largura-seu e um palmo e meio sua altura
\v 11 וְצִפִּיתָ֤ ele ouro puro de-dentro e-de-fora תְּצַפֶּ֑נּוּ וְעָשִׂ֧יתָ sobre-ele זֵ֥ר ouro ao-redor
\v 12 וְיָצַ֣קְתָּ para-ele quatro טַבְּעֹ֣ת ouro וְנָ֣תַתָּ֔ה sobre quatro פַּעֲמֹתָ֑יו e-duas-de טַבָּעֹ֗ת sobre צַלְעוֹ֙ a-uma u-shtey טַבָּעֹ֔ת sobre צַלְע֖וֹ הַשֵׁנִֽית׃
\v 13 e-farás בַדֵּ֖י madeiras-de acácia וְצִפִּיתָ֥ eles ouro
\v 14 וְהֵֽבֵאתָ֤ a הַבַּדִּים֙ sobre sobre צַלְעֹ֣ת הָאָרֹ֑ן para-levar a הָאָרֹ֖ן neles
\v 15 בְּטַבְּעֹת֙ הָאָרֹ֔ן serão הַבַּדִּ֑ים não יָסֻ֖רוּ nós
\v 16 וְנָתַתָּ֖ a הָאָרֹ֑ן a o-testemunho que etenn para-ti
\v 17 e-farás כַפֹּ֖רֶת ouro puro אַמָּתַ֤יִם e meio אָרְכָּ֔הּ e um palmo e meio rāḥabbah
\v 18 ve'asitā dois kərubīm ouro miqšāh farás eles misnē pontas ha-kappōret
\v 19 va'asē querubim um miqqetsāh deste-lado e-caravel- um de-acéu- deste de a-caporéth- fazei a os-querubins sobre segundo os-seus-filhos-
\v 20 e-sejam os-querubins que-spreadem- as-asas- acima-de- cobrindo-os- com-as-sus-asas- sobre a-caporéth- e as faces homem a irmão-dele face-de os-querubins serão face-de os-querubins
\v 21 e eu dar-te-ei a a propiciação sobre o arca de-acima e-a o arca dês a a testemunho que etenn para-ti
\v 22 e eu me assemblerei a-ti nome e eu falar-te-ei contigo de-cima-de a propiciação do meio segundo os-querubins que sobre arão a testemunha a todo que ordenemos te a filhos-de Israel
\v 23 e-farás mesa árvores-de acácia dois pés seu-comprimento e um pé em-ele-o-largura-seu e um pé e meio de sua altura:
\v 24 e cobrirás ele ouro puro e-farás para-ele zer ouro ao-redor
\v 25 ve-asita para-ele misgeret topach ao-redor ve'asita zer- zahav misgeret ao-redor
\v 26 e-farás para-ele quatro taba'ot ouro ve'nata'ta a sobre sobre quatro hafe'ot que para quatro de-seus-pés
\v 27 conforme a misteriosa serão as plantas para quartos separadamente levando a a mesa
\v 28 e-farás a הַבַּדִּים֙ madeiras-de שִׁיטִים eles ouro ouro וְנִשְׂאָה־ neles a a mesa
\v 29 ve-asita קְעָרֹתָיו וְכַפֹּתָיו וּקְשׂוֹתָיו֙ וּמְנַקִּיֹּתָ֔יו que יֻסַּךְ בָּהֵן ouro puro farás eles
\v 30 e eu dar-te-ei sobre pão pão-de face ante-mi sempre
\v 31 e-farás lampada- ouro puro candelabrum- -fiet a-lampada -suas-mamas -et-e-sua-cana -suas-copas -suas-bacias -e-suas-floradas de-a-ela ser-ão
\v 32 e-seis קָנִים יֹצְאִים מִצִּדֶּהָ שְׁלֹשָׁה קְנֵי מְנֹרָה מִצִּדָּהּ הָאֶחָד o-primeiro קְנֵי מְנֹרָה de-lá-dela o-segundo
\v 33 três gevú-'im mash-qú-kadím baq-qué-né o-primeiro kap-tór va-perákh e-três gevú-im mash-qú-kadím baq-qué-né o-primeiro kap-tór e-fo-rach assim seis as quinas que saem de a manora:
\v 34 e na manora quatro copos enfileirados suas bordas e suas flores:
\v 35 e a cipreste debaixo segundo das vimeiras deles e a cipreste debaixo segundo das vimeiras de-a e a cipreste debajo de segundo das vimeiras מִמֶּנָּה seis as quinas que saem de a manora:
\v 36 suas têmporas e seus canos de ela sejam toda de jardim uma ouro puro
\v 37 e-farás a suas velas sete e levou a luzes-deiha e iluminasse sobre Éber suas-faces:
\v 38 e-suas-mãos e-seus-pés ouro puro
\v 39 como-circunferência ouro puro fará ela a todo os-vasos as estas
\v 40 e-veja e-faça segundo-suas-estranhamentos que tu aspecto na-montanha
\c 26
\p
\v 1 e-a a-arca vós-fará dez tapumes seis משזער וּתְכֵ֤לֶת וארגמן וְתֹלַ֣עַת segundo כְּרֻבִ֛ים obra-de חֹשֵׁ֖ב eles a-eles
\v 2 אֹ֣רֶךְ הַיְרִיעָ֣ה הָֽאַחַ֗ת oito e-vinte na-côvado וְרֹ֙חַב֙ quatro בָּאַמָּ֔ה a cortina a-uma medida uma uma as cortinas；
\v 3 cinco as cortinas traves mulher a sua irmã； e-cinco cortinas traves mulher a sua irmã；
\v 4 e farás； tules azul sobre שַׂפַּת הַיְרִיעָה a-uma de-acéu- בְּחֹבָרֶת וְכֵן תַּעֲשֶׂה בְּשַׂפַּת הַיְרִיעָה הַקִּיצוֹנָה בְּמַחְבֶּרֶת הַשֵׁנִֽית׃
\v 5 cinquenta luláoth farás na veste a primeira e cinquenta luláoth farás em-extremidade a veste que na fita a-segunda מַקְבִּילֹת֙ הַלֻּ֣לָאֹ֔ת mulher a אֲחֹתָֽהּ׃
\v 6 e farás cinquenta קַרְסֵ֣י ouro וְחִבַּרְתָּ֨ a as-telas mulher a אֲחֹתָהּ֙ בַּקְּרָסִ֔ים um o-tabernáculo um
\v 7 וְעָשִׂ֙יתָ֙ yeru'ot ez'im le-ohel sobre ham-mishkan ashtei- doze eles farás a-eles
\v 8 orek — hayeru'ah ha-achat sheloshim — na-côvado ve-rochav quatro בָּאַמָּ֔ה הַיְרִיעָ֖ה a-uma medida uma uma dez יְרִיעֹֽת׃
\v 9 וְחִבַּרְתָּ֞ a cinco הַיְרִיעֹת֙ sozinho e-a seis הַיְרִיעֹ֖ת sozinho וְכָפַלְתָּ֙ a face-de הַשִּׁשִּׁ֔ית a de-frente face-de o-tenda
\v 10 e farás； cinquenta luláoth sobre שַׂפַּת הַיְרִיעָה a-uma הַקִּיצֹנָה בְּחֹבָרֶת e cinquenta luláoth sobre língua הַיְרִיעָה הַחֹבֶ֖רֶת הַשֵׁנִֽית׃
\v 11 ve'asitā קַרְסֵי bronze cinquenta וְהֵבֵאתָ֤ a הַקְּרָסִים֙ בַּלֻּ֣לָאֹ֔ת וְחִבַּרְתָּ֥ a um e-acontecerá um
\v 12 וְסֶ֙רַח֙ הָעֹדֵ֔ף בִּירִיעֹ֖ת haohel חֲצִ֤י הַיְרִיעָה a-odéfet tisrákh sobre achóre o-tabernáculo
\v 13 ve-ha-amá deste ve-ha-amá de-este ba-odéf be-órekh yeru'ot haohel será sarúakh sobre tsidvé o-tabernáculo mizze e deste para cobri-lo;
\v 14 e-farás cobertura ao tenda peles oliveiras vermelhos e-tampa peles tachashim de-acima
\v 15 e-farás a as divisões para o santuário de troncos de carmelitas que se levantam
\v 16 dez côvados comprimento o kares e amah וַחֲצִ֣י a amah largura o kares o-primeiro
\v 17 duas jotas para o kares o-primeiro mesolabot mulher a sua irmã； assim a-todo para-todo karies o-tabernáculo
\v 18 e-farás a as divisões para o santuário vinte carruagem para-a-lado norte sudeste;
\v 19 e-quarenta as-carruagens prata debaixo sob vinte o kares segundo carruagens o-primeiro a-carruagem o-primeiro para-duas-de as suas mãos e-dois o-primeiro debaixo-de o kares o-único para as duas as suas mãos
\v 20 e para o lado o-tabernáculo a-segunda para a borda do-norte vinte carvalho
\v 21 e-quarenta seus senhores prata segundo senhores debaixo o keresh o-primeiro e-dois adanim debaixo o keresh o-primeiro
\v 22 e as yarkei o-tabernáculo para-o-mar vós-fará seis kareishim
\v 23 e-dois-de kareishim farás para espinhos ham-mishkan nas yarkei
\v 24 e serão תֹֽאֲמִים֮ מִלְּמַטָּה֒ וְיַחְדָּ֗ו serao תַמִּים֙ sobre cabeça-sua a הַטַּבַּ֖עַת será assim será לִשְׁנֵיהֶ֔ם para-dois הַמִּקְצֹעֹ֖ת ser-ão
\v 25 e-sejam oito קְרָשִׁ֔ים וְאַדְנֵיהֶ֣ם prata seis dez אֲדָנִ֑ים segundo אדנים debaixo הַקֶּ֣רֶשׁ o-primeiro e-dois אדנים debaixo הַקֶּ֥רֶשׁ o-primeiro
\v 26 e-farás [בְרִיחִ֖ם] madeiras-de acácia [חֲמִשָּׁ֕ה] [לְקַרְשֵׁ֥י] [צֶֽלַע־הַמִּשְׁכָּ֖ן] o-primeiro
\v 27 e-cinco בְרִיחִ֔ם לְקַרְשֵׁ֥י canela- o-tabernáculo a-segunda e-cinco nos-ferraduras para-creshe- canela o-tabernáculo para-as-jarcas- para-o-mar
\v 28 e-briqah- o-tikhon- no-meio-de os-karashim- em-briqah- de o-ketzeh- a o extremo:
\v 29 e-a as divisões ouro ouro e-a ouro farás ouro casarim para os bordados ouro a os bordados ouro
\v 30 e estabelecerás a ham-mishkan como juízo dele que vê na-montanha
\v 31 e-farás faraóque tchelãz e-púrpura e-carmesim segundo e-seis מָשָׁזַר obra-de חֹשֵׂב ele-fará a-ela כּוּרְבִים׃
\v 32 e-darás אֹתָהּ sobre אַרְבַּעָה֙ colunas-de שִׁיטִים ouro ouro ouro ouro sobre quatro אַדְנֵי־ prata:
\v 33 e-darás a debaixo em-lugar-de הַקּרָסִים֒ וְהֵבֵאתָ֥ lá-baixo de-casa-de לַפָֹּרֹכֶת a arca o-testemunho וְהִבְדִּילָ֤ה a-vós entre entre e-entre e-entre santidade-de os-santos
\v 34 ve'nata'ta a sobre sobre arca a testemunha no-sagrado os-santos
\v 35 e colocaste a o shulḥan de-fora perante o parokhet e-a a menorá sobre o shulḥan sobre canto o-tabernáculo para o timna' e o shulḥan põe sobre canto צָפֽוֹן׃
\v 36 e-farás כַּפֶּר para-a-entrada-de a-tenda תכלת e-púrpura e-carmesim segundo e-seis משזר obra-de ROOM:
\v 37 e-farás לכפר cinco colunas-de שִׁיטִים וְצִפִּיתָ֤ eles ouro ויהם ouro ויצקת a-eles חמישה Adonai bronze
\c 27
\p
\v 1 e-farás a o-altar árvores-de acácia cinco אמות comprimento-o והמשה côvados largura-o será yihye o altar e três côvados sua altura
\v 2 e-farás suas cornetas sobre quatro suas pontas nós serão suas cornetas וְצִפִּיתָ֥ ele bronze
\v 3 e-farás suas chamas para alimentá-lo e seus óleos e suas vasilhas e seus vasos e as suas cavas para-todo כְּלֵיָיו farás bronze
\v 4 e-farás para-ele de-machbar obra-de rede bronze e-farás sobre da-rede quatro טַבְּעֹ֣ת sobre sobre quatro os-seus-filhos-
\v 5 e-darás aquela debaixo o-altar de-malate e-foi da-rede até até o-altar
\v 6 e-farás de-cápsulas למזבח em-cápsulas árvores-de acácia וְצִפִּיתָ֥ eles bronze
\v 7 e vindo a varas-de-ela e-sejam e-serão os abdins sobre duas costelas ele em-se ele
\v 8 nabub luchot farás ele como a-rea a-teca na-montanha assim façam
\v 9 e farás a átrio-de ham-mishkan para-a NEGUE- TIYMANAH KLAEIM LECHATSER seis משזער cem BAAMAH comprimento LAFEH HA'ECHAT:
\v 10 e-seus-pilares vinte VE'ADNEIM ESREIM bronze e-ganchos-de HA'AMMUDIM e-seus-órgãos-reprodutivos כַּסֶּפֶת׃
\v 11 e-assim -lado-esquerdo -norte -no-lado-direito -costelas cem comprimento -vinte -e-seus-órgãos-genitais -vinte bronze e-ganchos-de os-pilares e-seus-órgãos-reprodutivos כַּסֶּפֶת׃
\v 12 e largura o-pateo às laterais de mar cortinas cinquenta jardim e suas colunas dez e seus enredados dez
\v 13 e-largura o-pátio às laterais de leste oeste cinquenta jardim; jardim:
\v 14 וַחֲמֵ֨שׁ doze אַמָּ֛ה קְלָעִ֖ים לַכָּתֵ֑ף עַמֻּדֵיהֶ֣ם שְׁלֹשָׁ֔ה וְאַדְנֵיהֶ֖ם três
\v 15 וְלַכָּתֵף֙ הַשֵּׁנִ֔ית cinco dez קְלָעִ֑ים os seus pilares três e suas cortinas três
\v 16 e ao portão o-haçatsér cobertura vinte côvado túrgida argila vermelho segundo e-seis verde obra-de azul os seus pilares quatro quatro quatro
\v 17 todo pilares o pátio ao-redor forrados prata e neles prata e as suas bases bronze
\v 18 comprimento o pátio cem de um côvado e a largura de cinquenta cinquenta e levante-se cinco côvados seis mancebo e seus anciãos bronze
\v 19 a-todo utensílios-de o-tabernáculo em-todo sua servidão e-todo suas testemunhas e-todo testemunhem o recinto bronze
\v 20 e-tu ordene a filhos-de Israel e tomem eleicha óleo oliveira zāḵ kāṯı̂ṯ lammāʾōr lehaʿalōṯ neṛ sempre
\v 21 em-tenda-de moʾēḏ de-fora lappārōḵeṯ que sobre hāʿedūṯ ele ʾothō Aarao e-filhos-dele meʿereḇ até yhwh diante-de eternidade estatuto-de eterno para-generaçőes-elas de-com filhos-de Israel
\c 28
\p
\v 1 e-tu que-approxime-se a-te a Aarao seu-irmão e-a filhos-seus de-mais filhos-de Israel para-sacerdote-o a-mim arão nadav e-abiahu Eleazar e-itamar filhos-de Aharon
\v 2 e-farás roupas-o santidade para-arão seu-irmão para-honra e-beleza:
\v 3 e-tu fale a todo sabedoria- espírito que plenitude-dele espírito sabedoria e-façam a vestes- Aarao para-santificação para-sacerdócio- a-mim
\v 4 ve-Eleh os vestuários que façam choshen e ephod e m'ail e k'tonet tashbets m'znefet e 'abnet וְעָשׂ֨וּ vestuários- קדוש para-Aaron אחיך e-para-seus-filhos לכהנו- a-mim
\v 5 [וְהֵם֙] [יִקְח֣וּ] a [וְאֶת־הַתְּכֵ֖לֶת] e-[OBJ] [וְאֶת־תּוֹלַ֥עַת] e-[OBJ] [וְאֶת־הַשֵּֽׁשׁ׃] e-[OBJ] e-[OBJ]
\v 6 ועשוּ a ouro זהב תכלת וargaman תולעת segundo e-seis משzar obra-de choshev
\v 7 שתים as-ombreiras חבורות sera לו a segundo קצואיו e-chur:
\v 8 e-heshév apuddáto que sobre-ele kém-áshehu nós será ouro tékhelet e-púrpura e-carmesim segundo e-seis máshazar:
\v 9 e-lakachtá a shtéi pedras-de shoham e-pitachtá sobre-eles שֵׁמֹות filhos-de Israel
\v 10 seis מִשְׁמֹתָם sobre a-pedra a-uma e-a שֵׁמֹות הַשִּשָּה הַנּוֹתָרִים sobre הָאֵבֶן a-segunda כּוֹתְלֹדְתֵיהֶם׃
\v 11 obra-de [חָרַשׁ֮] pedra [פִּתּוּחֵ֣י] [חֹתָ֗ם] [תְּפַתַּח֙] a duas [עַל־שְׁמֹ֖ת] sobre [יִשְׂרָאֵ֑ל] filhos-de Israel ouro [תַּעֲשֶׂ֥ה] eles
\v 12 וְשַׂמְתָּ a duas sobre sobre כִּתְפֹת הָאֵפֹד pedras-de זִכָּרוֹן aos-filhos-de Israel וְנָשָׂא Aarao a yhwh diante-de yhwh sobre duas-de כְּתֵפָיו para lembrança:
\v 13 e-farás [מִשְׁבְּצֹ֖ת] ouro
\v 14 e-duas de-shársharót ouro puro [מִגְבָּלֹ֛ת] farás eles obra-de ábôt e-teráhatá a de-shársharót as-abót sobre [sem-traducao]
\v 15 e farás chóshén מִשְׁפָּט֙ obra-de חֹשֵׁ֔ב כְּמַעֲשֵׂ֥ה אֵפֹ֖ד תַּעֲשֶׂ֑נּוּ ouro תְּכֵ֨לֶת וְאַרְגָּמָ֜ן וְתוֹלַ֧עַת segundo e-seis מָשְׁזָ֖ר farás ele
\v 16 רָב֥וּעַ será כָּפ֑וּל זֶ֥רֶת seu-comprimento וְזֶ֥רֶת רָחְבּֽוֹ׃
\v 17 וּמִלֵּאתָ֥ nele מִלֻּ֣אַת pedra quatro טוּרִ֣ים pedra ט֗וּר homem פִּטְדָה֙ וּבָרֶ֔קֶת הַטּוּר o-primeiro
\v 18 וְהַטּ֖וּר o-segundo נֹ֥פֶךְ סַפִּ֖יר וְיָהֲלֹֽם׃
\v 19 וְהַטּ֖וּר o terceiro לֶ֥שֶׁם שְׁב֖וֹ וְאַחְלָֽמָה׃
\v 20 וְהַטּוּר֙ o-quarto תַּרְשִׁ֥ישׁ וְשֹׁ֖הַם וְיָשְׁפֵ֑ה מְשֻׁבָּצִ֥ים ouro serão בְּמִלּוּאֹתָֽם׃
\v 21 וְ֠הָאֲבָנִים תִּֽהְיֶ֜ינתּ sobre שְׁמֹ֧ות filhos-de Israel dois dez sobre שְׁמֹתָ֑ם פִּתּוּחֵ֤י חֹתָם homem sobre seu-nome seja-ela para-dois dez שָֽׁבֶט׃
\v 22 וְעָשִׂ֧יתָ sobre o-bolsa-de-terrazinhos [גַּבְלֻ֖ת] gabelut obra-de ouro ouro puro
\v 23 וְעָשִׂ֙יתָ֙ sobre o choshen shtéi ouro ouro ve-natattaa- a dois-de ha-tabbawot sobre segundo pontas o choshen
\v 24 e dará a dois-de o-ouro o-ouro sobre duas as plantas a cortos o choshen
\v 25 e-a duas cortos duas as ondas darás sobre duas os mizbóts e dará sobre כּ-תְּפֹת ה-אֵפֹד a מ-וּל faces-suas
\v 26 [וְעָשִׂ֗יתָ] [שְׁתֵּי֙] [טַבְּע֣וֹת] ouro [וְשַׂמְתָּ֣] eles sobre segundo [הַחֹ֑שֶׁן] [עַל־שְׂפָת֕וֹ] sobre [אֶל־עֵ֥בֶר] que a
\v 27 וְעָשִַׂיתָ֮ duas טַבְּע֣וֹת ouro e-darás eles sobre שְׁתֵּי֩ כִתְפ֨וֹת הָאֵפ֤וֹד מִלְּמַ֙טָּה֙ מִמּ֣וּל rosto-dele como מֶחְבַּרְתּ֑וֹ מִמַּ֕עַל לְחֵ֖שֶׁב הָאֵפֽוֹד׃
\v 28 e se firmarão a o choshen a tavuot a efdod em fital tecelagem-azul ser sobre chesheb a efdod e-não de-cima-de o choshen de-sobre a efdod:
\v 29 e levantou Aharon a nomes filhos-de Israel no-bexen a-mispat sobre para-seu-coração em-vir-seu a a-santidade para-lembrança diante-de yhwh sempre
\v 30 e deu-a a bexen a-mispat a e-sejam e-a os-tumim וְהָיוּ֙ sobre yhwh Arão בְּבוֹא֖וֹ diante-de yhwh e levantou Aharon yhwh juízo filhos-de Israel sobre seu-lábbo diante-de yhwh sempre
\v 31 ve'asitā a mí-ail há-efód klíl תְּכֵלֶת׃
\v 32 e-será pí- cabeça-sua bétokhów será yihye líféwy sáviv obra-de órég כפי תחרא não a-ele não יתקרע׃
\v 33 e-farás sobre שולהיו רימוני תכלת וארגמן ותולעת segundo sobre שולהיו ouro ופעמןiei zahav no-entre-vocês ao-redor
\v 34 [פַּעֲמֹ֤ן] ouro [וְרִמּ֔וֹן] [פּֽ͏ַעֲמֹ֥ן] ouro [וְרִמּ֑וֹן] sobre [הַמְּעִ֖יל] [סָבִֽיב]
\v 35 e-será sobre Aarao לְשָׁרֵ֑ת וְנִשְׁמַ֣ע ק֠וֹלוֹ בְּבֹא֨וֹ a yhwh diante-de yhwh וּבְצֵאת֖וֹ e-não não
\v 36 e-farás צִּ֖יץ ouro puro e abraque sobre-ele פִּתּוּחֵ֣י חתם santidade a-yhwh
\v 37 [וְשַׂמְתָּ֤] ele sobre [תְּכֵ֔לֶת] [וְהָיָ֖ה] [עַל־הַמִּצְנָ֑פֶת] sobre [פְּנֵֽי־הַמִּצְנֶ֖פֶת] será
\v 38 e-será-que sobre מֵצַח Aharon- וְנָשָׂא Arão a iniquidade os-santos que יַקְדִּישׁוּ filhos-de Israel para-todo מתנות seu-sagrados e-será a-eles fronte-sua yhwh para-alegria a-eles diante-de yhwh
\v 39 e-tocaste a-camisa seis e-tu-farás cabeça-cobrindo seis e-tingido vós-fará obra-de tiraste:
\v 40 e-por-filhos Arão farás manto-sua e-farás a-eles אבנטים ומגבעות farás a-eles לכבוד לתיפארת
\v 41 והילבשת eles a Aarão irmão-teu e-a seus-filhos eles ומשחת -os -Identifier eles ידם WKידשת eles WKחnano a-mim
\v 42 e faça a-eles de entradas- bada para cobrir de-carne nudez de coxas- e-até coxas ser-ão
\v 43 e-sejam sobre Aarao e-sobre -seus-filhos em entrá-los a tenda מוֹעֵ֗ד ou na coito-los a o-altar para servir no santuário e-não eternidade a-ele va-metu chuq-at a-ele para-ele e para semente dele atrás-dele
\c 29
\p
\v 1 e isto a palavra que a-eles a-eles eles eles para sacerdote a-mim tomou um um filho-de manhã e olivos dois temimim-
\v 2 e pão de-maçãs e biscoitos não-fermentados misturados com-o óleo e biscoitos-de não-fermentados ungidas -com-óleo farinha-fina trigo farás eles
\v 3 e-tu-porás a-eles sobre um um eles eles no cesto e- הפר e-a segundo ha-eilim-
\v 4 e-a אַהֲרֹן e-a filhos-dele תַּקְרִ֔יב a entrada eles reunião וְרָחַצְתָּ֥ eles com-a-água
\v 5 [וְלָקַחְתָּ֣] a [וְהִלְבַּשְׁתָּ֤] [אֶֽת־אַהֲרֹן֙] a e-[OBJ] a [הָאֵפֹ֔ד] e-[OBJ] [וְאֶת־הַחֹ֑שֶׁן] [וְאָפַדְתָּ֣] a-ele [בְּחֵ֖שֶׁב] e-[OBJ]
\v 6 e-tu-colocarás הַמִּצְנֶ֖פֶת sobre sua-cabeça וְנָתַתָּ֛ a diadema eles sobre הַמִּצְנָֽפֶת׃
\v 7 e-tomarás a óleo o-mishcha וְיָצַקְתָּ֖ sobre ele וּמָשַׁחְתָּ֖ ele
\v 8 e-a seus-filhos תַּקְרִ֑יב vehilbashtam כֻּתֳּנֹֽת׃
\v 9 וְחָגַרְתָּ֩ eles אַבְנֵ֜ט Aarão e-seus-filhos וְחָבַשְׁתָּ֤ a-eles migbaot e-será a-eles כְּהֻנָּ֖ה para a lei eternidade וּמִלֵּאתָ֥ יֽ͏ַד־ Aarao não seus filhos:
\v 10 וְהִקְרַבְתָּ֙ a הפר diante-de tenda reunião וְסָמַ֨ךְ Aarao e-filhos-dele a maos-deles sobre cabeça הַפָּֽר׃
\v 11 וְשָׁחַטְתָּ֥ a o-touro yhwh yhwh entrada tenda encontro
\v 12 e-tomarás de-sangue-de הפר e dará sobre cornos o-altar em-teus-azymes e-a todo do-sangue tu-serrarás a base o-altar
\v 13 e tomarás a todo o-chalev a-que-cobre a o-qerev e-a o-lóbulo sobre o-fígado e-את duas os-rins e-a o-gordura que neles e oferecerás o-altar-para
\v 14 e-a carne o-touro e-a seu-oro e-a ele-estendeu tu-queimarás no-fogo ele para-o-lager pecado ela
\v 15 e-a o-primeiro o-único to-peça e-sustentem Aarao e-filhos-dele a maos-deles sobre cabeça o-abelhaue
\v 16 e-masacrarem a o-velho e-tomarás a seu-sangue e-jetastes sobre ele ao-redor
\v 17 e- o-abelhaue despedaçaste para-seus-nicotamentos e-lavaste sua-fenda e-sus-pés e-dar-tei-a sobre as-águas e-sobre cabeça-dele
\v 18 e-oferecereis-o a todo o-velo ele holocausto ele para-יהוה aroma um-cheiro ele a-yhwh ela
\v 19 e-tomareis-o a o-touro o-segundo e-sustentareis-o Aarao e-filhos-dele a maos-deles sobre cabeça o-abelhaue
\v 20 e-imirareis-o a o-velo e tomaste de-sua-mão e deste sobre formado orelha Arão e-sobre formado orelha filhos-dele a-direita e-sobre neles yadam a-direita e-sobre bohen de-seus-pés a-direita e lançaste a o-sangue sobre ele ao-redor
\v 21 e tomaste de o-sangue que sobre o Mizbach e o shemen o mashachah e zita sobre Arão e-sobre as-roupas-seu e-sobre ele e-sobre de-roupas filhos-dele com-ele e kodesh que e os begadav e-filhos-dele e os bigdei filhos-dele com-ele
\v 22 וְלָקַחְתָּ de o ayil a-gordura e ha-aliyah e-a o chalbe a-que-cobre a o keruv e-a yoteret do-fígado e-את duas ha-klayot e-a que sobre-eles e-a coxa que porque eil ele ela
\v 23 ve-ikkar pão uma va-hallat pão shemen uma ve-rakik um mis-sal ha-matzot que diante-de yhwh
\v 24 vesamta o todo sobre mãos-de Arão e-sobre mãos-de seus-filhos e enfarinharás eles oferta-elevação diante-de yhwh
\v 25 e tomarás eles imediatamente deles e oferecerás em fumaça o-altar sobre o-holocausto por odor cheiro agradável yhwh yhwh ele ele para-יהוה
\v 26 וְלָקַחְתָּ a este vislumbre do carneiro o cheio que para Arão ele ele oferta-elevação yhwh yhwh a-ti a-ti para-ele
\v 27 e santificaste com vista da-oferta e-את coxa הַתְּרוּמָ֔ה que e levantaste e-que e ergueste do elefante que estava cheio do-que para-Aarão e de suas filhas
\v 28 e-será para-Aarão e suas filhas por-tempo para sempre de-com filhos-de que porque ele ele será for me'et filhos-de Israel Mizbe'achay Shalmeim Tummatam para-יהוה
\v 29 uvgadi a-santidade que leAharon serao levanay atrás-dele lemashchah em-elas ulamel neles a yadam
\v 30 sete dias yilbasham o-sacerdote em-lugar-dele dos seus que virá a tenda encontro para servir no santuário:
\v 31 e-a o carneiro que está cheio pegará e cozinhará a a-carne-dele em algum lugar santo
\v 32 e-coma אַהֲרֹן e-filhos-dele a de-carne o-abelhaue e-a o pão que בַּסָּ֑ל entrada tenda encontro
\v 33 וְאָכְל֤וּ eles que כֻּפַּ֣ר neles לְמַלֵּ֥א a mão-deles eles a-eles וְזָ֥ר não eles porque santidade-de eles
\v 34 וְֽאִם־ יִוָּתֵ֞ר מִבְּשַׂ֧ר הַמִּלֻּאִ֛ים e-de הַלֶּ֖חֶם até הַבָּקֵ֑ר não a o-restante ele não será comido porque santidade-de ela
\v 35 e farás para Arão e-para-seus-filhos assim conforme-tudo que ordenei isto sete dias preencherá suas mãos:
\v 36 e um carneiro de oferta de reconciliação farás para o dia sobre as-cuprires e-acharites-a sobre o altar em-te-cuprires ele e-ungires a-ele para-santificá-lo-verso-final
\v 37 sete dias cuprires-te sobre o altar ele a-ele e-será o-altar santo-de santos todo da-pessoa-que-tocou no-mizbeach ele-será-santificado
\v 38 e-este que vós-fará sobre o-altar cordeiros filhos-de ano dois para-o-dia sempre
\v 39 a o-primeiro o-um farás no-manha e-את o carneiro o-segundo entre entre os-pardais
\v 40 e a décima farinha-de-trigo moído em óleo de cevada quarto deste vinho ve-nesech reviit הַהִ֖ין vinho לכּבשׂ o-primeiro
\v 41 e-את o carneiro o-segundo vós-fará entre הָעַרְבָּ֑יִם כמנחת הבקר ukhniskah fazer- para-a para-aroma agradavel mulher para-יהוה
\v 42 holocausto-de contínuo para-gerações-vossas porta tenda-de encontro yhwh yhwh que a-vós a-vós ali de-falar a-ti nome
\v 43 e-congregar-ei-me para lá aos-filhos-de Israel e-santificar-se-há-de com-a-minha-glória-versículo-final
\v 44 e-santificar-ei-me a tenda encontro e-a o-altar e-a Aarao e-a ele eu-santificarei para-servir a-mim
\v 45 e-habitar-ei-me no-meio-de filhos-de Israel e-eu-serei a-eles para-Elohim
\v 46 e-conhecerão que eu yhwh אֱלֹ֣הֵיהֶ֔ם que saí-ei eles da-terra-de Egito para-a-sua-habitação בְתוֹכָ֑ם eu yhwh אֱלֹהֵיהֶם-de-eles
\c 30
\p
\v 1 e-farás altar de-o-fumaceiro fumo-de-oferenda de troncos de carmelitas farás ele
\v 2 cubit-o o-seu-comprimento e um palmo a-sua-largura quadrado será e-duas-coudernas a-sua-altura nós os-seus-chifres
\v 3 e-cobri-e ele ouro טהור a [וְאֶת־קִירֹתָ֛יו] e-a [וְאֶת־קַרְנֹתָ֑יו] ao-redor para-ele suas cornetas ouro לו זֵ֥ר ouro ao-redor
\v 4 [וּשְׁתֵּי֩] [טַבְּעֹ֨ת] ouro tu-farás [׀] debaixo-de para-seu-fio sobre duas [צַלְעֹתָ֔יו] vós-fará sobre segundo [וְהָיָה֙] e-foi para quartos separadamente ele ele animal
\v 5 e-farás a [עֲצֵ֣י] árvores-de acácia eles ouro
\v 6 וְנָתַתָּ֤ ele diante-de o-véu que sobre arão a testemunha diante-de a propiciação que sobre a testemunho a-ti אִוָּעֵ֥ד a-ti ali
\v 7 e-ele-queimou sobre-ele Aarao fumo [סַמִּ֑ים] ba-voker na-manhã em-ben-a-o a as-luzes queimará-as
\v 8 e-em-oferendas-de-ascensão Aarao a entre entre as-vésperas queimará-as fumegante permanente yhwh yhwh para-gerações-de-vocês
\v 9 não subireis sobre-ele fumegante זרעה e-oferta e-minchah não não tiss-khu sobre-ele
\v 10 ve-chipp-er Arão sobre uma uma בשנה mid-dam chéttā'ath uma uma b-shana ye-chapp-per sobre-ele para-gerações-vossas ele qo-da-shim ele para-יהוה
\v 11 e-falou yhwh a Moisés
\v 12 que tis-sa a cabeça ben-ei- Israel li-pqu-dey-hem ve-nath-no homem koper nafsho eles bifqod a-eles e-não será eles negef bifqod eles
\v 13 este yittenu todo haover sobre os-contados machatzit hashqelet em-siclo a-santidade vinte gerah hashqelet מחצית o-sheqel dádiva-feminina-singular la-yhwh:
\v 14 todo o-que-passa sobre os-contados מִבֶּ֛ן vinte ano e-para-cima irá dar yhwh yhwh
\v 15 o-rico não aumentará não não diminuirá de-meio o-sheqel לָתֵת֙ yhwh oferta-de yhwh para-ter-expiação sobre almas-vosso
\v 16 e tomaste a prata [מֵאֵת֙] de-com filhos-de Israel ele a-ele sobre avodat tenda reunião e-será para-os-filhos-de Israel yhwh diante-de yhwh para-ter-expiação sobre almas-vosso
\v 17 e-falou yhwh a Moisés
\v 18 e farás [כִּיּ֥וֹר] de-cobre e-seu-copo bronze para-lavar-a-si-mesmo e-colocarás ele entre tenda-de e-entre e-entre o altar e-dar-tei-a para lá águas
\v 19 e-lavaram Aarão e-seus-filhos nós a maos-deles e-a seus-pés
\v 20 em-a-sua-entrada a tenda encontro lavarão-se águas e-não morrerão ou na coito-los a o-altar para-servir para-queimar mulher para-יהוה
\v 21 e-lavaram mãos-deles e-pés-deles e-não morrem e-será a-eles lei- a-ele a-ele e-para-seu-descendente para-gerações-eles
\v 22 e-falou yhwh a Moisés
\v 23 e-tu toma para-vós com-perfumes cabeça amar-doce- liberdade cinco centenas e-cinzento- báscem machtítuho cinquenta e duzentos ve-qnéhe- bośém cinquenta e-duzentos
\v 24 ve-kiddáh cinco centenas em-siclo a-santidade ve-shémen oliveira hin:
\v 25 e-farás ele shémén mishchat- santidade roqách de-a-mistura obra-de misturador שֶֽׁמֶן será santidade será
\v 26 e-un-ganhou nele a tenda de-encontro e-a arca ha-edut:
\v 27 e-a o shulḥan e-a todo utensílios-dele e-a a-de-a-luz e-a os-seus-vesséis e-a yhwh haqtōret
\v 28 e-a altar-de a-holocausto e-a todo seu recipiente e-a o-de-o-recipientedeágua e-a como-ele
\v 29 e-santificaste eles e-sejam santo-de os-santos todo da-pessoa-que-tocou neles ele-será-santificado
\v 30 e-a Aarão e-a seus-filhos eles WKידשת eles para-o-servir a-mim
\v 31 e-a filhos-de Israel dizendo dizendo óleo será santo será este yhwh para-gerações-de-vocês
\v 32 sobre homem não não ser ungido não não fareis como ele ele ele será a-vós a-vós
\v 33 homem que fará perfume como ele e-que ele-dará nós sobre זָ֑ר e será cortado do seu povo
\v 34 E-disse yhwh a Moisés toma a-ti perfume derramará e escarlate e-oleo-de-gomasilvestre aromaticos e-olibanum sozinho de-algodao será será
\v 35 e-farás a-ela Ketoret galanga obra-de que-faz-galanga salgado puro קֹדֶשׁ׃
\v 36 e-esmagueste de-ela hadeq- e-natahtah diante-de ha-edut- em-tenda-de encontro que אִוָּעֵ֥ד a-ti a-ti santidade-de santíssimos será a-vós
\v 37 ve-ha-qtor-et- que farás be-matkhun-tahh- não fareis a-vós קֹ֛דֶשׁ será a-ti a-yhwh
\v 38 homem que ele-fará kamo-ha- le-harikh- nela ve-nikhrat- me-am-maw-yo-
\c 31
\p
\v 1 e-falou yhwh a Moisés
\v 2 viu qara-ti em-o-nome de-Betsalel filho-de Uri filho-de Hur para-matate Judá
\v 3 e-e-preeenchi ele espírito Elohim com-a-sabedoria e-com-a-entendimento e-com-o-conhecimento e-em-todo obra
\v 4 para-pensar pensamentos para-fazer em-o-ouro e-no-prata e-no-cobre
\v 5 e-no-estanho pedra para-encher [וּבַחֲרֹ֣שֶׁת] árvore para-fazer em-todo obra
\v 6 e-eu eis dei com-ele a Ahiliv filho-de Achisamac Para-a-margem- Dã dei todo sabio coração dei sabedoria e-fazerão a todo que mandei-vos
\v 7 com tenda מוֹעֵ֗ד e-a o-arca para-a-testemunha e-a a-da-cobertura que sobre-ele e-a todo instrumentos-de o-tenda
\v 8 e-a o shulḥan e-a utensílios-dele e-a a-do-luz [מִזְבַּ֥ח] e-a todo seus-vessis e-a yhwh haqtōret
\v 9 e-a altar-de a-holocausto e-a todo seu recipiente e-a o-do-lavabo e-a e-o
\v 10 e-a das-roupas a-da-guarda e-a roupas-de a-santidade para-arão o-sacerdote e-a de-roupas filhos-dele para-servir-como-sacerdote
\v 11 e-a óleo [הַמִּשְׁחָ֛ה] e-a fumo-de das-essências para-o-santo conforme-tudo que mandei-te-eu façam
\v 12 E-disse yhwh a Moisés
\v 13 e-tu palavra a filhos-de dizendo dizendo somente a que תִּשְׁמֹ֑רוּ ela sinal ela-é entre-mim para-conhecer que para-conhecer yhwh eu yhwh מְקַדֵּשְׁכֶֽם׃
\v 14 e-guardardes a que porque ela a-vós a-vós morrendo morte-de que porque todo obra nela obra aquela a-alma a-essa de-meio-de seus-povos
\v 15 seis-de dias será feito obra e-no-dia o-sétimo sábado dia-de-sábado santidade a-yhwh todo obra obra em-dia morrendo morrer será-morto
\v 16 e-guardarão filhos-de Israel a do sabbat para-fazer a eternidade para-gerações-eles yhwh eternidade
\v 17 entre-mim e-entre filhos-de Israel sinal-de ela para-sempre porque seis-de dias yhwh yhwh a os-céus e-a a-terra e-no-dia o-sétimo שַׁבָּת e-nafash
\v 18 E-colocou a Moisés כְּכַלֹּתוֹ֙ para-falar com-ele em-monte-de Sinai segundo tabelas a testemunha pedra pedra kethubhim com-dedo-de Elohim
\c 32
\p
\v 1 E-viu o-povo porque bosehesh Moisés לארדת de o-monte ve-yikkehel o-povo a-ele Arão e-disseram a-ele levanta-te aseh- a-nos Elohim que andem diante-de-nós porque este Moisés o-homem que não da-terra Egito a-ele yadonu a-ele foi a-ele
\v 2 E-disse para-eles Arão parqu nizmei o-ouro que em-orelhas-de neshechem benechem e-filhas-vossas e-trarão a-mim
\v 3 e-se-despiram todo o-povo o-ouro de-anéis o-de-ouro que em-suas-ouvidos e trouxeram- a Aharon
\v 4 E-tomou de-mãos-eles [וַיָּ֤צַר] ele com-a-gravura e-o-fez bezerro para-ídolo e-disseram Estas teu-Elohim Israel que elevaram-vos da-terra-de Egito
\v 5 E-viu Arão E-edificou altar diante-dele E-chamou Aharon E-disse festa-de a-yhwh amanhã
\v 6 e-levantaram-se de-amanhã e-subiram holocaustos e-aproximaram-se paz e-habitou o-povo para-comer וְשָׁת֔וֹ e-levantaram-se para-zombar
\v 7 e-falou yhwh a Moisés que Rede porque corrompeu o-povo-tuo que elevantes dizendo Egito
\v 8 desviaram-se rapidamente de o-caminho que tzivitim a-eles a-eles egel massakah וַיִּשְׁתַּֽחֲווּ־ a-ele Estas a-ele e-disseram estes teu-Elohim Israel que heolukha dizendo Egito
\v 9 E-disse yhwh a Moisés vi a o-povo este ele com qshe- costas ela
\v 10 e-agora hanikah a-mim veyichar- afpi neles vaakalem e-e-farei te para-povo grande
\v 11 e-e-curou-se Moisés a yhwh yhwh E-disse E-disse yhwh yhwh ele-será-ira teu-apo em-o-povo-tua que tu-e-saiu-te da-terra Egito com-a-força grande e-na-mão forte
\v 12 por-que dizem Egito dizendo em-o-mal e-saiu-os-eles para-a-exterminar eles nas-montanhas e-para-completá-los de-cima-de face-de a-terra volta de-a-ira nervo-teu e-perdoa sobre o-mal para-povo-teu
\v 13 macho para-Abram para-Isaque e-para-Israel servos-teus que juras-te a-eles sobre-ti e falou a-eles multiplicarei a semente-vosso como-os-estrelas os-céus e-todo a-terra a-esta que disse-ei- אֶתּוֹ para-sempre e-receberam para-sempre
\v 14 e-se-arrependeu yhwh sobre a-maldade que palavra para-fazer para-o-povo-suo
\v 15 e-virou e-ele-descerrou Moisés de o-monte e-dois as-tavas da-testemunho na-sua-mão as-tavas escritos de-os da-escrita-de-eles mizze eles eles escrevidos
\v 16 e-as-tábuas obra-de Elohim elas-eram e-o-machado escrita Elohim ele gravada sobre das-tábuas
\v 17 E-ouviu [יְהוֹשֻׁ֛עַ] a voz o-povo E-disse E-disse voz Moisés voz
\v 18 E-disse não-há voz anota gibura e-não-há voz anota halusha voz anana eu ouviu
\v 19 e-foi como karav a E-viu E-viu a ha-egele um-holot e-acendeu-se- tambem Moisés ve-yashleh a eles debaixo eles debaixo-de a-montanha
\v 20 E-tomou a ha-egele que fizeram e-queimou no-fogo até até que finos e-espargeu sobre face-de as-águas e-deu-de-beber a filhos-de Israel
\v 21 E-disse Moisés a Arão a-ti fez a-ti o-povo este porque levaste sobre-ele pecado grande
\v 22 E-disse Arão a certamente ira tu tu eu soube que o-povo ele com-mal ela
\v 23 e-disseram a-mim fazei- a-nos Elohim que irao diante-de-nós porque este Moisés o-homem que elevamos-nos da-terra não não sabemos a-ele foi a-ele
\v 24 וָאֹמַ֤ר a-eles para-quem ouro se-separaram e deram- a-mim e-eu-o-throwei em-a-chama e-ele-saiu o-bezerro a-esta
\v 25 E-viu Moisés a que porque ele ele porque Faraó Arão para-encontrar em-seus-lugares
\v 26 e-ele-estabeleceu Moisés no-porta o-acampamento E-disse quem a-yhwh a-mim e-eles-se-reuniram a-ele todo filhos-de Levi
\v 27 E-disse a-eles assim yhwh yhwh Elohim-de Israel שִׂ֥ימוּ homem-de sua-espada sobre em-seu-reto passai e-voltaram miša'ar a-o-portão no-acampamento e-matar-am homem-de a áhiy e-homem a E-a-terra e-homem a seu-próximo
\v 28 e-fizeram filhos-de Levi conforme-a-palavra-de Moisés [מִן־הָעָם֙] no-dia o-povo no-dia aquele em-três alfei homem
\v 29 E-disse Moisés מלאו mãos-vossas o-dia a-yhwh que homem com-seu-filho e-com-seu-irmão e-para-dar sobre-vós o-dia em-benção
\v 30 e-houve de-amanhã E-disse Moisés a o-povo vós pecado-vos pecado-a e-agora e-agora eu-elevar-ei a yhwh talvez eu-perdoarei por-causa-de pecado-vosso
\v 31 e-estabeleceu-se Moisés a yhwh E-disse por-favor pecou o-povo este pecado-a grande a-eles a-eles ouro ouro
\v 32 e-agora se levantaste pecado-vosso e-se não-há apaga-me por-favor de-teu-conto que escreveste
\v 33 E-disse yhwh a quem quem que pecou- a-mim eu-apagarei-o de-meu-conto
\v 34 e-agora vai esperaremos a o-povo a que para-ti eis eis meu-anjo irei diante-de-ti e-no-dia-de meu-exame e-eu-examinarei sobre-eles pecado-deles
\v 35 [וַיִּגֹּ֥ף] yhwh a sobre sobre que fizeram a o-bezerro que fez Aharon
\c 33
\p
\v 1 e-falou yhwh a Moisés folhas-de sobe tu tu e-o-povo que e-elevar-teste da-terra Egito a a-terra que juro-eu para-Abraão dizendo e-a-Jaōob dizendo para-o-semente-teu darei-eu
\v 2 e lançarei diante-de-ti anjo e-ele-expulsarei a o-cananeu o amorreu e-o-heteu e-o-perizeu o-hivi e-o-jebuseu
\v 3 a terra fluindo-de leite que não não subirei-eu que porque tu qsh- o-ref- tu para-que-não a-chel-kha- no-caminho
\v 4 E-ouviu o-povo a a-palavra o mal este va-yit-ab-balu- e-não shatu- homem e-dyo- sobre-ele
\v 5 E-disse yhwh a Moisés disse a filhos-de Israel um com qsh- o-ref- e-agora um e-eleh- be-qirv-kha- e-eu-te-cortarei e-agora fazer-descer em-tua-preciosidade me'al-eka וְאֵדְעָ֖ה que farei para-ti
\v 6 e-eles-se-espirraram filhos-de Israel a em-sua-preciosidade me-ha-mar Horov:
\v 7 e-Moshe tomará a a-tenda e-estenderá-se-a para-ele de-fora ao-acampamento o-longe de a-ele וְקָ֥רָא a-ele tenda reunião yhwh todo mevakesh yhwh ele sairá a tenda encontro que de-fora o-lager
\v 8 e-foi quando-sair Moisés a a-tenda e-levantar-se-ão todo o-povo e-parar-se-ão homem entrada-de אָהֳל֑וֹ e-ver-se-ão depois-de Moisés até quando-vir-ele a-tenda
\v 9 e-foi quando-entrar Moisés ha-ohelah descerá piléster o-nubloso e-permanecerá entrada-de haohel e falará com Moisés
\v 10 e-verá todo o-povo a piléster o-nuvem ficou-em-pé entrada-de haohel e-levantou-se todo o-povo e-adoraram homem porta a-tenda-dele
\v 11 e-falou yhwh a Moisés face a face como יְדַבֵּר homem a companheiro-seu וְשָׁב֙ a o-acampamento não Josué filho-de Nun o-jovem não יָמִ֖ישׁ de-meio o-tenda
\v 12 E-disse Moisés a yhwh tu você disse a-mim o-alto a o-povo não e-tu não me-ensinaste a que tens-lhe comigo e-tu dis-e-stu te-conheci no-nome e-também encontraste graça be-einai
\v 13 e-agora se por-favor achei graça nos-teus-olhos ensina-me por-favor a caminhos-teus e-conhecer-te-ei para encontre que em-olhos-teus e-ver porque o-povo-teu o-povo a-esta
\v 14 E-disse face-de andarão e-descansarei para-ti
\v 15 E-disse a-ele se não-há suas faces caminhando a subir-nos-eis deste-lado
\v 16 e-no-modo ser-conhecido então porque achei graça em-olhos-teus eu veamekha acaso-nao em-a-tua-andar com-nosso e-nós-te-fizemos eu וְעַמְּךָ de-todo o-povo que a-terra face-de a-terra
\v 17 E-disse yhwh a também também a a-palavra este que falaste אֶעֱשֶׂה porque encontraste graça diante de mim e-eu-conheci-te em-o-nome
\v 18 E-disse mostra-me por-favor a a-tua-glória
\v 19 E-disse eu eu-passarei todo de-seu-bem sobre perante-você yhwh em-o-nome yhwh diante-de-ti e-terei-misericórdia a que eu-virei-a-alma e-terei-compaixão a que eu-terei-compaixão
\v 20 E-disse não poderas li-roth a que porque o-homem me-virem o-homem e-viveu
\v 21 E-disse yhwh eis lugar comigo e-permanecerás sobre a-rocha
\v 22 e-foi em-o-passe a-minha-glória e-eu-te-colocarei em-a-encruzilhada o-rochedo e-eu-te-cobrirei a-minha-mão sobre-ti até [sem-traducao]
\v 23 e-eu-retirarei a כף e-você-verá a não e-minhas-faces não sejam-vistos
\c 34
\p
\v 1 E-disse yhwh a Moisés esculpe- para-ti dois as-tábuas אבנים como-as-primeiras e-eu-escreverei sobre הַלֻּחֹ֔ת a as-palavras que foram sobre as-tábuas e-agora que que-você-partiu
\v 2 e-serei certo no-manhã e-subas pela-manhã a monte-de Sinai e-voc-se-estabelecer-a a-mim nome sobre cabeça a-montanha
\v 3 e-homem não subir contigo e-também homem a será-teme em-todo o-monte também o rebanho e-o-vacalho a pastorearão a de-frente a-montanha a-aquela
\v 4 e-ele-se-apartou dois tavas pedras como-as-primeiras e-ele-se-levantou Moisés pela-manhã e-subiu a monte-de Sinai yhwh ele E-tomou a-ele E-tomou em-mão-de-ele segundo as-tavas a-banim-kaf-segol
\v 5 e-ele-descerrou yhwh em-a-névoa [וַיִּתְיַצֵּ֥ב] com-ele nome E-chamou em nome de yhwh
\v 6 e-ele-passou yhwh sobre em-seus-faces E-chamou yhwh yhwh yhwh misericordioso e-gracioso longo Apaim e-grande bondade e-verdade
\v 7 guardião hesed para-mil-gerações leva [עָוֺ֛ן] e-transgressão e-pecado e-nos-purificar-á não purificar-á visitante iniquidade אָב֗וֹת sobre filhos e-sobre filhos filhos sobre terços e-sobre quartos
\v 8 e-ele-pressuroso Moisés e ardeu terra-para e-prostrou-se
\v 9 E-disse se por-favor achei graça em-olhos-teus Adonai andará- por-favor que entre-nós ele com duração-de costas ele e-perdoarás para-nosso-pecado e-para-nossa-transgressao e-nosso-posse
\v 10 E-disse eis eu cortando braço-de-paz diante todo seu-people eu-farei maravilhas que não foram-criados em-todo a-terra e-em-todo as-nações e-viu yhwh o-povo ele אתה em-seu-interior a trabalho yhwh porque nora ele que eu fez contigo
\v 11 shamar- a-ti a eu eu o-dia o-dia eis-me gorêsh mippenêcha a o amorite וְהַֽכְּנַעֲנִ֔י ve-hachitti e-o-perizeu e-o-heveu e-o-jebuseu
\v 12 hisshamer a-ti para-que-não tikhrot ברית a-terra a-terra tu tu veio sobre-ela para-que-não será lemokeš em-te
\v 13 que a mizbêchotam tittozun e-a matsevôtam quebre-vos e-a seus-bem-aventurados cortai-os
\v 14 que não inclinai-vos a-El outro que yhwh ciumento seu-nome El ciumento ele
\v 15 para-que-não cortai berith a-terra a-terra e-prostituam-se-eles depois-de elohim-deles e-imolem לֵאלֹ֣הֵיהֶ֔ם e-anunciará a-ti e-comerás de-seu-sacrifício׃
\v 16 e-toma de-filhas-dele para-filhos-teus e-adulterarão filhas-dele depois-de Elohim-deles e-adulterarão-os a filhos-teus depois-de Elohim-deles׃
\v 17 Elohim-de MASCA não farás- para-ti
\v 18 a chag os-maizot- guardar- sete comerás comer-ás massas-de-farinha que mandei-te para-o-festival novo que porque em-mês-de הָאֲבִיב֑ saíste de-Egito
\v 19 todo que-abre ventre a-mim e-todo de-seu-pecúlio lembrar-te-ás primeiro-fruto boi e-sacrifício
\v 20 e-primeiro-fruto jumento resgatar-ás bobo-she e-se não você livrará e-arpo-to todo em primogênito-de filhos-teus tífdeh e-não יֵרָאוּ֥ face-de vazios
\v 21 seis dias ta-abod e no dia ha-shevi-i תִּשְׁבֹּ֑ת be-charish u-ba-qatzir ti-shbot
\v 22 וְחַ֥ג shavuot farás a-ti be-ku-rei colheita chi-tim ve-chag o-ajuntador a-temporada ha-shana
\v 23 três [פְּעָמִ֖ים] [בַּשָּׁנָ֑ה] [יֵרָאֶה֙] todo [אֶת־פְּנֵ֛י] a face-de yhwh yhwh Elohim-de Israel
\v 24 porque luz-seu nações diante de ti e-estenderei a teu-limite e-não desejará homem a yhwh tuas-mulheres para-ver a face-de yhwh teu-Elohim três yhwh ano-
\v 25 não imoltes sobre חָמֵ֖ץ דַּם־ זִבְחִ֑י e-não יָלִ֣ין pela-manhã sacrifício-masculino-singular festa-de o-passo
\v 26 [רֵאשִׁ֗ית] [בִּכּוּרֵי֙] [אַדְמָ֣תְךָ֔] [תָּבִ֕יא] casa yhwh teu-Elohim não [גְּדִ֖י] [בַּחֲלֵ֥ב] sua-mãe
\v 27 E-disse yhwh a Moisés escreveu- a-ti que as-palavras estes porque sobre o meu as-palavras estes cortei [sem-traducao] berith e-a Israel
\v 28 e-foi nome com dia quarenta dia pão não comer não não [שָׁתָ֑ה] não [עַל־הַלֻּחֹ֗ת] e-escreveu sobre [הַבְּרִ֔ית] a palavras-de a-aliança a-sre-t [sem-traducao]
\v 29 e-houve [בְּרֶ֤דֶת] Moisés de-montanha-de Sinai [וּשְׁנֵ֨י] [לֻחֹ֤ת] [הָֽעֵדֻת֙] pela-mão-de Moisés [מִן־הָהָ֑ר] de o-monte que não pele porque [בְּדַבְּר֥וֹ] pele sua-face [sem-traducao] com-ele
\v 30 E-viu Arão e-todo filhos-de Israel a Moisés pele [פָּנָ֑יו] pele perante-ele a-ele [sem-traducao] a-ele
\v 31 E-chamou para-eles Moisés e-retornaram a-ele Aarão e-todo [בָּעֵדָ֑ה] [וַיְדַבֵּ֥ר] e-falou Moisés a-eles
\v 32 e-depois-de assim [כָּל־בְּנֵ֣י] todo filhos-de Israel [כָּל־אֲשֶׁ֨ר] a yhwh que palavra yhwh com-ele em-monte-de Sinai
\v 33 E-terminou Moisés falando com-eles E-colocou sobre sua-face [sem-traducao]
\v 34 [וּבְבֹ֨א] Moisés diante-de yhwh para-falar com-ele [יָסִ֥יר] a [עַד־צֵאת֑וֹ] até [וְדִבֶּר֙] [אֶל־בְּנֵ֣י] [יִשְׂרָאֵ֔ל] a filhos-de Israel a que [sem-traducao]
\v 35 e-viram filhos-de Israel a que Moisés pele face-de [מֹשֶׁ֑ה] face-de Moisés e-devolver-á Moisés a [לְדַבֵּ֥ר] sobre E-abençoou até quando-vir-ele de-falar com-ele
\c 35
\p
\v 1 ויחל Moisés a todo assembleia E-disse Israel Estas a-eles estas-estes yhwh que eles yhwh [sem-traducao] eles
\v 2 seis-de dias [תֵּעָשֶׂ֣ה] obra e-no-dia o-sétimo será a-vós קֹ֛דֶשׁ [שַׁבַּ֥ת] [שַׁבָּת֖וֹן] a-yhwh todo nele obra obra será-morto
\v 3 não [אֵ֔שׁ] fogo em-todo [בְּי֖וֹם] em-dia a-sabáte
\v 4 E-disse Moisés a todo dizendo filhos-de Israel dizendo yhwh dizendo que ordenou yhwh para-dizer
\v 5 tomem [מֵֽאִתְּכֶ֤ם] [תְּרוּמָה֙] a-yhwh todo [נְדִ֣יב] coração-dele [יְבִיאֶ֕הָ] a oferta-de yhwh ouro e-prata e-niqureth:
\v 6 e-tekeli e-púrpura e-carmesim segundo e-seis e-azim:
\v 7 e-peles oveis vermelhas-muito e-peles tachashim וַעֲצֵ֥י [שִׂטִּֽים]
\v 8 e-óleo lammāʾōr [וּבְשָׂמִים֙] לְשֶׁ֣מֶן o-mishcha וְלִקְטֹ֖רֶת הַסַּמִּֽים׃
\v 9 [וְאַ֨בְנֵי־שֹׁ֔הַם] [וְאַבְנֵ֖י] [מִלֻּאִ֑ים] [לָאֵפ֖וֹד] [וְלַחֹֽשֶׁן]
\v 10 e-todo sabio coração [וְיַעֲשׂ֔וּ] virao [כָּל־אֲשֶׁ֥ר] a yhwh que ordenou yhwh
\v 11 a [אֶֽת־אָהֳל֖וֹ] a [אֶת־קְרָסָיו֙] e-[OBJ] [אֶת־בְּרִיחָ֕ו] a [וְאֶת־אֲדָנָֽיו] e-[OBJ] a a e-[OBJ]
\v 12 a [וְאֶת־בַּדָּ֖יו] e-[OBJ] e-[OBJ] a [הַמָּסָֽךְ] e-[OBJ]
\v 13 a o mesa e-a varas-de-ela pão todo seu recipiente e-a pão-de as-faces
\v 14 e-[OBJ] o-luzeiro [וְאֶת־כֵּלֶ֖יהָ] e-[OBJ] e-[OBJ] e-[OBJ] o-luzeiro e-[OBJ]
\v 15 e-a altar-de [וְאֶת־בַּדָּ֔יו] e-a [שֶׁ֣מֶן] e-את azeite o-mishcha e-a fumo [הַפֶּ֖תַח] e-a cobriu [sem-traducao] para-a-porta o-tabernáculo
\v 16 com altar-de a-oferta e-a [וְאֶת־מִכְבַּ֤ר] o-bronze que a-ele a varas-de-ela e-a todo seu recipiente a o-de-o-recipientedeágua e-a como-ele
\v 17 a [קַלְעֵ֣י] [הֶחָצֵ֔ר] a [וְאֶת־אֲדָנֶ֑יהָ] e-[OBJ] [מָסַ֖ךְ] e-[OBJ] [הֶחָצֵֽר]
\v 18 a [הַמִּשְׁכָּ֛ן] o-tabernáculo e-a testemunhem o recinto e-a [sem-traducao]
\v 19 a de-roupas [לְשָׁרֵ֣ת] para servir [אֶת־בִּגְדֵ֤י] a roupas-de a-santidade para-arão o-sacerdote e-a de-roupas filhos-dele para-servir-como-sacerdote
\v 20 todo עֲדַ֥ת ben-ei- Israel de-a-frente-de Moisés
\v 21 e-vieram todo homem que e-tudo no seu coração e-todo que ele [הֵ֠בִיאוּ] a-ele yhwh a [אֹ֤הֶל] yhwh [וּלְכָל־עֲבֹ֣דָת֔וֹ] tenda-de encontro e-para-todo- עֲבֹ֣דָת֔וֹ [sem-traducao] o-santuário
\v 22 e-vieram os-homens sobre as-mulheres todas [נְדִ֣יב] coração heviu [חָ֣ח] [וָנֶ֜זֶם] [וְטַבַּ֤עַת] [וְכוּמָז֙] todo ouro ouro e-todo homem que ouro [לַיהוָֽה] ouro para-יהוה
\v 23 e-todo homem que foi-achado com-ele tchelãz e-púrpura e-carmesim segundo e-seis [אֵילִ֧ם] e-peles oveis vermelhas-muito e-peles tachashim [sem-traducao]
\v 24 todo [תְּר֤וּמַת] [כֶּ֙סֶף֙] prata e bronze [OBJ] a yhwh e-tudo e-todo que [אִתּ֜וֹ] com-ele de troncos de [לְכָל־מְלֶ֥אכֶת] para-todo obra-de o-trabalho [sem-traducao]
\v 25 e-todo mulher [בְּיָדֶ֣יהָ] coração [וַיָּבִ֣יאוּ] [מַטְוֶ֗ה] [אֶֽת־הַתְּכֵ֙לֶת֙] [וְאֶת־הָֽאַרְגָּמָ֔ן] a [הַשָּׁנִ֖י] e-[OBJ] a e-[OBJ]
\v 26 e-todo [אֲשֶׁ֨ר] que [לִבָּ֛ן] [אֹתָ֖נָה] [בְּחָכְמָ֑ה] [טָוּ֖וּ] [אֶת־הָעִזִּֽים] a
\v 27 [וְהַנְּשִׂאִ֣ם] [הֵבִ֔יאוּ] a pedras-de [הַשֹּׁ֔הַם] e-a pedras-de os-enchimentos [לָאֵפ֖וֹד] וְלַחֹשֶׁן׃
\v 28 e-[OBJ] [וְאֶת־הַשָּׁ֑מֶן] e-[OBJ] [וּלְשֶׁ֙מֶן֙] [הַמִּשְׁחָ֔ה] [וְלִקְטֹ֖רֶת] [הַסַּמִּֽים]
\v 29 todo homem e-mulher que [לִבָּם֮] eles [לְהָבִיא֙] [לְכָל־הַמְּלָאכָ֔ה] para-todo a-obra yhwh ordenou yhwh para-fazer pela-mão-de Moisés [לַיהוָֽה׃] filhos-de Israel oferta-voluntária para-יהוה
\v 30 E-disse Moisés a filhos-de Israel chamou yhwh yhwh [בְּצַלְאֵ֛ל] de-Betsalel filho-de Uri filho-de Hur para-matate Judá
\v 31 וַיְמַלֵא ele espírito Elohim com-a-sabedoria [בִּתְבוּנָ֥ה] e-com-o-conhecimento e-em-todo obra
\v 32 e-para-inventar [מַֽחַשָׁבֹ֑ת] [לַעֲשֹׂ֛ת] em-o-ouro e-no-prata e-no-cobre
\v 33 e-no-estanho pedra para-encher [וּבַחֲרֹ֣שֶׁת] árvore para-fazer em-todo obra-de [sem-traducao]
\v 34 e-para-dar-mandamentos dar בַּלִּבּוֹ ele [וְאָֽהֳלִיאָ֥ב] filho-de [לְמַטֵּה־דָֽן] Para-a-margem- Dan:
\v 35 enchei eles [חָכְמַת־לֵ֗ב] coração [כָּל־מְלֶ֣אכֶת] todo obra-de [וְחֹשֵׁב֒] [וְרֹקֵ֞ם] [בַּתְּכֵ֣לֶת] [וּבָֽאַרְגָּמָ֗ן] [בְּתוֹלַ֧עַת] [הַשָּׁנִ֛י] [וּבַשֵּׁ֖שׁ] [וְאֹרֵ֑ג] [עֹשֵׂי֙] עֹשְׂיֵי֙ todo obra [sem-traducao] [sem-traducao]
\c 36
\p
\v 1 וְעָשָׂה֩ [בְצַלְאֵ֨ל] [וְאָהֳלִיאָ֜ב] e-tudo homem sabio coração que dar yhwh sabedoria [וּתְבוּנָה֙] animal para-conhecer [לַעֲשֹׂ֔ת] a todo trabalho a-todo a-santidade yhwh que ordenou yhwh
\v 2 E-chamou Moisés a [וְאֶל־אָֽהֳלִיאָב֒] e-para [כָּל־אִ֣ישׁ] e-a todo dar yhwh coração que deu yhwh sabedoria בַּלִּבּוֹ todo que [לַעֲשֹׂ֥ת] coração-dele [sem-traducao] a a-obra [sem-traducao] a-ela
\v 3 ve-yikhu de-diante-de Moisés a todo [אֲשֶׁ֨ר] que [בְּנֵ֣י] filhos-de Israel [עֲבֹדַ֥ת] serviço-de o-santo [אֹתָ֑הּ] a-ela [הֵבִ֨יאוּ] a-ele para-ele ainda oferta-voluntária [בַּבֹּֽקֶר] [sem-traducao]
\v 4 e-vieram todo [הָעֹשִׂ֕ים] [OBJ] a todo obra-de a-santidade homem-de homem [sem-traducao] que eles עֹשִׂ֣ים׃
\v 5 e-disseram a Moisés [מַרְבִּ֥ים] [הָעָ֖ם] o-povo [מִדֵּ֤י] desde [לַמְּלָאכָ֔ה] [אֲשֶׁר־צִוָּ֥ה] yhwh ordenou yhwh [sem-traducao] a-ela
\v 6 E-ordenou Moisés [וַיַּעֲבִ֨ירוּ] voz [בַּֽמַּחֲנֶה֮] dizendo homem e-mulher a obra ainda obra [וַיִּכָּלֵ֥א] a-santidade e-foi-retida o-povo [sem-traducao]
\v 7 [וְהַמְּלָאכָ֗ה] era [דַיָּ֛ם] para-todo a-obra para fazer a-ela e-tenha-sobra.
\v 8 e-fizeram todo sabio coração [אֶת־הַמִּשְׁכָּ֖ן] [עֶ֣שֶׂר] a o-tabernáculo dez tapumes seis משזער וּתְכֵ֤לֶת וארגמן ותולעת segundo כְּרֻבִ֛ים eles חֹשֵׁ֖ב fez eles
\v 9 comprimento-o הַיְרִיעָ֣ה הָֽאַחַ֗ת oito e-vinte na-côvado וְרֹ֙חַב֙ quatro na-côvado a cortina a-uma medida uma para-todo as cortinas
\v 10 [וַיְחַבֵּר֙] a cinco uma uma a um e-cinco uma [אֶל־אֶחָֽת] uma a uma
\v 11 E-fez tules azul sobre שַׂפַּת הַיְרִיעָה a-uma de-acéu- [בַּמַּחְבָּ֑רֶת] assim fez בְּשַׂפַּת הַיְרִיעָה הַקִּיצוֹנָה בְּמַחְבֶּרֶת הַשֵׁנִֽית׃
\v 12 cinquenta [לֻלָאֹ֗ת] fez na veste a primeira e cinquenta [לֻלָאֹ֗ת] fez em-extremidade הַיְרִיעָה que na fita a-segunda מַקְבִּילֹת֙ הַלֻּ֣לָאֹ֔ת uma a uma
\v 13 E-fez cinquenta קַרְסֵ֣י ouro [וַיְחַבֵּ֨ר] a uma uma a e-houve בַּקְּרָסִ֔ים um o-tabernáculo um
\v 14 E-fez yeru'ot ez'im le-ohel sobre ham-mishkan עשתiei- doze eles fez eles
\v 15 comprimento-o הַיְרִיעָ֣ה [הָאַחַ֗ת] sheloshim — na-côvado e-quatro covados largura הַיְרִיעָ֣ה a-uma medida uma [לְעַשְׁתֵּ֥י] dez יְרִיעֹֽת׃
\v 16 [וַיְחַבֵּ֛ר] a cinco [לְבָ֑ד] [וְאֶת־שֵׁ֥שׁ] e-[OBJ] seis
\v 17 E-fez [לֻֽלָאֹ֣ת] [חֲמִשִּׁ֗ים] sobre língua הַיְרִיעָה הַקִּיצֹנָה [בַּמַּחְבָּ֑רֶת] e cinquenta [לֻלָאֹ֗ת] fez sobre língua הַיְרִיעָה הַחֹבֶ֖רֶת הַשֵׁנִֽית׃
\v 18 E-fez קַרְסֵי bronze cinquenta [לְחַבֵּ֥ר] a ha-o-hel um um
\v 19 E-fez cobertura ao tenda peles [אֵלִ֖ים] vermelhos e-tampa peles tachashim de-acima
\v 20 E-fez a as divisões para o santuário de troncos de carmelitas que se levantam
\v 21 dez [אַמֹּ֖ת] comprimento o kares e amah וַחֲצִ֣י a amah largura o kares o-primeiro
\v 22 duas [יָדֹ֗ת] para o kares o-primeiro mesolabot uma a um assim a-todo para-todo karies o-tabernáculo
\v 23 E-fez a as divisões para o santuário vinte קְרָשִׁ֔ים para-a-lado Nebeg sul
\v 24 e-quarenta as-carruagens prata debaixo sob vinte os-karashim- segundo carruagens o-primeiro a-carruagem o-primeiro para-duas-de as suas mãos e-dois o-primeiro debaixo-de o kares o-primeiro para as duas as suas mãos
\v 25 e para o lado o-tabernáculo a-segunda para a borda norte fez vinte kareishim
\v 26 e-quarenta seus senhores prata segundo senhores debaixo o keresh o-primeiro e-dois adanim debaixo o kares o-primeiro
\v 27 e as yarkei o-tabernáculo para-o-mar fez seis kareishim
\v 28 e-dois-de kareishim fez para espinhos ham-mishkan nas yarkei
\v 29 e-sejam [תוֹאֲמִם֮] מִלְּמַטָּה֒ וְיַחְדָּ֗ו serao תַמִּים֙ a cabeça-sua a הַטַּבַּ֖עַת a-uma assim fez לִשְׁנֵיהֶ֔ם [sem-traducao] [sem-traducao]
\v 30 e-sejam oito קְרָשִׁ֔ים וְאַדְנֵיהֶ֣ם prata seis dez אֲדָנִ֑ים segundo [אֲדָנִים֙] segundo adanim debaixo o kares o-primeiro
\v 31 E-fez [בְּרִיחֵ֖י] árvores-de acácia [חֲמִשָּׁ֕ה] [לְקַרְשֵׁ֥י] [צֶֽלַע־הַמִּשְׁכָּ֖ן] o-tabernáculo
\v 32 e-cinco בְרִיחִ֔ם לְקַרְשֵׁ֥י צֶֽלַע־ o-tabernáculo a-segunda e-cinco [לְקַרְשֵׁ֣י] [הַמִּשְׁכָּ֔ן] o-tabernáculo para-as-jarcas- para-o-mar
\v 33 E-fez a [הַתִּיכֹ֑ן] [לִבְרֹ֙חַ֙] no-meio-de em-meio-de [מִן־הַקָּצֶ֖ה] de o-ketzeh- a o extremo:
\v 34 e-a as divisões ouro ouro e-a ouro fez ouro casarim para os bordados ouro a os bordados ouro
\v 35 E-fez a o-véu tchelãz e-púrpura e-carmesim segundo e-seis מָשָׁזַר obra-de חֹשֵׂב fez a-ela כּוּרְבִים׃
\v 36 E-fez para-ela quatro colunas-de שִׁיטִים [וַיְצַפֵּ֣ם] ouro ויהם ouro [וַיִּצֹ֣ק] a-eles quatro as-carruagens prata:
\v 37 E-fez כַּפֶּר para-a-entrada-de a-tenda tchelãz e-púrpura e-carmesim segundo e-seis מָשָׁזַר obra-de ROOM:
\v 38 e-a [חֲמִשָּׁה֙] cinco e-a [רָאשֵׁיהֶ֛ם] [וַחֲשֻׁקֵיהֶ֖ם] ouro e-seus-órgãos-reprodutivos ouro VE'ADNEIM חמישה bronze
\c 37
\p
\v 1 E-fez de-Betsalel a הָאָרֹ֖ן árvores-de acácia dois palmos e meio seu-comprimento e um palmo e meio em-ele-o-largura-seu e um palmo e meio sua altura
\v 2 [וַיְצַפֵּ֛הוּ] ouro puro de-casa [וּמִח֑וּץ] E-fez a-ele זֵ֥ר ouro ao-redor
\v 3 [וַיִּצֹ֣ק] a-ele quatro טַבְּעֹ֣ת ouro sobre quatro פַּעֲמֹתָ֑יו e-duas-de טַבָּעֹ֗ת sobre צַלְעוֹ֙ a-uma u-shtey [עַל־צַלְע֖וֹ] sobre צַלְע֖וֹ הַשֵׁנִֽית׃
\v 4 E-fez em-cápsulas árvores-de acácia e-cobriu eles ouro
\v 5 e-trouxe a הַבַּדִּים֙ sobre sobre צַלְעֹ֣ת הָאָרֹ֑ן levando a [sem-traducao]
\v 6 E-fez [כַּפֹּ֖רֶת] ouro puro אַמָּתַ֤יִם e meio אָרְכָּ֔הּ e um palmo e meio rāḥabbah
\v 7 E-fez segundo [כְרֻבִ֖ים] ouro miqšāh fez eles misnē pontas ha-kappōret
\v 8 [כְּרוּב־אֶחָ֤ד] um miqqetsāh deste-lado e-caravel- um de-acéu- deste de a-caporéth- fez a os-querubins de-dois-de
\v 9 e-foram os-querubins que-spreadem- as-asas- acima-de- [סֹֽכְכִ֤ים] com-as-sus-asas- sobre a-caporéth- e as faces homem a irmão-dele face-de os-querubins foram face-de os-querubins
\v 10 E-fez a [עֲצֵ֣י] árvores-de acácia אַמָּתַ֤יִם seu-comprimento e um pé em-ele-o-largura-seu e um palmo e meio sua altura
\v 11 e-cobriu ele ouro puro E-fez a-ele זֵ֥ר ouro ao-redor
\v 12 E-fez a-ele misgeret topach ao-redor E-fez zer- zahav misgeret ao-redor
\v 13 [וַיִּצֹ֣ק] a-ele quatro טַבְּעֹ֣ת ouro E-colocou a sobre sobre quatro hafe'ot que para quatro de-seus-pés
\v 14 conforme a misteriosa foram as plantas [בָּתִּים֙] [לַבַּדִּ֔ים] levando a a mesa
\v 15 E-fez a הַבַּדִּים֙ árvores-de שִׁיטִים eles ouro ouro levando a a mesa
\v 16 E-fez a [׀] que sobre [אֶת־קְעָרֹתָ֤יו] a e-[OBJ] e-[OBJ] [וְאֶת־הַקְּשָׂוֺ֔ת] e-[OBJ] [יֻסַּ֖ךְ] e-[OBJ] ouro que
\v 17 E-fez a ouro ouro puro candelabrum- fez a a menorá -suas-mamas -et-e-sua-cana -suas-copas -suas-bacias -e-suas-floradas de-a-ela eram
\v 18 e-seis קָנִים יֹצְאִים מִצִּדֶּהָ שְׁלֹשָׁה קְנֵי מְנֹרָה מִצִּדָּהּ do único o-primeiro קְנֵי מְנֹרָה de-lá-dela o-segundo
\v 19 três gevú-'im mash-qú-kadím baq-qué-né o-primeiro kap-tór va-perákh e-três gevú-im mash-qú-kadím בּ-קָנֶה um kap-tór e-fo-rach assim seis as quinas que saem de a manora:
\v 20 e na manora quatro copos [מְשֻׁ֨קָּדִ֔ים] suas bordas e suas flores:
\v 21 e a cipreste debaixo segundo das vimeiras deles e a cipreste debaixo segundo das vimeiras de-a e a cipreste debaixo-de segundo das vimeiras מִמֶּנָּה seis as quinas que saem de-elas
\v 22 suas têmporas e seus canos de ela foram toda de jardim uma ouro puro
\v 23 E-fez a suas velas sete e-suas-mãos ouro ouro puro
\v 24 como-circunferência ouro puro fez a-ela e-a todo [sem-traducao]
\v 25 E-fez a altar-de [עֲצֵ֣י] árvores-de acácia cubit-a [וְאַמָּ֨ה] [רָחְבּ֜וֹ] [רָב֗וּעַ] [וְאַמָּתַ֙יִם֙] [קֹֽמָת֔וֹ] nós dele foram os-seus-chifres
\v 26 e-cobriu ele ouro טהור a [וְאֶת־קִירֹתָ֛יו] e-a [וְאֶת־קַרְנֹתָ֑יו] ao-redor a-ele suas cornetas ouro para-ele זֵ֥ר ouro ao-redor
\v 27 [וּשְׁתֵּי֩] [טַבְּעֹ֨ת] ouro fez para-ele debaixo-de para-seu-fio sobre duas [צַלְעֹתָ֔יו] sobre segundo [צִדָּ֑יו] para quartos separadamente para-levar ele neles
\v 28 E-fez a [עֲצֵ֣י] árvores-de acácia eles ouro
\v 29 E-fez a shemen a unção santidade e-a fumegante das-essências puro obra-de [sem-traducao]
\c 38
\p
\v 1 E-fez a altar-de a-holocausto árvores-de acácia cinco אמות o-seu-comprimento [רָחְבּוֹ֙] [רָב֔וּעַ] a-sua-largura [אַמּ֖וֹת] e três côvados sua altura
\v 2 E-fez suas cornetas sobre quatro suas pontas nós eram suas cornetas e-cobriu ele bronze
\v 3 E-fez a todo utensílios-de o-altar a [אֶת־הַמִּזְלָגֹ֖ת] e-a [כָּל־כֵּלָ֖יו] e-a as-alâbadas a [sem-traducao] e-a [sem-traducao] todo כְּלֵיָיו fez bronze
\v 4 E-fez [לַמִּזְבֵּ֙חַ֙] de-machbar obra-de rede bronze debaixo [כַּרְכֻּבּ֛וֹ] [מִלְּמַ֖טָּה] até [sem-traducao]
\v 5 [וַיִּצֹ֞ק] quatro [טַבָּעֹ֛ת] [בְּאַרְבַּ֥ע] [הַקְּצָוֺ֖ת] [לְמִכְבַּ֣ר] [הַנְּחֹ֑שֶׁת] casarim [לַבַּדִּֽים]
\v 6 E-fez a [עֲצֵ֣י] árvores-de acácia eles eles
\v 7 e-trouxe a [בַּטַּבָּעֹ֗ת] sobre sobre צַלְעֹ֣ת o altar ele ele com-eles nabub luchot ele ele
\v 8 E-fez a [הַכִּיּ֣וֹר] bronze e-a [כַּנּ֣וֹ] bronze [בְּמַרְאֹת֙] [הַצֹּ֣בְאֹ֔ת] que [צָֽבְא֔וּ] entrada tenda reunião
\v 9 E-fez a [לִפְאַ֣ת] [׀] Neguebe [תֵּימָ֗נָה] [קַלְעֵ֤י] o-pateo seis [מָשְׁזָ֔ר] cem [בָּאַמָּֽה]
\v 10 [עַמּוּדֵיהֶ֣ם] vinte VE'ADNEIM vinte bronze e-ganchos-de HA'AMMUDIM e-seus-órgãos-reprodutivos כַּסֶּפֶת׃
\v 11 [וְלִפְאַ֤ת] -norte cem [בָֽאַמָּ֔ה] [עַמּוּדֵיהֶ֣ם] vinte VE'ADNEIM vinte bronze e-ganchos-de [הָֽעַמּוּדִ֛ים] e-seus-órgãos-reprodutivos כַּסֶּפֶת׃
\v 12 [וְלִפְאַת־יָ֗ם] [קְלָעִים֙] [חֲמִשִּׁ֣ים] cinquenta na-côvado [עֲשָׂרָ֔ה] dez e seus enredados dez e-ganchos-de HA'AMMUDIM [כָּֽסֶף] כַּסֶּפֶת׃
\v 13 [וְלִפְאַ֛ת] leste oeste cinquenta jardim; jardim:
\v 14 cordões חֲמֵשׁ- doze côvado a [שְׁלֹשָׁ֔ה] [וְאַדְנֵיהֶ֖ם] שְׁלֹשָׁ֔ה quatro três
\v 15 [וְלַכָּתֵ֣ף] a-segunda [מִזֶּ֤ה] [וּמִזֶּה֙] para-portão-de o-pátio [קְלָעִ֕ים] cinco dez jardim e suas colunas שְׁלֹשָׁ֔ה e seus enredados três
