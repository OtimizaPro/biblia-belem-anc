\usfm 3.0
\ide UTF-8
\h Números
\toc1 Números
\toc2 Números
\toc3 NUM
\mt1 NÚMEROS
\c 1
\p
\v 1 e-falou yhwh a Moisés em-deserto-de Sinai em-tenda-de de-encontro em-um para-o-mês o-segundo em-a-ano a-segunda para-saída-deles de-terra-de dizendo para-dizer
\v 2 levantai a cabeça todo congregação-de filhos-de Israel para-famílias-deles para-casa-de pais-deles em-número-de nomes todo macho para-crânios-deles
\v 3 de-filho-de vinte ano e-para-cima todo exército exército em-Israel eles a-eles tu tu e-Aarão
\v 4 e-convosco serão homem homem para-a-tribo homem cabeça para-casa-de ele ela
\v 5 e-estes nomes-de os-homens que estarão-em-pé convosco para-Rúben Elisur filho-de Sedeur
\v 6 para-Simeão Selumiel filho-de Zurisadai
\v 7 para-Judá Nasom filho-de Aminadabe
\v 8 para-Issacar Netanel filho-de Zuar
\v 9 para-Zebulom Eliabe filho-de Helom
\v 10 a-filhos-de José para-Efraim Elisama filho-de Amiúde para-Manassés Gamaliel filho-de Pedazur
\v 11 para-Benjamim Abidã filho-de Gideoni
\v 12 para-Dã Aiezer filho-de Amisadai
\v 13 para-Aser Pagiel filho-de Ocrã
\v 14 para-Gade Eliasafe filho-de Deuel
\v 15 para-Naftali Aira filho-de Enã
\v 16 Estas a-congregação príncipes-de tribos-de pais-deles cabeças-de milhares-de Israel eles
\v 17 E-tomou Moisés e-Arão את os-homens os-estes que foram-designados em-nomes
\v 18 e-a todo a-congregação congregaram em-um para-o-mês o-segundo e-registraram-se sobre famílias-deles para-casa-de pais-deles em-número-de nomes-de de-filho-de vinte ano e-para-cima para-crânios-deles
\v 19 como ordenou yhwh a Moisés e-contou-os em-deserto-de Sinai
\v 20 e-foram filhos-de Rúben primogênito-de Israel gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes para-cabeças-deles todo macho de-filho-de vinte ano sai exército saindo exército
\v 21 contados-deles para-tribo-de Rúben seis e-quarenta mil e-cinco centenas
\v 22 a-filhos-de Simeão gerações-deles para-famílias-deles para-casa-de pais-deles contados-dele em-número-de nomes para-cabeças-deles todo macho de-filho-de vinte ano e-para-cima sai exército exército
\v 23 contados-deles para-tribo-de Simeão nove e-cinquenta mil e-três centenas
\v 24 a-filhos-de Gade gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes-de de-filho-de vinte ano e-para-cima todo sai exército
\v 25 contados-deles para-tribo-de Gade cinco e-quarenta mil e-seis centenas e-cinquenta
\v 26 a-filhos-de Judá gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 27 contados-deles para-tribo-de Judá quatro e-setenta mil e-seis centenas
\v 28 a-filhos-de Issacar gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 29 contados-deles para-tribo-de Issacar quatro e-cinquenta mil e-quatro centenas
\v 30 a-filhos-de Zebulom gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 31 contados-deles para-a-tribo-de Zebulom sete e-cinquenta mil e-quatro centenas
\v 32 para-filhos-de José a-filhos-de Efraim gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 33 contados-deles para-a-tribo-de Efraim quarenta mil e-cinco centenas
\v 34 a-filhos-de Manassés gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes-de de-filho-de vinte ano e-para-cima todo sai exército
\v 35 contados-deles para-a-tribo-de Manassés dois e-trinta mil e-duzentos
\v 36 a-filhos-de Benjamim gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 37 contados-deles para-a-tribo-de Benjamim cinco e-trinta mil e-quatro centenas
\v 38 a-filhos-de Dã gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 39 contados-deles para-a-tribo-de Dã dois e-sessenta mil e-sete centenas
\v 40 a-filhos-de que gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 41 contados-deles para-a-tribo-de que um e-quarenta mil e-cinco centenas
\v 42 filhos-de Naftali gerações-deles para-famílias-deles para-casa-de pais-deles em-número-de nomes de-filho-de vinte ano e-para-cima todo sai exército
\v 43 contados-deles para-a-tribo-de Naftali três e-cinquenta mil e-quatro centenas
\v 44 Estas os-contados que contou Moisés e-Aarão e-príncipes-de Israel dois dez homem homem um para-casa-de pais-dele eram
\v 45 e-foram todo contados-de filhos-de Israel para-casa-de pais-deles de-filho-de vinte ano exército todo saindo exército em-Israel
\v 46 e-foram todo os-contados seis-de centenas mil e-três-de milhares e-cinco centenas e-cinquenta
\v 47 e-os-levitas para-a-tribo-de pais-deles não foram-contados em-meio-de-eles
\v 48 e-falou yhwh a Moisés dizendo
\v 49 porém a tribo-de não não contarás não cabeças-deles no-meio-de levantarás em-meio-de filhos-de Israel
\v 50 e-tu designa a os-levitas sobre tabernáculo-de o-testemunho e-sobre todo utensílios-dele e-sobre todo que para-ele eles levarão a o-tabernáculo e-a todo utensílios-dele e-eles servirão-o e-ao-redor para-o-tabernáculo acamparão
\v 51 e-quando-partir o-tabernáculo descerão ele os-levitas e-quando-acampar o-tabernáculo levantarão ele os-levitas e-o-estranho o-que-se-aproxima será-morto
\v 52 e-acamparão filhos-de Israel homem sobre acampamento-dele e-homem sobre estandarte-dele para-exércitos-deles
\v 53 e-os-levitas acamparão ao-redor para-tabernáculo-de o-testemunho e-não será ira sobre congregação-de filhos-de Israel e-guardarão os-levitas a guarda-de tabernáculo-de o-testemunho
\v 54 e-fizeram filhos-de Israel conforme-tudo que ordenou yhwh a Moisés assim fizeram
\c 2
\p
\v 1 e-falou yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 2 homem sobre estandarte-dele com-sinais para-casa-de pais-deles acamparão filhos-de Israel defronte ao-redor para-tenda-de encontro acamparão
\v 3 e-os-que-acampam oriente para-o-nascente estandarte-de acampamento-de יְהוּדָה para-exércitos-deles e-príncipe-de a-filhos-de יְהוּדָה נַחְשׁוֹן filho-de Aminadabe
\v 4 e-exército-dele e-contados-deles quatro e-setenta mil e-seis centenas
\v 5 e-os-que-acampam sobre-ele tribo-de Issacar e-príncipe-de a-filhos-de Issacar נְתַנְאֵל filho-de צוּעָר
\v 6 e-exército-dele e-contados-dele quatro e-cinquenta mil e-quatro centenas
\v 7 tribo-de זְבוּלֻן e-príncipe-de a-filhos-de זְבוּלֻן אֱלִיאָב filho-de חֵלֹן
\v 8 e-exército-de-ele e-contados-de-ele sete e-cinquenta mil e-quatro centenas
\v 9 todo os-contados para-acampamento-de Judá centena-de mil e-oitenta mil e-seis-de milhares e-quatro-de centenas para-exércitos-de-eles primeira eles-partirão
\v 10 estandarte-de acampamento-de Rúben para-o-sul para-exércitos-de-eles e-príncipe-de a-filhos-de Rúben Elizur filho-de Sedeur
\v 11 e-exército-de-ele e-contados-de-ele seis e-quarenta mil e-cinco centenas
\v 12 e-os-campistas sobre-ele tribo-de Simeão e-príncipe-de a-filhos-de Simeão Selumiel filho-de Zuri Shaddai
\v 13 e-exército-de-ele e-contados-de-eles nove e-cinquenta mil e-três centenas
\v 14 e-tribo-de Gade e-príncipe-de a-filhos-de Gade Eliasafe filho-de Reuel
\v 15 e-exército-de-ele e-contados-de-eles cinco e-quarenta mil e-seis centenas e-cinquenta
\v 16 todo os-contados para-acampamento-de Rúben centena-de mil e-um e-cinquenta mil e-quatro-de centenas e-cinquenta para-exércitos-de-eles e-do-dois eles-partirão
\v 17 e-partirá tenda-de encontro acampamento-de no-meio-de em-meio-de os-lugares-de-acampamento como-que eles-acamparão assim eles-partirão homem sobre mão-sua para-estandartes-de-eles
\v 18 estandarte-de acampamento-de Efraim para-exércitos-de-eles para-o-mar e-príncipe-de a-filhos-de Efraim Elisama filho-de Amiúde
\v 19 e-exército-de-ele e-contados-de-eles quarenta mil e-cinco centenas
\v 20 e-sobre-ele tribo-de Manassés e-príncipe-de a-filhos-de Manassés Gamaliel filho-de Pedazur
\v 21 e-exército-de-ele e-contados-de-eles dois e-trinta mil e-duzentos
\v 22 e-tribo-de Binyamin e-príncipe-de a-filhos-de Binyamin Abidan filho-de Gideoni
\v 23 e-exército-dele e-contados-deles cinco e-trinta mil e-quatro centenas
\v 24 todo os-contados para-acampamento-de Efrayim cem mil e-oito-de milhares e-cem para-exércitos-deles e-terceiros eles-partirão
\v 25 estandarte-de acampamento-de Dan ao-norte para-exércitos-deles e-príncipe-de a-filhos-de Dan Ahiezer filho-de Amisadai
\v 26 e-exército-dele e-contados-deles dois e-sessenta mil e-sete centenas
\v 27 e-os-acampados sobre-ele tribo-de que e-príncipe-de a-filhos-de que Pagiel filho-de Ocran
\v 28 e-exército-dele e-contados-deles um e-quarenta mil e-cinco centenas
\v 29 e-tribo-de Naftali e-príncipe-de a-filhos-de Naftali Ahira filho-de Einan
\v 30 e-exército-dele e-contados-deles três e-cinquenta mil e-quatro centenas
\v 31 todo os-contados para-acampamento-de Dan cem mil e-sete e-cinquenta mil e-seis centenas por-último partirão segundo-estandartes-deles
\v 32 Estas contados-de filhos-de Israel para-casa-de pais-deles todo contados-de os-acampamentos para-exércitos-deles seis-de centenas mil e-três-de milhares e-cinco centenas e-cinquenta
\v 33 e-os-levitas não foram-contados no-meio-de filhos-de Israel como ordenou yhwh a Moisés
\v 34 e-eles-fizeram filhos-de Israel conforme-tudo que yhwh yhwh a Moisés assim acamparam segundo-estandartes-deles e-assim partiram homem segundo-famílias-dele sobre casa pais-dele
\c 3
\p
\v 1 e-estes gerações-de Aharon e-Mosheh em-dia-de palavra yhwh a Moisés em-monte-de Sinai
\v 2 e-estes nomes-de filhos-de Aharon o-primogênito Nadab e-Abihu Elazar e-Itamar
\v 3 Estas nomes-de filhos-de Arão os-sacerdotes os-ungidos que enchei mão-deles para-servir-como-sacerdote
\v 4 E-morreu Nadabe e-Abiú diante-de yhwh em-o-aproximar-deles fogo estranho diante-de yhwh em-deserto-de Sinai e-filhos não a-eles para-eles e-serviu-como-sacerdote Eleazar e-Itamar sobre face-de Aarão pai-deles
\v 5 e-falou yhwh a Moisés dizendo
\v 6 aproxima a tribo-de Levi ele a-ele diante-de Aarão o-sacerdote ele a-ele
\v 7 e-guardarão a guarda-dele e-a guarda-de todo a-congregação para-lavrar tenda de-encontro para-servir a serviço-de o-tabernáculo
\v 8 e-guardarão את- todo utensílios-de tenda encontro e-a para-lavrar filhos-de Israel para-servir a serviço-de o-tabernáculo
\v 9 e-darás a os-levitas para-Aarão e para filhos-seus dados dados a-ele a-ele de-com filhos-de Israel
\v 10 e-a אַהֲרֹן e-a filhos-dele designarás e-guardarão a sacerdócio-deles e-o-estranho o-que-se-aproxima será-morto
\v 11 e-falou yhwh a Moisés dizendo
\v 12 e-eu eis tomei a os-levitas de-meio-de filhos-de debaixo em-lugar-de todo primogênito que-abre ventre e-sejam Israel e-serão para-mim os-levitas
\v 13 que para-mim todo primogênito em-dia ferir-eu todo primogênito na-terra Egito santifiquei para-mim todo primogênito em-Israel de-homem até yhwh para-mim serão eu yhwh
\v 14 e-falou yhwh a Moisés em-deserto-de dizendo para-dizer
\v 15 conta a filhos-de Levi segundo-casa-de pais-deles segundo-famílias-deles todo macho de-filho-de novo e-para-cima contarás-eles
\v 16 e-contou eles Moisés sobre yhwh yhwh como foi-ordenado
\v 17 e-foram estes filhos-de Levi em-nomes-deles Gérson e-Coate e-Merari
\v 18 e-estes nomes-de filhos-de Gérson segundo-famílias-deles Libni e-Simei
\v 19 e-filhos-de Coate segundo-famílias-deles Anrão e-Izar Hebrom e-Uziel
\v 20 e-filhos-de Merari para-famílias-deles Mahli e-Mushi Estas eles famílias-de o-levita para-casa-de pais-seus
\v 21 para-Gershom família-de o-libnita e-família-de o-shimeíta Estas eles famílias-de o-gershonita
\v 22 contados-seus em-número-de todo macho de-filho-de novo e-para-cima contados-seus sete dois-mil e-cinco centenas
\v 23 famílias-de o-gershonita atrás-de o-tabernáculo acamparão para-o-mar
\v 24 e-príncipe-de casa-de pai para-o-gershonita Eliasafe filho-de Lael
\v 25 e-guarda-de filhos-de Gershom em-tenda-de encontro o-tabernáculo e-a-tenda cobertura-sua e-cortina-de entrada-de tenda-de encontro
\v 26 e-cortinas-de o-pátio e-a cortina-de entrada-de o-pátio que sobre o-tabernáculo e-sobre o-altar a-todo e-את cordas-suas para-todo serviço-seu
\v 27 e-para-Coate família-de o-amramita e-família-de o-izharita e-família-de o-hebronita e-família-de o-uzielita Estas eles famílias-de o-coatita
\v 28 em-número-de todo macho de-filho-de novo e-para-cima oito-de milhares e-seis centenas guardadores-de guarda-de o-santuário
\v 29 famílias-de filhos-de Coate sobre sobre lado-de o-tabernáculo sul
\v 30 e-príncipe-de casa-de pai para-famílias-de o-coatita Elizafã filho-de Uziel
\v 31 e-guarda-sua a-arca e-a-mesa e-o-candelabro e-os-altares e-utensílios-de o-santuário que servirão com-eles e-a-cortina e-tudo serviço-seu
\v 32 e-príncipe-de príncipes-de o-levita Eleazar filho-de Aarão o-sacerdote supervisão-de guardadores-de guarda-de o-santuário
\v 33 para-Merari família-de o-Mahli e-família-de o-Mushi Estas eles famílias-de Merari
\v 34 e-contados-deles em-número-de todo macho de-filho-de novo e-para-cima seis-de milhares e-duzentos
\v 35 e-príncipe-de casa-de pai para-famílias-de Merari Zuriel sobre Abiail sobre lado-de o-tabernáculo acamparão norte-para
\v 36 e-contagem-de de-serviço filhos-de amargura pratos-de-ferro o-tabernáculo e-suas-asas e-seus-pilares e-os-seus-mestres e-todo e-tudo e-todo serviço-seu
\v 37 e-as-colunas-de o-courim ao-redor e-os-seus-mestres e-as-suas-estacas e-dos-seus-cordões
\v 38 e-os-acampados diante-de o-tenda oriente em-frente-de-a tenda-de a-reunião do-leste Moshê e-Aharôn e-seus-filhos guardando de-guarda do-santuário para-de-guarda filhos-de Israel e-o-estranho o-que-se-aproxima será-morto
\v 39 todo de-contados dos-Levitas que contou Moisés sobre yhwh yhwh segundo-famílias-deles todo macho de-filho-de novo e-para-cima dois e-vinte mil
\v 40 E-disse yhwh a Moisés ordena macho primogênito macho aos-filhos-de Israel de-filho-de novo e-para-cima e-leve a número nomes-deles
\v 41 e-tomará a os-leviata a-mim yhwh debaixo debaixo-de todo primogênito filhos-de Israel e-את debaixo os-levitas em-lugar-de todo primogênito em-animais filhos-de Israel
\v 42 e-ele-contou Moisés como ordenou yhwh ele a todo em-primeiro de-filhos Israel
\v 43 e-houve todo macho macho em-número nomes de-filho-de novo e-para-cima para-seus-contados dois e-vinte mil três e-setenta e-duzentos
\v 44 e-falou yhwh a Moisés dizendo
\v 45 toma a debaixo em-lugar-de todo primogênito de-filhos Israel debaixo besta-m os-levitas em-lugar-de behemt-am yhwh para-mim os-levitas eu yhwh
\v 46 e-את peduy-ei ha-shlosha ve-ha-shbeim ve-hama-tayim ha-odfim sobre os-levitas me-bchor filhos-de Israel
\v 47 ve-laqacht-a hameshet cinco-vezes escalam para-o-cranio em-sheqel a-santidade tomarás vinte gume-da o-escalam:
\v 48 e-darás a-prata para-Aarão e para filhos-seus ransomados os-excedentes neles
\v 49 E-tomou Moisés a prata o-resgate de-com os-sobras sobre resgatados-de os-levitas
\v 50 de-a primogênito filhos-de Israel tomou a o-prata cinco e sessenta e-três de-cem e-um-mil na-unidade-de-prata o-santuário
\v 51 E-colocou Moisés a prata os-redimidos para-Aaron e-para-seus-filhos yhwh boca-de yhwh yhwh ordenou yhwh a Moisés
\c 4
\p
\v 1 e-falou yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 2 levante a cabeça filhos-de Qehat de-meio-de filhos-de Levi para-famílias-deles segundo-casa-de pais-seus
\v 3 de-filho-de trinta ano e-para-cima e-até filho-de cinquenta ano todo veio obra para-fazer trabalho em-tenda encontro
\v 4 esta serviço-de filhos-de Coate em-tenda-de de-encontro santidade os-santos
\v 5 e-ele-veio אַהֲרֹן e-filhos-dele quando-partir o-acampamento e-desçam a parokhet ha-masakh e-kis-u- nela a aron ha-edut:
\v 6 ve-natenu sobre-ele kisui- pele takhash u-parshu beged- perfeito azul-violeta de-acima e-colocaram em-os-seus
\v 7 e-sobre mesa o-das-faces desplorem roupa azul-violeta e-darão em-ele a as-tigelas e-a os-pratos e-a das-mangueiras e-a dureza do-sacrifício e-pão será sobre-ele será
\v 8 e-espalharão em-eles roupa carne-carnuda segundo e-vestirão ele em-o-manto pele de-tachash e-colocarão a em-seus-dobradiças
\v 9 e-tomarão manto azul e-cobrirem a de-a-menora o-luzeiro e-a luzes-deiha e-a pratos-deiha e-a vasos-de-fogo-deiha e-את todo instrumentos-de oito que servirão-a para-ela neles
\v 10 e-darão a-ela e-a todo pele a cobertura pele de-tachash e-dêem sobre o-mato
\v 11 e-sobre-o altar-de o-ouro o-ouro roupa tecelagem-azul e-cobrirão a-ele ele pele pele e-colocarão a em-o-seu
\v 12 e-eles-tomaram a todo os-ferramentas-de-serviço da-serviço que servirão-em neles no-santo e-eles-darão a um-vestido pele e-eles-cobrirão a-eles com-a-capinha pele de-tachash e-dêem sobre o-mato
\v 13 e-dele-estavam-limpando a o-altar e-espalharão sobre-ele biged púrpura
\v 14 ve-natenu em-ele a todo seus-vessōis que servirém sobre-ele em-eles a as-vassouras a os-escrivanões e-a os-penitentes e-a as-alâbadas pele utensílios-de o-altar e-espalharém sobre-ele coberto pele Tachash e-os-colocaram em-o-sobre-ele-verso
\v 15 e-terminou Aharon- e-filhos-dele para-cobrir a o-santo e-a todo utensílios-de o-santo em-a-partida do-lageramento e-depois-de assim venham Estas Qehath- le-saet e-não yiggu a o-santo va-metu estes massa- filhos-de Coate be-ohele encontro
\v 16 u-fqudat Elazar- filho-de Aarão o-sacerdote shemen o-luzeiro u-qatoreth o-sabão e-oferta a-perpétua e-óleo a-unção de-a-conta todo o-tabernáculo e-todo que nele no-sagrado e-no-seus-vesséis
\v 17 e-falou yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 18 a você-quebrará a shevet mishpachot o-coatita mitoch os-levitas
\v 19 ve-zot asu para-ela-os a-eles e-não yamutu begishatam a santo-de ha-kodashim אַהֲרֹן e-filhos-dele yavo-u veshumu aqueles-o homem homem sobre serviço-seu e-a levantamento-seu
\v 20 e-não para-ver para-ver de-abelha a o-santo e-morreram
\v 21 e-falou yhwh a Moisés dizendo
\v 22 levantar a cabeça filhos-de Gérson também eles segundo-casa-de pais-deles para-famílias-deles
\v 23 de-filho trinta ano e-para-cima até filho-de cinquenta ano ordene eles todo exército para-lavrar exército para-trabalhar serviço em-tenda encontro
\v 24 esta trabalho-de famílias-de o-gershonita para-lavrar e-para-levar
\v 25 e-eles-levarão a tendas-de o-tabernáculo e-a tenda encontro cobertura-sua e-tampa o-couro-de-animais-marinhos que sobre-ele de-acima e- cobertura entrada-de tenda-de encontro
\v 26 e-את calais o-haçatsér e-a masakh- petakh- portão haçaçér que sobre ham-mishkán e-sobre o-altar ao-redor e-את meitreyhem e-com tudo-de kléi- avodatam a-eles todo que ele-será-feito a-eles ve-avádu
\v 27 sobre de-mim Arão e-seus-filhos ser-ás todo serviço-dele filhos-de o-gershuni para-todo carga-deles e-a-todos serviço-deles e-vigiar-eis de-elas em-serviço a todo levamento-deles
\v 28 esta serviço-da famílias-das filhos-de o-gersonita em-tenda-de de-encontro e-de-sua-guarda em-mão-de aitamar filho-de אַהֲרֹן o-sacerdote
\v 29 filhos-de de-melancolia para-famílias-das-deles para-casa-de pais-deles eles a-eles
\v 30 do-filho trinta ano e-ma'aláh ve-ad filho-de cinquenta ano tipqdem todo para-lavrar la-tzava la-avod a avodat tenda-de encontro
\v 31 ve-zot mishmeret masa'am para-todo avodatam em-tenda-de reunião pratos-de-ferro o-tabernáculo e-suas-asas e-seus-pilares e-dele-eram-mestres
\v 32 e seus pilares o-hatzéэр em volta e seus anciãos e suas testemunhas e seus herdeiros para-todo utensílios-deles e-a-tudo a-obra-deles e-no-nomes voces-contareis a os-utensilios-de guarda-de de-a-sua-carga
\v 33 esta a-obra-de das-familias filhos-de Merari para-todo a-obra-deles em-tenda-de de-encontro em-mão-de Ithamar filho-de אַהֲרֹן o-sacerdote
\v 34 e-ele-fiscalizou Moisés e-Aharon e-príncipes-de a-congregação a filhos-de o-coatita para-famílias-deles e-para-a-casa-de pais-seus
\v 35 de-filho-de trinta ano e-para-cima e-até filho-de cinquenta ano todo o-vindo para-o-exército para-a-obra em-a-tenda-de encontro
\v 36 e-foram de-sua-fiscalização segundo-famílias-deles dois-mil sete centenas e-cinquenta
\v 37 Estas fiscalizações famílias o-qehathi todo o-que-serva em-tenda-de de-encontro que contou Moisés e-Aarão yhwh de-seu yhwh por-mão-de Moisés
\v 38 e-contados-de filhos-de gerson para-famílias-deles e-para-casa pais-seus
\v 39 de-filho-de trinta ano e-para-cima e-até filho-de cinquenta ano todo o-vindo la-tzava para-a-obra em-tenda encontro
\v 40 e-foram contados-seus para-famílias-deles para-casa-de pais-deles dois-mil e-seis centenas e-trinta
\v 41 Estas os-contados-de das-familias filhos-de Gerson todo o-que-serva em-tenda-de de-encontro que pakad Moisés e-Aarão yhwh de-seu yhwh
\v 42 e que foram contados famílias-de filhos-de Merari para-famílias-deles segundo-casa-de pais-seus
\v 43 de-filho-de trinta ano e-para-cima e-até filho-de cinquenta ano todo o-que-vem para-o-exército para-a-trabalho em-a-tenda encontro
\v 44 e-foram de-seus-contados segundo-famílias-deles três dois-mil e-duzentos
\v 45 Estas contados-de famílias-de filhos-de do-amargura que contou Moisés e-Aarão sobre yhwh yhwh por-mão-de Moisés
\v 46 todo os-contados que contou Moisés e-Aharon e-príncipes Israel a os-levitas para-famílias-deles e-a-casa-de pais-seus
\v 47 de-filho-de trinta ano e-para-cima e-até filho-de cinquenta ano para-lavrar o-que-vem para-o-laborar de-laborar trabalho e-de-laborar profecia em-a-tenda encontro
\v 48 e-foram de-sua-visitação oito milhares e-cinco centenas e-oitenta
\v 49 sobre yhwh yhwh visitou a-eles em-a-mão Moisés homem homem sobre de-sua-obra e-sobre yhwh e-seus-enviados que ordenou yhwh a Moisés
\c 5
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 ordene a filhos-de Israel e-eles-enviem de o-acampamento e-tudo leproso e-todo fluxo e-todo impuro para-a-alma
\v 3 do-masculino até fêmea envi-a-los a de-fora para-o-acampamento envia-os e-não tornar-se-ão-imundos a de-seus-acampamentos que eu morando em-meio-de-eles
\v 4 e-ele-fizeram- assim filhos-de Israel e-eles-enviaram a-eles a fora-de para-o-lager yhwh palavra yhwh a Moisés assim fizeram filhos-de Israel
\v 5 e-falou yhwh a Moisés dizendo
\v 6 palavra a filhos-de Israel homem que mulher porque o-homem de-todo pecados o-homem para-desonrar ofensa aquela e-ashmá a-alma ha-híu
\v 7 ve-hitvaddú a chatátaém que asú e-pagava a ashamó com-no-cabeça-seu va-chamishíto adicionará sobre-ele e-dará a-ele ashám a-ele
\v 8 e-se ein la-éish גּוֹיֶל para restituir a-ele para-ele o pecado o-mushab a-yhwh para-o-sacerdote apenas ovelha as-cuprirem que yechaper- nele sobre-ele
\v 9 e-todo terumah para-todo santos filhos-de a-ele será yakrivu para-o-sacerdote para-ele será
\v 10 e-homem a a-ele a-ele sejam homem que a-ele será para-ele será
\v 11 e-falou yhwh a Moisés dizendo
\v 12 palavra a filhos-de Israel e-dirás a-eles homem homem porque torne-se-estúpida nele e-ofenderá em-ele acima
\v 13 e-deite homem ela-a deito-de- semente e-se-esconda das-olhos marido-dela e-se-oculta e-ela ficou-imunda e-testemunha não-há em-ela não não foi-apanhada
\v 14 e-passou sobre-ele espírito-de ciúme e-ciumento a mulher-sua e-ela ficou-imunda ou passou sobre-o espírito-de não e-ciumento a mulher-dele e-ela não ficou-imunda-verso-final
\v 15 e-trará o-homem a sua-mulher a o-sacerdote e-ele-trouxe a seu-oferta-sua sobre-ela décima-parte a-árvore qemakh em-semente-de-cevada não ele-derramará sobre-ele óleo e-não ele sobre-ele de-bálsamo porque oferta-estrituária-de de-zelo ele oferenda-de zicaron mazchoret avon
\v 16 ve-hikrib a-ela o-sacerdote ve-heemidah diante-de yhwh
\v 17 e-tome o-sacerdote águas kedoshim bikli- charesh e-de será que yihye bekarka o-tabernáculo ele-tomará o-sacerdote e colocou a as-águas
\v 18 e-ele-estabeleceu o-sacerdote a a-mulher yhwh yhwh e-desfez a cabeça a-mulher e-dava sobre de-seus-mãos a de-mincha ela oferenda-de ciúmes ela e-com-a-mão-de o-sacerdote serão águas-de de-que-sabem os-amaldiçoados
\v 19 e-jurou ela o-sacerdote e-disse a a-mulher se não deitar-se homem a-te e-se debaixo costura impureza em-lugar-de homem-teu puro-eu de-a-gua os-amargos os-malditos as estas
\v 20 e-você que costura debaixo homem-teu e-porque se-tornou-impuro E-colocou homem sobre-ti a deitamento-seu de-modo-a-partir-de homem-teu:
\v 21 e-jurou-o o-sacerdote a a-mulher-a em-juramento a-cura e-disse o-sacerdote a-mulher yhwh yhwh te-a para-o-sopro no-meio-de em-meio-de povo-teu yhwh yhwh a joelho-teu caindo e-a ventre-teu exército-verso-final
\v 22 e-entraram as-águas os-maldizentes estes em-o-intestino-teu para-gerir ventre e-para-cair joelho-teu e-diga a-mulher amém amém
\v 23 e-escrita-faz a as-maldições os-estes o-sacerdote be-sefer u-machah a águas-de ha-marim
\v 24 ve-hishkaha a a-mulher a águas-de de-que-sabem os que amarrem u-ba'u bah as-águas os-malditos para-os-malvados-verso-final
\v 25 e-tome o-sacerdote de-mão-de a-mulher a de-mincha as-irritações e-ele-spritzou a a-oferenda yhwh yhwh e-ele-aproximou a-ela a o-altar
\v 26 e pegou-punhado o-sacerdote de a-oferenda a memorial-dela e fez-fumaça o altar-para e-depois ele-fará-beber a a-mulher a as-águas
\v 27 ve-hishkah-h a as-águas e-será se ficará-imunda e-ela-se-contorceu em-alto em-a-mulher-seu e-entraram na-ela as-águas os-maldizentes para-os-inimigos e-plantou-seu na-barriga-dele e-caiu a-perna-seu e-será a-mulher para-a-maldição em-meio-de a-sua-pena;
\v 28 e-se não e-se-tornou-impura a-mulher ela ela e-será-lavada e-semeará semente
\v 29 esta lei-de as-ciúmes que se-perderá mulher debaixo espos-a e-tornar-se-á-impura;
\v 30 ou homem que passará sobre-ele espírito ciúme e-quenear a mulher-sua e-estabelecer a yhwh diante-de yhwh e-fará a-ela o-sacerdote a todo a-torah a esta
\v 31 e-será-purificado o homem de-pecado e-a-mulher aquela carregará a seu-pecado
\c 6
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 palavra a filhos-de Israel e-dirás a-eles homem que mulher porque maravilhará para-o-dar neder nazir para-o-sacrificar-com-erva para-יהוה
\v 3 de-vinho e-escorume faz-sacrifício fermento vinho e-fermento bebida não beberá e-todo serviço não não beberá e-úvas pãoes não não comerá
\v 4 todo dias-de sua-cabeleira de-toda que ser-ará da-videira o-vinho de-a-cisterna-superior e-até não não comer
\v 5 todo os-dias neder nisro tesar não passar sobre sua-cabeça até de-enchimento será que yazir para-יהוה santo será cresça desfaça cabelo cabeça-dele
\v 6 todo dias-de seu-sacrifício a-yhwh sobre não morreu não virá
\v 7 para-seu-pai e-para-sua-mãe para-seu-irmão e-a-sua-irmã não a-eles a-eles que porque diadema Elohim-seu sobre cabeça-dele
\v 8 todo dias-de nizro-o santo ele a-yhwh
\v 9 e-quando morra morreu sobre-ele em-patente pateom e-tome cabeça nizro-o e-gilech rosho no-dia no-dia no-dia ha-shevi-i yegallechennu
\v 10 e-no-dia ha-shmini yavi-a duas torim ou segundo filhos-de yonah a o-sacerdote a entrada-de tenda-de encontro
\v 11 e-fará o-sacerdote um le-chatat ve-echad para-oferta e-perdoar sobre-ele do-que pecou sobre a-alma e-santificar no-dia cabeça-sua no-dia a-aquela
\v 12 e-consagrar para-יהוה a dias-de seu-voto e-trará sujeitai filho-de seu-ano para-a-sacrifício e-os-dias que cairão porque impuro nizro:
\v 13 e-esta lei-de ha-nazir em-dia-de melota dias-de nizro yavi ele a entrada-de tenda-de encontro
\v 14 e trouxe-próximo a qorbano la-yhwh sujeitai filho-de um tamim um uma ve-kabshah achat filha-de ano-a perfeita-a para-oferta-de-pecado e-velho- um perfeito para-paz-
\v 15 e-cesto de-maçãs farinha-a pães misturados com-o óleo e biscoitos-de não-fermentados ungidas -com-óleo e-a-oferta-de-levedura e-seu-sacrifício-das-libações
\v 16 ve-hikrib o-sacerdote diante-de yhwh e fez a pecado-dele e-a sua-oferta-queimada
\v 17 e-a o-touro fará sacrifício holocaustos- sobre sobre cesto das-pães-de-farinha e-fará o-sacerdote a oferta-sua e-a seu-sacrifício-das-libações
\v 18 e-se-barbeará o-nazir entrada-de tenda-de encontro a cabeça e-tome e-levou a cabelo-de-a cabeça nisro vênatan sobre o-fogo que sob sacrifício os-sacrifícios-de-paz
\v 19 e-tome o sacerdote a do-braço cozido-o de o-veado uma pão-azeviche uma de um e-torta-de-espessura massa-sem-aformar um vênatan sobre mãos-de o-nazir depois se-cortou-o-cabelo a nizro:
\v 20 e-ele-levantou-o aqueles o-sacerdote a-oferta-de-levantamento diante-de yhwh yhwh ele ele sobre sobre a-oferta-de-levantamento e-sobre coxa a-sacrifício-de-elevação e-depois yish-teh o-nazireu יָיַן׃
\v 21 esta lei-de o-nazireu que ele-oferecerá oferta-seu a-yhwh sobre nisro fora-de-a sua-mão atingirás sua-mão razão voto-seu que recolherá sobre fazê-lo-á sobre torat nizro:
\v 22 e-falou yhwh a Moisés dizendo
\v 23 palavra a Arão dizendo filhos-seus dizendo assim abençoar-vos a a-eles Israel dizer para-eles
\v 24 abençoe-te yhwh e te preservará
\v 25 enxergue yhwh seus rostos a-ti e o consagre
\v 26 yisa yhwh פניו a-ti e puserá a-ti a-ti
\v 27 e-os-colocaram a nome-meu sobre filhos-de Israel e-eu abençoe-os:
\c 7
\p
\v 1 e-houve em-dia quando-terminarem Moisés para-elevar a o-tabernáculo ele o-ele ele ele e-a todo utensílios-dele e-a eles e-a todo seu recipiente e-os-ungiu e-o-consagrou a-eles
\v 2 e ofereceram-los príncipes-de Israel cabeças de casa pais-deles eles príncipes-de as tribos eles os-que-estavam-de-pé sobre os que foram contados
\v 3 Va'yaví'u a seu sacrifício yhwh yhwh seis-de ovelhas-que-pastam exército e-dois dez manhã roda sobre segundo os-elevados e-boi para um e-deram eles diante-de o-tabernáculo
\v 4 E-disse yhwh a Moisés dizendo
\v 5 pegue deles e-sejam para-lavrar a avodat tenda de-encontro e dará elas a os-levitas homem yhwh serviço-seu
\v 6 E-tomou Moisés a as-rodas E-colocou o-gado E-deu eles a os-levitas
\v 7 com duas as-rodas e-את אַרְבַּ֣עַת o-bovino deu dar gerson כפי serviço-deles
\v 8 e-את quatro as-rodas e-את oito o-bovino deu dar de-melancolia em-o serviço-deles em-mão-de aitamar filho-de אַהֲרֹן o-sacerdote
\v 9 e-aos-filhos-de Coate não deu porque serviço-de a-santidade em-eles no-ombro elevam
\v 10 וַיַּקְרִ֣יבוּ os-nobres a dedicação-de o altar em-dia consagrado-o ele e-elevaram os-nobres a oferta-eles diante-de o-altar
\v 11 E-disse yhwh a Moisés um um para-o-dia um um para-o-dia eles-oferecerão a sua oferta para-a-consagração o-altar
\v 12 e-houve o que oferece no-dia o primeiro a oferenda-sua Nachshon filho-de Amminadav para-matate Judá
\v 13 וְקָרְבָּנ֞וֹ café-da-manhã- uma uma trinta e-cem peso-seu um um prata setenta siclo em-siclo a-santidade dois-eles cheios farinha-fina misturada em-o-óleo para-minha
\v 14 palma uma dez ouro cheia fumo-sacrifício
\v 15 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 16 Seir um um para-oferta-pelo-pecado
\v 17 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco atadim cinco cordeiros filhos-de ano cinco este oferenda-de Nasom filho-de Aminadabe
\v 18 no-dia o-segundo se-aproximou Netanuel filho-de Tsua príncipe-de Issachar
\v 19 ofereceu a oferta-dele uma prata uma trinta e-cem um lavatório um prata setenta siclo em-siclo a-santidade dois-eles cheios farinha-fina misturada em-o-óleo para-minha-oferta-verso-final
\v 20 palma uma dez ouro cheia fumegante-verso-final
\v 21 touro um filho-de manhã um um cordeiro-de- um filho-de seu-ano para-holocausto
\v 22 Seir um um para-oferta-pelo-pecado
\v 23 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco עַתּוּדִ֣ים cinco cordeiros filhos-de ano cinco este oferenda-de Netanel filho-de Zuar
\v 24 no-dia o-terceiro príncipe aos-filhos-de Zebulom Eliabe filho-de Helom
\v 25 sua-oferta tigela-de- uma uma trinta e-cem seu-peso um um prata setenta siclo em-siclo a-santidade os-dois cheios farinha-fina misturada em-o-óleo para-minha-oferta-verso-final
\v 26 palma uma dez ouro cheia fumegante-verso-final
\v 27 touro um filho-de manhã um um cordeiro-de- um filho-de seu-ano para-holocausto
\v 28 Seir um um para-oferta-pelo-pecado
\v 29 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas-de-tordilho cinco cordeiros filhos-de ano cinco este oferenda-de Eliabe filho-de Helom
\v 30 no-dia o-quarto príncipe aos-filhos-de Rúben Elisur filho-de Sedeur
\v 31 sua-oferta tigela-de- uma uma trinta e-cem seu-peso um um prata setenta siclo em-siclo a-santidade os-dois-eles cheios farinha-fina misturada em-o-óleo para-a-manhã
\v 32 palma uma dez ouro cheia incenso
\v 33 touro um filho-de manhã um um cordeiro-de- um filho-de seu-ano para-holocausto
\v 34 Seir um um para-oferta-pelo-pecado
\v 35 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas-de-tordilho cinco cordeiros filhos-de ano cinco este oferenda-de Elisur filho-de Sedeur
\v 36 no-dia o-quinqués príncipe aos-filhos-de Simeão Shelumiel filho-de Zurisadai
\v 37 oferta-sua tigela-de- uma uma trinta e-cem peso-seu um um prata setenta siclo em-siclo a-santidade dois-eles cheios farinha-fina misturada em-o-óleo para-minha
\v 38 palma uma dez ouro cheia fumo-sagrado
\v 39 touro um filho-de manhã um um cordeiro-de- um filho-de seu-ano para-holocausto
\v 40 Seir um um para-pecado
\v 41 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Selumiel filho-de Zurisadai
\v 42 no-dia o-sexto príncipe aos-filhos-de Gade Eliasafe filho-de Deuel
\v 43 קָרְבָּנ֖וֹ prato-de uma uma trinta e-cem מִשְׁקָלָהּ um um prata setenta siclo em-siclo a-santidade שְׁנֵיהֶם cheios farinha-fina misturada em-o-óleo para-oferta
\v 44 palma uma dez ouro cheia incenso
\v 45 touro um filho-de manhã um um kevesh- um filho-de seu-ano para-holocausto
\v 46 Seir um um para-oferta-pelo-pecado
\v 47 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco atudim cinco cordeiros filhos-de ano cinco este oferenda-de Eliasafe filho-de Deuel
\v 48 no-dia o-sétimo príncipe aos-filhos-de Efraim Elishama filho-de Amiúde
\v 49 qorbano café-da- uma uma trinta e-cem peso-dela um um prata setenta siclo em-siclo a-santidade dois-eles cheios farinha-fina misturada em-o-óleo para-minha
\v 50 palma uma dez ouro cheia fumaça
\v 51 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 52 Seir um um para-oferta-pelo-pecado
\v 53 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Elisama filho-de Amiúde
\v 54 no-dia o-oitavo príncipe aos-filhos-de Manassés Gamaliel filho-de resgate- Zur
\v 55 oferta-seu tigela-de uma uma trinta e-cem peso-dela um um prata setenta siclo em-siclo a-santidade os-dois cheios farinha-fina misturada em-o-óleo para-minha
\v 56 palma uma dez ouro cheia incenso
\v 57 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 58 Seir um um para-oferta-pelo-pecado
\v 59 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Gamaliel filho-de Zur
\v 60 no-dia o-ninth príncipe aos-filhos-de benjamim Abidã filho-de Gideoni
\v 61 sua-oferta tigela- uma uma trinta e-cem seu-peso um um prata setenta siclo em-siclo a-santidade os-dois cheios farinha-fina misturada em-o-óleo para-minha
\v 62 palma uma dez ouro cheia fumo-sacrificial
\v 63 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 64 Seir um um para-oferta-pelo-pecado
\v 65 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Abidã filho-de Gideoni
\v 66 no-dia o-tenth príncipe aos-filhos-de Dã Aiezer filho-de amisadai
\v 67 sua-oferta tigela-de- uma uma trinta e-cem seu-peso um um prata setenta siclo em-siclo a-santidade os-dois cheios farinha-fina misturada em-o-óleo para-minha
\v 68 palma uma dez ouro cheia fumo-sagrado
\v 69 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 70 Seir um um para-oferta-pelo-pecado
\v 71 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Aiezer filho-de amisadai
\v 72 em-dia-de Ashthai dez dia príncipe aos-filhos-de que Pagiel Ocrã
\v 73 sua-oferta tigela- uma uma trinta e-cem seu-peso um um prata setenta siclo em-siclo a-santidade os-dois-eles cheios farinha-fina misturada em-o-óleo para-a-manhã
\v 74 palma uma dez ouro cheia fumo-sagrado
\v 75 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 76 Seir um um para-oferta-pelo-pecado
\v 77 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Pagiel filho-de Ocrã
\v 78 em-dia-de dois dez dia príncipe aos-filhos-de Naftali Aira filho-de Enã
\v 79 sua-oferta tigela- uma uma trinta e-cem seu-peso um um prata setenta siclo em-siclo a-santidade os-dois cheios farinha-fina misturada em-o-óleo para-a-oferta-de-pão-
\v 80 palma uma dez ouro cheia incenso-
\v 81 touro um filho-de manhã um um cordeiro- um filho-de seu-ano para-holocausto
\v 82 Seir um um para-oferta-pelo-pecado
\v 83 e-para-sacrifício as-ofertas-de-paz manhã dois carneiros cinco ovelhas cinco cordeiros filhos-de ano cinco este oferenda-de Aira filho-de Enã
\v 84 esta consagra-o o-altar em-dia-de ungiu-o a-ele ele príncipes-de Israel tigelas prata duas dez de-mizráquei- prata dois dez taças ouro dois dez
\v 85 trinta e-de-cem a-tigela a-uma prata e-setenta do-mizráquei- o-primeiro todo prata os-vasos duzentos-e-cinquenta e-quatro-de centenas na-unidade-de-prata o-santuário
\v 86 copos ouro duas- dez cheias Ketoret dez dez o-copo em-siclo a-santidade todo ouro-de os-copos vinte e-cento
\v 87 todo o bezerro para a holocausto dois dez as ovelhas carneiros doze dez cordeiros filhos-de ano dois dez e seu cereal-moído e os carneiros as cabras dois dez para-oferta-pelo-pecado
\v 88 e-tudo novilhos sacrifício-de os-da-paz vinte e-quatro novilhos carneiros [אֵילִ֤ם] cabritos sessenta cordeiros filhos-de ano [שִׁשִּׁ֑ים] esta dedicação o altar atrás-de unção ele
\v 89 e-quando-entrar Moisés a tenda a-festa para-falar com-ele E-ouviu a a-ele de-cima-de a-ele de-sobre o-capitel que sobre arão os-querubins de-mezzo-a a-ele os-querubins וַיְדַבֵּ֖ר a-ele
\c 8
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 palavra a Arão a-ele a-ela em-o-levantar-você a face-de a móel face-de a-menorah iluminarão sete as-luzes
\v 3 E-fez assim Arão a face-de face-de a-menorah elevação- luzes-sua como-que yhwh yhwh a Moisés
\v 4 e isto trabalho a menorá trava- ouro até coxa-sua até ela trava- ela como-aparência yhwh mostrou- yhwh a Moisés assim fez a a manora:
\v 5 e-falou yhwh a Moisés dizendo
\v 6 qach a os-levitas de-meio-de filhos-de Israel eles a-eles
\v 7 e-assim- a-eles a-eles para-purificá-los este-o sobre-eles águas-de חטא e-removerão tesoura sobre todo bêsārâm e-lavarem nos seus vestuários e-se-tornarão-puros
\v 8 e-tomarão touro filho-de manhã e-sua-oferta farinha-de-trigo em-estado-de-mistura com-o-açúcar e-bezerro- segundo filho-de manhã  tomarei  para-oferta-pelo-pecado
\v 9 e oferecerás a os-levitas diante-de tenda reunião e reunirás a todo congregação-de filhos-de Israel
\v 10 e-aproximarás a os-levitas yhwh yhwh E-sustentem filhos-de Israel a mãos-deles sobre os-levitas
\v 11 e levantará Arão a os levitas sinalização yhwh yhwh de-com filhos-de e-sejam para-lavrar para-servir yhwh serviço-de yhwh
\v 12 e os levitas apoiarão a sobre sobre cabeça as ovelhas e farás a o-primeiro chéttā'at e-a hā'ēchād ʿōlāh a-yhwh ləkappēr sobre os-levitas
\v 13 e-vos-estabeleceis a os-levitas diante-de אַהֲרֹן velifnei seus-filhos eles a-eles oferta-elevação para-יהוה
\v 14 e-vos-separais a os-levitas de-meio-de filhos-de e-sejam e-serão a-mim os-levitas
\v 15 ואחרי־ assim entrarão para-lavrar para-servir a tenda eles e-vos-purificais eles e enfarinharás eles oferta-de-levitação
\v 16 que presentes presentes eles a-mim de-meio-de filhos-de Israel debaixo pitarat todo rehem em-primogênito todo de-filhos-de Israel eles eles para-mim
\v 17 que para-mim todo primogênito filhos-de Israel e-sobre-os-animais u-babehemah em-dia-de hakotti todo primogênito em-terra-de eles hiqdashthiti eles para-mim
\v 18 va-ekkakh a debaixo debaixo-de todo bekhor de-filhos Israel
\v 19 va-etthana a dos-Levitas netunim para-arão ulvavano de-meio filhos-de Israel para-lavrar a serviço-de filhos-de Israel em-tenda-de encontro e-perdoar sobre será Israel e-não será em-os-filhos Israel flagelo em-contato filhos-de Israel a o-santuário
\v 20 E-fez Moisés e-Aharon e-todo ádat filhos-de Israel para-os-Levitas yhwh que ordenou yhwh a-eles Moisés lálevím kén- fizeram a-eles filhos-de Israel
\v 21 e-ele-se-purificou os-levitas e-eles-lavaram em-sus-vestes e-ele-levantou Aarão eles oferta-elevação diante-de yhwh e-perdoou sobre-eles אַהֲרֹן para-fazer-santo-a-ela
\v 22 e-depois-de assim vieram para-lavrar para-abrir-trabalho a sua servidão em-tenda-de encontro diante-de אַהֲרֹן velifnei seus-filhos yhwh ordenou yhwh a Moisés a-eles os-levitas assim fizeram para-eles
\v 23 e-falou yhwh a Moisés dizendo
\v 24 esta que para-os-Levitas de-filho cinco e-vinte ano e-para-cima virá para-guardar exército em-trabalho-de tenda reunião
\v 25 e-de-filho cinquenta ano ישוב de-guarda o-trabalho e-não ya-abod ainda
\v 26 e-servirá a seu-irmão em-a-tenda encontro para guardar de-serviço não não ele-serve assim farás aos levitas em-os-serviços-deles
\c 9
\p
\v 1 e-falou yhwh a Moisés no-deserto- sinaí em-a-ano a-segunda para-saí-los da-terra-de Egito dizendo dizendo para-dizer
\v 2 e-eles-fazem filhos-de Israel a o-páscoa no-sua-celebração:
\v 3 na-quarta dez- dia no-primeiro-mês- entre entre os-dezessete-dias- ele ele em-suas-festas- conforme-toda seus-decretos- ele suas-leis- ele ele
\v 4 e-falou Moisés a filhos-de Israel para-fazer o-passo
\v 5 e-fizeram a o-Pesque em-primeiro em-quatro dia dia entre entre os-arávios em-deserto-de Si-na-y conforme-tudo que yhwh yhwh a Moisés assim fizeram filhos-de Israel
\v 6 e-houve homens que eram impuros para a alma homem e-não poderiam no-dia o-páscoa em-o-dia o-aquele e se aproximaram diante-de Moisés no-dia אַהֲרֹן no-dia a-aquela
\v 7 e-disseram os-homens esses-eles a-ele nós impuros para-a-alma homem por-que se-puseram-em-estado-de-desgraça para-não o-aproximado a yhwh yhwh no-meio-de em-meio-de filhos-de Israel
\v 8 E-disse a-eles Moisés em-standam e-eouvirei que yhwh a-vós para-vocês
\v 9 e-falou yhwh a Moisés dizendo
\v 10 palavra a filhos-de dizendo dizendo homem homem porque sera- impuro- para-a-alma ou a-vós para-vós ou para-gerações-vossas e fizer pascal para-יהוה
\v 11 בַּחֹ֨דֶשׁ o-segundo em-quatro dez dia entre das-aves eles-faziam ele sobre matzot e-amargos o-comerão
\v 12 não nós do-que-ele até não e-osso não quebrar- nele ele chuq-at o-páscoa farão a-ele
\v 13 e-o-homem que ele puro u-ve-de-rekh não foi e-se-afastará para fazer o-passo aquela a-alma que de-a-sua-povo que yhwh não não oferecerá em-o-tempo-sua pecado-o ele-levará o-homem a-aquela
\v 14 e-quando morará com-vocês estrangeiro e-fará páscoa a-yhwh segundo-a-ordem-de o-páscoa e-segundo-o-juramento-sua assim fará uma será a-vós a-vós e para o estrangeiro a-terra a-terra
\v 15 וביום levantar-á a o-tabernáculo cobriu a-névoa a o-tabernáculo le-ohel será e-no-crepúsculo será sobre o-tabernáculo כאמראה- fogo até manhã
\v 16 assim será permanente ha-eanan cobrirá e-aparencia-de noite noite
\v 17 e-conforme subida a-névoa de-cima-de a-tenda assim partirão filhos-de Israel e-no-lugar que habitará- nome o-nubloso nome acamparão filhos-de Israel
\v 18 sobre yhwh yhwh e-partirão filhos-de Israel yhwh de-seu yhwh e-acamparão todo dias-de que morará o-nublo sobre o-tabernáculo acamparão
\v 19 e-no-alongar-se o-nublo sobre o-tabernáculo dias muitos e-guardarão filhos-de yhwh a guarda-de yhwh e-não eles-partirão
\v 20 haja que será a nuvem dias número sobre o arca yhwh a boca yhwh yhwh e-sobre yhwh yhwh eles-partirão
\v 21 e há que sera a-nuvem do entardecer até manhã e a nuvem a nuvem na-manhã e se levantaram ou dia e-noite e a nuvem a nuvem e se levantaram:
\v 22 ou dias ou novo ou dias em-alongar a-nuéveis sobre o-tabernáculo para-estar-acampado sobre-ele acamparão filhos-de Israel e-não partirão e-em-sua-levantação eles-partirão
\v 23 sobre yhwh yhwh acamparão yhwh de-seu yhwh yhwh a de-guarda yhwh guardaram-se sobre de-seu yhwh por-mão-de Moisés
\c 10
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 fez a-ti dois-de chifres prata miqusha farás eles e-sejam a-ti lemikra a-congregação ulmasa a hammachanot
\v 3 e-sopram בָּהֵן venoedhu a-ti todo a-congregação a entrada-de tenda-de encontro
\v 4 e-se beachat yitqauu venoedhu a-ti hannesiim ראשׁי milhares-de Israel
\v 5 utqatem trova-alarma e-partirão os-lugares-acampamento os-que-acampam para-o-leste
\v 6 e-tocareis alarme segunda-noite e-partirão os-lugares-acampamento os-que-acampam para o timna' trova-alarma tocarão para-os-marchas-verso
\v 7 e-no-congregar a a-assembleia voces-tocareis e-não voces-clamareis-verso
\v 8 e-filhos-de Arão os-sacerdotes tocarão em-o-chifres-de-aleluia e-sejam a-vós para-a-lei eternidade para-gerações-de-vocês
\v 9 e-quando voces-vireis מִלְחָמָה na-terra-de-vosso sobre a-dura o-opressor vos e-voces-estardes-gritando em-chatzrot yhwh diante-de yhwh Elohim-vosso e-noshaatem me-oyveichechem
\v 10 e no dia sua-alegria u-bemoadeichechem u-beraashi chadshichechem utekaatem em-chatzrot sobre vossas-ofertas e-sobre zibchei shalmeicheim e-sejam a-vós lezicharon diante-de Elohim-vosso eu yhwh Elohim-vosso
\v 11 e-houve basshanah hashnith no mês- o-segundo vinte bacheshe naalah o-nubloso de-cima-de tabernáculo-de ha-edut:
\v 12 e saíram filhos-de Israel para suas viagens de-deserto-de Sinai e acampou o nuãan em-deserto-de Páran:
\v 13 e-partiram na-primeira sobre yhwh yhwh por-mão-de Moisés
\v 14 vaysa estandarte-de acampamento-de filhos-de Judá em-a-primeira para-exércitos-deles e-sobre tzava-o Nasom filho-de Aminadabe
\v 15 e-sobre exército tribo-de filhos-de Iessachar Netanel filho-de Zuar
\v 16 e-sobre exército tribo-de filhos-de Zebulom Eliabe filho-de Chelon
\v 17 e-foi-lançado ham-mishkan e-partiram filhos-de Gershom e-filhos-de Merari carregadores-de o-tabernáculo
\v 18 e-partiu estandarte-de acampamento-de reuven para-exércitos-deles e-sobre tzava-o Elisur filho-de Sedeur
\v 19 e-sobre exército tribo-de filhos-de Simeão Shelumiel filho-de tori Shaddai
\v 20 e-sobre tsva-a tribo-de filhos-de Gade Eliasafe filho-de Deuel
\v 21 ve-naseu-u ha-khatim carregadores-de o santuário ve-heqimu-u a o-tabernáculo até ba-am
\v 22 ve-nasa-a estandarte-de acampamento-de filhos-de Efraim para-exércitos-deles e-sobre tzava-o Elisama filho-de Amiúde
\v 23 e-sobre tsva-a tribo-de filhos-de Manassés Gamaliel filho-de peda-h Zur
\v 24 e-sobre tsva-a tribo-de filhos-de Benjamim Abidã filho-de gideon-i
\v 25 e acampou-se bandeira acampamento-de filhos-de Dã que reúne para-todo as acampadas para-exércitos-deles e-sobre tzava-o Aiezer filho-de Amisadai
\v 26 e-sobre exército tribo-de filhos-de que Pagiel filho-de Ocrã
\v 27 e-sobre exército tribo-de filhos-de Naftali Aira filho-de Enã
\v 28 Estas viagens filhos-de Israel para-exércitos-deles e-eles-partiram
\v 29 E-disse Moisés para-Hobab filho-de Reuel o-midianita cons- sogro Moisés partindo-eles-se nós a o-lugar disse yhwh ele ele a-vós a-vós לְכָ֤ה com-nos para-ti para-ti porque yhwh falou bom sobre Israel
\v 30 E-disse a-ele não irei que se a terra-meu e-a nascimento-meu irei.
\v 31 E-disse a por-favor deixarás que que sobre assim conheceste acampamento-nos no-deserto e-você-seja para-nós para-os-olhos
\v 32 e-foi porque andarás com-nosso e-era o-bom aquele que fará-bem yhwh com-nos e-nos-faremos-bem para-ti
\v 33 e-eles-partiram de-montanha-de yhwh o-caminho-de três-de dias e-arca em-aliança-de yhwh n-os-e-a o-caminho-de caminho três-de dias a-eles a-eles m-nu-ha-h
\v 34 v-a-an-na yhwh sobre-eles de-dia b-nas-e-a-m de o-acampamento
\v 35 e-houve b-in-so-a הָאָרֹ֖ן E-disse Moisés q-u-ma-h yhwh yhwh o-yev-e-cha v-yan-nu-su m-shen-a-e-cha de-diante-tua
\v 36 u-b-nu-ho diz-que volta-te yhwh multidões-de milhares-de Israel
\c 11
\p
\v 1 e-houve o-povo kamithaonnim mau em-orelhas-de yhwh E-ouviu yhwh e-acendeu-se sua-ira vatabe'ar- bam- yhwh e-comeste vatokhal biktshe o-acampamento
\v 2 e clamou o-povo a Moisés e-ele-orou Moisés a yhwh e-ela-senhorou-se o-fogo
\v 3 E-chamou nome-de o-lugar aquele queimadura-de porque queimada yhwh fogo yhwh
\v 4 e-a-multidão que em-meio-seu se-apaixonaram desejo e-voltaram e-eles-choraram também filhos-de Israel e-disseram quem ele-nos-alimentou carne
\v 5 lembramos a o-peixe que nós-comeremos em-Egito חִנָּ֑ם com os-espigões e-את os-abutres e-a o-capim e-a os-cenóveres e-a os-nomes-verso-final
\v 6 e-agora a-nostra-vida seca-a não-há todo sem-o a o-manne nosso olhos:
\v 7 e-o-manne como-semente- ele ele e-a-sua-olho o-bdélio o-bedolach-verso-final
\v 8 navegaram o-povo e-colherão e-moerão em-recheias ou moeram na-moenda e-cozinham em-o-paruru e façam ele de-pães e-foi o-sabor-seu como-o-gosto para-o-seio o óleo
\v 9 e-na-descida o-talho sobre noite noite descerá o-mão sobre-ele
\v 10 E-ouviu Moisés a o povo chorando para-o-sua-famílias homem para-a-porta אָהֳל֑וֹ yhwh muito yhwh muito mal Moisés mau
\v 11 E-disse Moisés a yhwh por-que por-te-imploro para-o-seu-servidor e-porque não encontrei graça em-olhos-teus para-situar a carregamento todo o-povo este sobre-mim
\v 12 e-eu quisi a todo o-povo esta se eu o-gerou-o porque diga a-mim carregue-o no-peito-teu como-que sobre a-terra a o-ninhento sobre a-te-rri-tó-ria que jures-te para-os-seus-pais
\v 13 de-onde a-mim da-carne a-dar para-todo o-povo esta porque dizendo sobre-mim dizendo dá- para-nos carne e-nos-comeremos
\v 14 não eu eu lebadí levando a que o-povo esta porque grande de-mim
\v 15 e-se k-kách-| a-t- a-mim para-mim h-r-g-n-i por-favor h-róg se encontrei graça em-olhos-teus e-a vejo-eu b-r-á-a-t-i:
\v 16 E-disse yhwh a Moisés e-s-p-h-a- para mim setenta homem dos velhos Israel que soubeste porque eles anciãos-de eles e seus juízes e tomarei a-elas a tenda encontro e se juntarão nome contigo
\v 17 e-descerrei-eu e-falarei-eu com-você nome e-arrancarei-eu de o-sopro que sobre-ti e-postarei sobre-eles e-levarão contigo em-massa o-povo tu tissa tu apenas de ti:
\v 18 e-a o-povo toamar consagrem-vos lemahar vaachaltem que porque bekitem yhwh dizendo quem quem yaakhilenu basar porque bom para-nós yhwh a-vós yhwh a-vós carne vaachaltem
\v 19 não dia um tochelun e-não dias-dois e-não- cinco dias e-não asarah dias e-não vinte dia
\v 20 até novo dias até até ele sairá de-a-vossa-face e-será a-vós para-o-estrangeiro porque porque desgostais a yhwh que em-a-vossa-mezquita dizendo dizendo por-que isto saiu-nos de-Egito
\v 21 E-disse Moisés seis-de centenas mil pé-mi o-povo eu eu em-meio-dele e-tu 'amarta carne a-eles a-eles va'aklu novo dias
\v 22 o-rebanho e-bakar será-imolado a-eles e-achou a-eles mãe a o-mar peixes-de a-eles será-coletado a-eles e achou para-eles
\v 23 E-disse yhwh a Moisés yhwh yhwh serás curta agora verás se chamará minha palavra se não
\v 24 e-saiu Moisés e-ele-falou a o-povo a yhwh yhwh e juntou-se setenta homem dos velhos o-povo eles eles em-torno-de o-tenda
\v 25 e-descer yhwh be-anan e-falou a-ele-o a-ele de ha-ruch-ha que sobre-ele E-colocou sobre setenta homem e-houve E-foi ke-no-ch sobre-eles ha-ruch-ha va-yit-nab-av-u e-não e-afirmaram-vos
\v 26 e-permaneceram dois homens-o no-acampamento nome o-primeiro [׀] e-nome-de o-segundo Midad e-foi-posta em-eles הָר֗וּחַ e-eles com-escrições e-não saíram a-tenda-a e-ele-proferiram em-o-lager
\v 27 e-correu o jovem e-revelou para-Moisés E-disse Elad e Midi proferindo no-lager
\v 28 e respondeu Yehoshua filho-de Nuun servindo Moisés de-seus-jovens E-disse Adonai Moisés encarcerando-os
\v 29 E-disse a-ele Moisés o-que-inveja tu a-mim e-quem dará todo yhwh yhwh nébiam yhwh dê yhwh a ruah-o sobre-eles
\v 30 va-yea-sef Moisés a ele ele e-os-anciãos Israel
\v 31 e-Espírito-de nas-a de-junto-de yhwh yhwh shalvim de ha-yam va-yeit-tosh sobre ha-machane dia dia assim dia dia assim em-torno-de o-acampamento ukhe-amatayim a-terra face-de a-terra
\v 32 E-levantou o-povo todo o-hoje o-aquele e-tudo na-noite dia dia o-amanhã e-eles-recolheram a a-súplica o-menor recolheu asarah a-eles e-eles-prostraram-se a-eles prostrar-se em-torno-de o-acampamento
\v 33 o-carne ainda-ele entre suas-dentes ainda-não ser-quebrado e também yhwh acendeu-se no povo e-ele-feriu yhwh no-povo ferida multiplicai muito
\v 34 E-chamou a nome-de o-lugar aquele sepulturas da-avareza porque nome enterraram a o-povo os-que-têm-desejo
\v 35 das-sepulturas da-desejo partiram o-povo courts e-foram em-as-cortes
\c 12
\p
\v 1 e falou miriam e-Aarão em-mošé sobre oelohim a-mulher a-cushi que tomou porque mulher cushi tomou
\v 2 e-disseram acaso somente em-moshe yhwh yhwh não-é também e colocaram-na yhwh E-ouviu yhwh
\v 3 e-o-homem Moisés muito de-todo muito de-toda o-homem face-de a-terra
\v 4 E-disse yhwh de-repente a Moisés e-a Arão e-a Miryā' saí-am ter-convosco a tenda de-encontro e-saíram ter-com-eles
\v 5 e-ele-descerrou yhwh em-o-pilar nuvem e-se-posicionou entrada-de haohel E-chamou Aarão e-miriam e-saíram dois-deles
\v 6 E-disse ouvi por-favor palavras-meus se yhwh profeta-vosso a-ele em-a-imagem a-ele me-revelarei em-o-sonho dare-a-falar- em-ele
\v 7 não assim servo-meu Moisés em-todo ele fiel ela
\v 8 a boca a boca dare-a-falar- nele e-aparência e-não yhwh e-imagem yhwh não e-porquê não temor-vos para-falar em-o-servidor-meu em-Moshê
\v 9 e-ele-se-irritou yhwh com-eles E-andou
\v 10 e-o-nubloso afastou-se de-cima-de a-tenda e-eis de-Miráim lepra-a como-neve e-ele-virou-se de-Aaron a de-Miráim e-eis de-lepra-a
\v 11 E-disse אַהֲרֹן a Moisés por-mim Adonai a por-favor será dada sobre-nos oferta de pecado que seja como morta e-que pecamos
\v 12 a agora seja como-morte que em-saída-seu sua-mãe mãe-dele e-ele-foi-comido metade-de de-carne-seu
\v 13 e-ele-gritou Moisés a dizendo dizendo El por-favor cura por-favor a-ela
\v 14 E-disse yhwh a Moisés e-pai-seu ele-vomitará vomitou em-a-frente-dela não eles-serão-ocultos sete-de dias ela-será-fechada shib-aat dias de-fora para-o-machane e-depois ele-será-coletado
\v 15 e-ela-fechou-se Miriam de-fora para-o-acampamento sete-de dias e-o-povo não ele-partiu até ele-foi-coletado Miriam
\v 16 e-depois eles-partiram o-povo de-a-cortes e-acamparam em-deserto-de em Paran-
\c 13
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 envia- para-ti אֲנָשִׂים e-eles-procurarão a terra Canaã que eu deu um Israel um um homem um para-o-clã אביו enviarão-os todo príncipe-de בָהֶֽם׃
\v 3 e-enviou eles Moisés do-deserto Parã sobre yhwh yhwh כֻּלּם homens topos-de filhos-de Israel eles
\v 4 e-estes de-seus-nomes para-a-tribo-de Rúben Samuá filho-de Zacur
\v 5 para-a-tribo-de Simeão שָׁפַט filho-de Horí
\v 6 para-tribo-de Judá Calebe filho-de sera-virado-verso-final
\v 7 para-tribo-de Issacar ele-redimirá filho-de José
\v 8 para-matate Efrayim Hoshe'a filho-de Nun:
\v 9 para-tribo-de Benjamim Palti filho-de Rafua'
\v 10 para-tribo-de Zebulom Gaddiel filho-de Sodi'
\v 11 para-matate José para-tribo-de Manassés Gadi filho-de Susy'
\v 12 para-tribo-de Dã Amiel- filho-de Gamaly'
\v 13 para-tribo-de que Setur filho-de Michael
\v 14 para-tribo-de Naftali Nachbi filho-de e-Fesi
\v 15 para-tribo-de Gade Geuel filho-de Maki
\v 16 Estas nomes-de os-homens que enviou Moisés para perseguir E-chamou a-terra E-chamou Moisés para-Hosea filho-de נוּן יְהוֹשֻֽׁעַ
\v 17 e-estendeu eles Moisés para-Tour a terra E-disse E-disse a-eles ALU este no-Negueb e-voces-subiram a o-monte
\v 18 וראות a a-terra que ela e-a o-povo ele sobre-ela o-forte ele se-estafrou o-pouco ele se muito
\v 19 וּמָ֣ה a-terra que ele habitou em-ela ela ela se maldade e que as cidades que ele habitante-de nelas dos acampamentos mãe em fortalezas:
\v 20 e que a-terra o óleo ela se de aroma árvore nela madeira se do-fruto-de a-terra e tomastes dias-de a-terra e os dias dias-de primícias de-uvas;
\v 21 e-ele-levantaram-se e-eles-procuraram a a-terra do-midbar- Tsìn até Rechob para-entrar חֲמָֽת
\v 22 e-subiram no-Néguev E-veio até Hevron וְשָׁ֤ם Ahímán sexto e-Talmay filhos-de o-Anaqueu e-Hebrôn sete dois foi-construída diante-de tsa'an Egito
\v 23 e-vieram até vale-de eshkol va-yikr'tu de-aqui z'mora ve-eshkol um um va-yissa'uhu ba-mot bishnayim e-de harimonim e-de ha-te'enim
\v 24 para aquele lugar aquele chamou vale-de eshkol sobre odot ha-eshkol que kartu de-lá filhos-de Israel
\v 25 e-eles-retornaram mitur a-terra ao-fim-de quarenta dia
\v 26 vayyalku e-ele-chegou a Moisés e-a Arão e-a todo congregação-de filhos-de Israel a deserto-de paran qadeshah a-terra os palavra e-a todo a-congregação vayar'um a pri a-terra
\v 27 וַיְסַפְּרוּ־ a-ele e-disseram בָּ֕אנוּ a a-terra que שְׁלַחְתָּ֑נוּ e-tambem זָבַ֨ת ela e mel a-vós e-este seu fruto
\v 28 no-entanto porque forte o-povo o-que-habitava em-a-terra e-as-cidades em-Bet-Zur muito muito e-também filhos-de o-Anaq vimos nome
\v 29 Amalek habitante na-terra do-sul e-o-Heteu e-o-Jebuseu e-o-amorreu habitante-de no monte e-o-canaanita habitou sobre o-mar e-sobre mão o-Jordão
\v 30 e-hes Kaléve a o-povo E-disse Moisés E-disse alehu subiremos veyarashnu a-ela porque yachol nuchal a-ela
\v 31 vehanashim que alu com-ele não não nuchal para-subir a ele nós força ele de-nós
\v 32 veyotziu dibbat- a-terra que taru- a-ela a filhos-de dizendo a-terra a-terra que avarnu- na-ela para perseguir terra terra okhlet- ela ele e-todo o-povo que vimos בְתוֹכָ֖הּ homens-de middot-
\v 33 e ali vimos a hannefilim- filhos-de anak- de hannefilim- vanehi- be-enenu grilos e-assim fomos em seus olhos:
\c 14
\p
\v 1 e-carregou todo a-congregação e-eles-se-tornaram a קוֹלָ֑ם e-eles-choraram o-povo na-noite a-aquela
\v 2 e-eles-lamentaram sobre Moisés e-sobre Arão todo filhos-de Israel e-ele-disseram a-para-eles todo a congregação se-não nossas-matrizes na-terra Egito ou em-o-deserto este se-não morremos
\v 3 e-porque yhwh trazendo nós-aos a a-terra esta para-cair em-espada nossas-mulheres e-nossos-filhos serão para-excesso bom bom para-nós volta de Egito:
\v 4 e-disseram homem a irmão-dele foram-dadas cabeça e-voltaríamos de Egito:
\v 5 e-caiu Moisés e-Aarão sobre peneyhem diante-de todo assembleia congregação-de filhos-de Israel
\v 6 vayehôshûa' filho-de Nun ve'kalêv filho-de yefunneh de hâtârîm a a-terra quebraram em-suas-roupas:
\v 7 e-disseram a todo dizendo a-terra Israel dizendo a-terra que passamos nela a-terra muito muito a-terra muito muito
\v 8 se desejava yhwh yhwh e-ele-trouxe nós a a-terra esta terra para-nós terra que ele fluindo-de leite e-mel
\v 9 porém בַּֽיהוָה֮ a rebelareis-vos e-vós a a-terra que povo eles porque o-nosso-pão eles desviou imagem de-sobre-eles e-יהוה com-nós a temereis-os
\v 10 e-disseram todo a-congregação eles eles em-pedras yhwh yhwh nos-apareceu em-tenda-de encontro a todo filhos-de Israel
\v 11 E-disse yhwh a Moisés até para-onde me-aborrecerão o-povo este e-até a-onde não crerão em-mim em-todo as-sinais que fiz-eu em-o-centro-dele
\v 12 conhecê-lo com-a-praga e-expulsá-los e-eeshah ot-cha le-goy- grande nós de-nós
\v 13 E-disse Moisés a yhwh e-ouvirão Egito porque subestimaste-você com-teu-poder a o-povo este de-seu-meio
\v 14 e-diretriz a a-terra a-terra esta ouviram yhwh tu yhwh בְּקֶ֖רֶב o-povo este que olho tu yhwh tu yhwh e-nuvens-teus ficou-em-pé em-eles tu nuvem אתה andou diante deles diariamente noite fogo noite
\v 15 e morreu a o-povo este um um e disseram as-nações que dizendo a escuta-te para-dizer
\v 16 por-não poderá yhwh para-trazer a o-povo este a a-eles que jurou para-eles vayishchatem no-deserto
\v 17 e-agora ele-se-grandeira- por-favor força Adonai como dizendo para-dizer
\v 18 yhwh longo de-nariz e-muita- bondade leva עון e-pash-te não não purificar-á po-qed [אָבוֹת֙] avós sobre בָּנִים sobre terços e-sobre quartos
\v 19 selach- agora [הָעָ֥ם] o-povo este ke-godel chasdekha ve-ka-asher nas-ta-tha ao-povo este de-misraim e-até até-aqui
\v 20 E-disse yhwh eu perdoei conforme a tua palavra
\v 21 e-o-átrio vive eu e-ele-cheia-se glória-de- yhwh a todo a-terra
\v 22 que todo os-homens os-vendo-os a a-glória-meu e-a as-sinais-meus que fiz em-o-Egito e-no-deserto e-eles-tentaram a-mim este dez vezes e-não ouviram na-voz-meu
\v 23 se e-veem-os a a-terra que eu-jurei não e-todo os-rejeitando-me não vejam-a
\v 24 e-meu-servo כלֵ֗ב ekev era espírito outra com-ele e-cheio depois-de-mim e-traga-o-a a a-terra que veio ali e-seu-herdeiro herdeiro-ele
\v 25 e o Amaleque e o Canaã habitante-de na-vala amanhã olhem e-parti a-vós o deserto o-caminho-de mar-de juncos
\v 26 e-falou yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 27 até מָתַ֗י para-a-congregação a-malícia-a esta que eles malinim sobre mim a tulunot filhos-de Israel que eles malinim alai shama'ti
\v 28 disse a-eles vive אנני oráculo-de yhwh se não como falastes a-vós assim fazerei para-vocês
\v 29 em-o-deserto isto é yiflu pigreichechem e-todo pqudeichechem para-todo misparchechem מִבֶּ֛ן vinte ano e-para-cima que halinotem sobre-mim
\v 30 se vós tavu a a-terra que eu-elevei a minha-mão que vos nela porque se Kalev filho-de yefunneh e Josué filho-de Nun:
\v 31 e-vosso-tipo que אֲמַרְתֶּ֖ם para-saque será e-eu-trarei eles וְיָֽדְעוּ֙ וְיָדַעֻהוּ a a-terra que de-aborrecer-vos nela
\v 32 e-corpos-vossos vós יפלוּ em-o-deserto a-esta
\v 33 e-filhos-vossos יִהְי֨וּ רֹעִ֤ים bamidbar quarenta ano וְנָשְׂא֖וּ a זְנוּתֵיכֶ֑ם até perfeição פּגְרֵיכֶ֖ם no-deserto
\v 34 בּמִסְפַּ֨ר הימים que תרטטם a dia dia dia dia לשנה dia לשנה תישאוּ a עוןיכם quarenta ano e-voces-sabereis a תנואתי׃
\v 35 eu yhwh דברתי֒ se לא ׀ esta אעשה para-todo a congregação a-malícia-a esta os jurados sobre mim em-o-deserto este serão despedaçados e ali morrerão:
\v 36 e os homens que enviou Moisés para perseguir a a-terra e voltaram sobre-ele a todo a-congregação para-sair palavra sobre a-terra
\v 37 e-morreram os-homens os que tiram דִבַּת־ a-terra maldade בַּמַּגֵּפָ֖ה yhwh yhwh
\v 38 וִיהוֹשֻׁ֣עַ filho-de Nun וְכָלֵ֖ב filho-de יְפֻנֶּ֑ה חָיוּ֙ de os-homens aqueles הַֽהֹלְכִ֖ים a-explorar a a-terra
\v 39 e-falou Moisés a as-palavras estes a todo filhos-de muito וַיִּֽתְאַבְּל֥וּ o-povo muito
\v 40 e-levantaram-cedo em-a-manhã וַיַּֽעֲל֥וּ a dizendo o-monte dizendo הִנֶּ֗נּוּ e subiremos yhwh que que disse yhwh porque pecamos
\v 41 E-disse Moisés por-que isto vós passamos a yhwh yhwh não não te suceda
\v 42 a que porque yhwh yhwh em-meio-vosso e-não sereis-feridos diante-de inimigos-vossos
\v 43 que o amalequita e o cananeu nome diante-de-vós e cairão com a espada porque sobre assim yhwh de-depois-de yhwh e-não será yhwh com-vos
\v 44 e deram para-subir a cabeça o-monte e arão em-aliança-de yhwh וּמֹשֶׁ֔ה não מָ֖שׁוּ de-meio-de o-acampamento
\v 45 e-ele-descerrou הָעֲמָלֵקִי֙ וְהַֽכְּנַעֲנִ֔י o-que-habitava na-montanha aquele וַיַּכּ֥וּם וַֽיַּכְּת֖וּם até הַֽחָרְמָֽה׃
\c 15
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 palavra a filhos-de Israel e-dirás que porque תָבֹ֗אוּ a terra מוֹשְׁבֹ֣תֵיכֶ֔ם que a-vós deu para-vocês
\v 3 e-fareis mulher a-yhwh holocausto ou זֶ֔בַח לְפַלֵּא־ נֶ֙דֶר֙ ou בִנְדָבָ֔ה ou בְּמֹעֲדֵיכֶ֑ם לַעֲשׂ֞וֹת רֵ֤יחַ agradável a-yhwh de o-bovino ou de o-rebanho
\v 4 e-ele-ofereceu o-maquive oferenda-sua para-יהוה oferta-cereais flor-farinha עִשָּׂר֔וֹן בָּל֕וּל בִּרְבִיעִ֥ית הַהִ֖ין azeite
\v 5 e vinho para o vaso quarta parte deste vinho farás sobre a-holocausto ou para o sacrifício o-primeiro o-um
\v 6 ou para a cabra farás oferenda farinha-de-trigo segundo dez misturada em-o-óleo terça parte deste vinho
\v 7 e-vinho para o vaso שְׁלִישִׁית הַהִ֑ין tu-oferecerás aroma-de tranquilidade para-יהוה
\v 8 e-quando תַעֲשֶׂה filho-de manhã holocausto ou זָ֑בַח לְפַלֵּא־ נֶ֥דֶר ou paz para-יהוה
\v 9 e-oferecerá sobre filho-de o-bovino oferenda farinha-de-trigo três dez בָּל֥וּל em-o-óleo metade-de deste vinho
\v 10 וְיַ֛יִן tu-oferecerás para-a-caneca metade a-isto mulher aroma-de agradavel para-יהוה
\v 11 assim será-feito para-o-vaca o-primeiro ou para-a-ove o-primeiro ou para-a-cabra nas-caprinos ou nas-velozes；
\v 12 como-num-contar que fazeis-vós assim fazei para-um como-multiplicidade-deles:
\v 13 todo o-azará fará- assim a estes para-oferecerem mulher aroma-de tranquilidade para-יהוה
\v 14 e-quando estrangeiro entre-vós estrangeiro ou que בְתֽוֹכְכֶם֙ para-gerações-vossas e fará mulher aroma-de tranquilidade a-yhwh como farão assim ele-fará
\v 15 o convênio lei uma a-vós e para o estrangeiro o estrangeiro estatuto-de eternidade para-gerações-vossas como vós como estrangeiro será diante-de yhwh
\v 16 torah uma e juízo um será a-vós e para o estrangeiro הַגָּ֥ר אִתְּכֶֽם׃
\v 17 e-falou yhwh a Moisés dizendo
\v 18 palavra a filhos-de Israel e-dirás a-eles בְּבֹֽאֲכֶם֙ a a-terra que eu מֵבִ֥יא vós ali
\v 19 e-será בַּאֲכָלְכֶ֖ם מִלֶּ֣חֶם a-terra תָּרִ֥ימוּ oferta a-yhwh
\v 20 רֵאשִׁית֙ עֲרִסֹ֣תֵכֶ֔ם חַלָּ֖ה Tirimú Terumá Kitrutimá Goren assim Tirimú a-ela
\v 21 Mereishít vossas-arcas vocês-serão a-yhwh Terumá Ledoroteichem:
\v 22 e-porque Tishgú e-não fareis a todo os-comandamentos estes yhwh palavra yhwh a Moisés
\v 23 a todo que yhwh yhwh a-vós pela-mão-de Moisés de yhwh que ordenou yhwh e a salvação para-gerações-de-vocês
\v 24 e-foi mãe das-olhos a congregação foi feita por inadvertência e fizeram todo a congregação touro um manhã um o holocausto por odor agradável a-yhwh e sua oferenda de farinha e sacrifício um e o carneiro- ovelhas um -de oferta de culpa:
\v 25 e-perdoar o-sacerdote sobre todo assembleia filhos-de a-eles e-perdoado-ficará ela porque Shaggáh ele e eles- -trouxeram a seu sacrifício yhwh a-יהוה e sua oferta de culpa diante-de yhwh sobre -deles:
\v 26 e perdoará para-todo a congregação filhos-de Israel e para o estrangeiro o estrangeiro que porque para-todo o-povo por engano;
\v 27 e-se uma uma se pecar por engano e trará vaca filha-de sua idade para-oferta-pelo-pecado
\v 28 e-perdoar o-sacerdote sobre a alma a que pecou por acidente em pecado em-erro yhwh yhwh para-expiar sobre-ele a-ele a-ele
\v 29 o azimut filhos-de Israel e para o estrangeiro o estrangeiro entre vós a lei uma será a-vós que faz por engano;
\v 30 e-a-alma que farás com a mão Rama de o azimut e-de ele a yhwh ele aquela e-ser-cortado a-alma a-essa de-meio-de a-sua-pena;
\v 31 que palavra-de yhwh com o báza e-a sua mandatória destruirás cortarás serás cortada aquela a-essa iniquidade em-ela
\v 32 e-foram filhos-de Israel no-deserto e-encontraram homem מְקֹשֵׁשׁ madeiras em-dia הַשַּׁבָּֽת׃
\v 33 וַיַּקְרִ֣יבוּ ele הַמֹּצְאִ֥ים ele מְקֹשֵׁשׁ עֵצִ֑ים a Moisés e-para Arão e-a todo הָעֵדָֽה׃
\v 34 וַיַּנִּ֥יחוּ ele בַּמִּשְׁמָ֑ר que não פֹרַ֔שׁ que a-ele a-ele
\v 35 E-disse yhwh a morrendo morrer será-morto o-homem ele a-ele-o em pedras todo a-congregação fora-de o-lager
\v 36 e saíram ele todo a congregação a de-fora ele e lançaram a-ele em pedras E-morreu yhwh ordenou yhwh a Moisés
\v 37 E-disse yhwh a Moisés dizendo
\v 38 palavra a filhos-de Israel e-dirás a-eles a-eles para-eles cifteh sobre asas-de nos seus vestuários para as gerações sobre cifteh a borda פֹּתִיל תְּכֵלֶת׃
\v 39 e-foi a-vós לְצִיצִת֒ וּרְאִיתֶ֣ם ele וּזְכַרְתֶּם֙ a yhwh mandamentos-de eles e-fizerdes a-eles e-não תָתֻ֜רוּ vossos-olhos para-coracoes-vos e-depois-de עֵֽינֵיכֶ֔ם que vós זֹנִ֖ים depois-deles
\v 40 para-que תִּזְכְּר֔וּ e-fizerdes a e-sereis מִצְוֺתָ֑י vehitytem kedoshim para os seus elohim:
\v 41 eu yhwh Elohim-vossos que eu tirei vos da-terra Egito a-ser a-vós para os elohim eu yhwh vosso-Elohim
\c 16
\p
\v 1 E-tomou Qorach filho-de Izhar filho-de Coate filho-de Levi e Datân e Abiram filhos-de Eliaabe e Úm filho-de Peleet filhos-de Reuven-verso
\v 2 e levantaram-se diante-de Moisés e homens filhos de Israel cinquenta e duzentos príncipes assembleia chamados encontro homens de nome
\v 3 e reuniram-se sobre Moisés e-sobre Arão e-disseram que chefe-de para vós porque todo yhwh כֻּלּם santos e-em yhwh e-por-que voc-voltareis sobre assembleia yhwh
\v 4 E-ouviu Moisés e-cairam sobre faces-suas
\v 5 e-falou a qorach dizendo manhã sua-cavalaria yhwh manhã e-saberá yhwh a-ele que para-ele e-a o-santo a-ele a-ela e-a que escolherá- nele aproximará a-ele
\v 6 esta fazei tomai para-vós cântaros  קֹ֖רַח e-todo  עֲדָתֽוֹ׃
\v 7 וּתְנ֣וּ  בָהֵ֣ן ׀  אֵ֡שׁ  וְשִׂימוּ֩  עֲלֵיהֶ֨ן ׀  קְטֹ֜רֶת diante-de yhwh amanhã yhwh o-homem que  יִבְחַ֥ר yhwh yhwh ele chefe-de a-vós filhos-de Levi
\v 8 E-disse Moisés a  קֹ֑רַח ouvi por-favor filhos-de Levi
\v 9 o-ma'at mi-kem porque hi-hibdil Elohim-de Israel vos me-eda't Israel le-hakriv a-ele para-lavrar la'avod a yhwh tabernáculo-de yhwh ve-la'amod diante-de a-congregação le-shartam
\v 10 e-aproximou ot-cha e-a todo akh-echa filhos-de Levi contigo e buscareis também a-cunha:
\v 11 portanto tu e-todo a-convocação-te@ os-a-sorteados sobre yhwh que que ele porque sobre-ele
\v 12 e-enviou Moisés para-chamar a-datan e-a-abiram filhos-de Eliabe e-disseram não nossos-pedestres:
\v 13 o-que-pequeno que e-elevaste-nos@ de-terra-de derramou leite e mel para nos matar no-deserto porque תִשׂתָרֵ֥ר sobre nós também foi dominado
\v 14 certamente não a terra sangue leite e mel nos levaria e deu-nos para-nós herança שׂדה וָכָ֑רֶם הַעֵינֵ֞י os homens não תּנַקֵּ֖ר não nossos-pedestres:
\v 15 e se fez agradável a Moisés muito E-disse a yhwh a não a um não חֲמ֨וֹר um deles eu levantei-me e-não Harua'ti a um de-eles
\v 16 E-disse Moisés a tu tu e-todo a-convocação-te@ yhwh tu yhwh tu Vahe'm e-Aarão amanhã
\v 17 Ukachu homem seu-tronco-de-fogo Uneta'tem sobre-eles Ketoret Ve'hikravtem diante-de yhwh yhwh Machatho cinquenta Um'ayim Machoth ve-a-ta-ha e-Aarão homem a-mo
\v 18 ve-yikhu homem seu-tronco-de-fogo e-eles-deram sobre-eles fogo e-os-colocaram sobre-eles fumo-de-oferenda e-va-amadu entrada-de tenda encontro e-moshe e-Aarão
\v 19 e-vay-qahel sobre-alehem qorach a todo a-congregação a entrada tenda reunião E-viu glória-de- yhwh a todo a-edah
\v 20 e-falou yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 21 se-hibdalu de-meio-de a-edah esta e-va-achaluhu eles momento:
\v 22 caíram: sobre suas-faces: e-disseram El Elohim-de הרוחות para-todo um o-homem um pecaram: e-sobre todo a-congregação levantar-se:
\v 23 e-falou yhwh a Moisés dizendo
\v 24 palavra a dizendo dizendo levantaram-se: de-ao-redor para-o-acampamento: Corá: Datan: E o Abiram:
\v 25 E-levantou Moisés E-andou a Datân e o Abiram e-caminharam atrás-dele anciãos-de Israel
\v 26 e-falou a dizendo dizendo afastem-se de-cima-de de cima as tendas dos os-homens rebelados estes e-a a-eles em-todo que para-eles para-que-não continuaram em-todo a sua culpa:
\v 27 e subiram de-cima-de do tabernáculo- קֹרֶח Datan: וַאֲבִירָּם em-o-redor e Datân e Abiram saíram נִצָּבִ֗ים פֶּ֚תַח אֽ͏ָהֳלֵיהֶ֔ם וּנְשֵׁיהֶ֥ם e-seus-filhos וְטַפָּֽם׃
\v 28 E-disse Moisés nisto sabereis porque yhwh שֶׁלַחַנִי לַעֲשׂוֹת a todo הַמְּעָשֹׂ֖ים estes porque não מִלֵּבִֽי׃
\v 29 se como mortes todo Estas יְמוּתוּן אֵלֶּה וּפְקֻדָּת֙ todo não yhwh sobre-eles não yhwh שֶׁלַחָנִי׃
\v 30 e-se בְּרִיאָה yhwh yhwh a-terra a terra a eles e engolirá a-eles e-a vida que a-eles que חיים o abismo e saberéis porque serão apertados os homens estes a yhwh
\v 31 e-houve quando ele for consumido para falar a todo as-palavras estes a-terra a terra que sob eles
\v 32 e abriu a-terra a boca-dela eles eles e-a nas suas e-a todo o homem que para Corá e-a todo a riqueza
\v 33 e desceram eles e-todo a-eles vida חיים o abismo e cobriu a-terra a-terra e-pereceram de-meio o povo
\v 34 e-todo Israel que seus redutos nassu que porque disseram a-terra tiblā'enu a-terra
\v 35 e-fogo yats'āh de-junto-de yhwh e-comeste a haḥamishšîm u'ma'ăṭayim homem maqribe haqtōret
\c 17
\p
\v 1 e-falou yhwh a Moisés dizendo
\v 2 disse a El'azar filho-de Aarão o-sacerdote ve'yarem a hamachăttoth מִבֵּ֣ין que e-a o-fogo זְרֵה־ הָ֑לְאָה porque קָדֵֽשׁוּ׃
\v 3 אֵ֡ת מַחְתּוֹת֩ הֽ͏ַחַטָּאִ֨ים ha-eleh בְּנַפְשֹׁתָ֗ם וְעָשׂ֨וּ eles רִקֻּעֵ֤י פחמים כיפוי למזבח porque הקריבו diante-de yhwh ויקדו ויהיו para-sinal para-filhos-de Israel
\v 4 E-tomou Eleazar o-sacerdote a מחות הנחושת que הקריבו השרפים e estendessem cobertura para o altar:
\v 5 lembrete aos-filhos-de Israel para-propósito-de que não virá homem estrangeiro não não da semente ele ele para-queimar incenso yhwh yhwh e-não ser-á como coraich e com a congregação dele yhwh palavra a-ele por-mão-de Moisés a-ele
\v 6 e-negaram todo congregação-de filhos-de Israel de-amanhã dizendo Moisés e-sobre Aarao yhwh vós vocês-mataram a povo yhwh
\v 7 e-houve em-reunião a-assembly sobre Moisés e-sobre Arão e-voltaram-se a tenda encontro e-eis cobriram yhwh E-viu glória yhwh
\v 8 E-veio Moisés e-Aarão a face-de tenda encontro
\v 9 e-falou yhwh a Moisés dizendo
\v 10 e-elevaram-se de-meio-de a-edah esta e-comeram eles em-breve e-caíram sobre em-seus-faces
\v 11 E-disse Moisés a Arão toma a a-ferida de-cima-de עָלֶ֨יהָ אֵ֜שׁ de-sobre o-altar וְשִׂ֣ים Ketoret וְהוֹלֵ֧ךְ מְהֵרָ֛ה a a-congregação e-perdoa yhwh porque יָצָ֥א הַקֶּ֛צֶף de-a-frente-de yhwh הֵחֵ֥ל הַנָּֽגֶף׃
\v 12 E-tomou Arão como-que palavra Moisés e-o correu a dentro-de o-a congregação e-eis começou-o a a-punhalada no-povo-o E-colocou a o-a fragrância e-o expiou sobre o-povo
\v 13 e-estabeleceu entre e-entre e-entre os-videntes e-a parou-se a-punhalada-verso
\v 14 e houveram os mortos na praga quatro dez mil e sete centenas além-de os-mortos sobre palavra-de qó-rakh
\v 15 e-ele-retornou Arão a Moisés a entrada tenda reunião e a praga foi interrompida
\v 16 e-falou yhwh a Moisés dizendo
\v 17 disse a filhos-de Israel e toma deles cetro máta lebeith pai me'et todo nesihehem para-casa-de pais-deles dois dez mattot homem a seu-nome tikhtob sobre mattehu
\v 18 e-את nome Arão tikhtob sobre tribo-de que porque um um lerosh casa avos-eus
\v 19 vehinachtem em-tenda-de reunião diante-de הָעֵד֔וּת que אִוָּעֵ֥ד a-vós ali
\v 20 e-foi o-homem que אֶבְחַר־ nele מַטֵּ֣הוּ יִפְרָ֑ח וַהֲשִׁכֹּתִ֣י מֵֽעָלַ֗י a תְּלֻנּוֹת֙ filhos-de eles que eles מַלִּינִ֖ם sobre-vós
\v 21 e-falou Moisés a filhos-de Israel a-ele אֵלָ֣יו ׀ todo נשיאיהם máta um um מטה um um para-casa-de pais-deles dois dez mattot ומטה no-meio-de em-meio-de mótuwám
\v 22 וישן Moisés a המטות yhwh yhwh na-tenda ha-edut:
\v 23 e-houve da-o E-veio Moisés a tenda העדות e-eis פרח bastao-de- Aarao para-casa-de Levi e-saiu perach e-foceu tsits e-cortou shakedim
\v 24 e-saiu Moisés a todo yhwh de-diante-de yhwh a todo filhos-de Israel e-eles-deram-conta e tomaram homem mattehu
\v 25 E-disse yhwh a Moisés hasheb a tribo-de Arão diante-de hadevedut para a guarda para-sinal para-filhos-de méri e terminem suas lamentações sobre mim e-não morram
\v 26 E-fez Moisés como ordenou yhwh ele assim fez
\v 27 e-disseram filhos-de Israel a dizendo eis eis que nos arrependemos nós morremos todos nós
\v 28 todo o que se aproxima ha-qarav a tabernáculo-de yhwh morra se é que vocês se purifiquem para tocarem
\c 18
\p
\v 1 E-disse yhwh a tu tu e seus filhos e-casa-de teu-pai com-tu vocês carreguem a iniquidade o santuário e-tu e-filhos-teu com-tu vocês carreguem a iniquidade-de sua função sacerdotal
\v 2 e-também a seu-irmão matteh- Lévi tribo-de teu-pai que-approxime-se com-tu e-ajam sobre-ti e-manter-se-ão-com-teu e-tu e-filhos-teu com-tu diante-de tenda ha-edut:
\v 3 e-guardar-se-ão de-teu-guarnecimento e-guarda todo haohel só-que a os-ferramentas-de-serviço não e-a o-altar não aproximem-se e-não yeremutu também eles também atemu:
\v 4 venilvu sobre-ti veshameuru a guarda-de tenda a-todo para-todo avodat haohel vezar não yikra a-vós
\v 5 ushamartem a de-guarda o-santuário e-a de-guarda o-altar e-não será ainda ketsef sobre filhos-de Israel
\v 6 e-eu eis tom-eu a irmãos-vossos os-levitas de-meio-de filhos-de a-vós lachem  Mitsubishi  doados para-lavrar la-avod a avodat tenda-de encontro
\v 7 e-tu e-filhos-teu com-te guardareis a vossa sacerdócio para-todo palavra o-altar e-no lar à arca e-servireis avodat  Mitsubishi  אֶתּוֹ a כְּהֻנָּתְכֶ֔ם e-o-estranho o-que-se-aproxima será-morto
\v 8 e-falou yhwh a Aharon- eis dei a-ti para-ti a guarda-de תְּרוּמֹתַ֑י a-ti קָדְשׁוֹ filhos-de Israel לְךָ֨ נְתַתֶּם לְמָשְׁחָה e-aos-seus-filhos por-tempo eternidade
\v 9 este- a-ti para-ti מִקֹּדֶשׁ הַקֳּדָשִׁ֖ים de o-fogo todo קָ֠רְבֻּנָם para-todo מִנְחָתָם e-para-todo- חַטָּאתָם e-para-todo- a-ti ele יָשִׁ֣יבוּ para-mim santo-de קָֽדָשִׁ֥ים para-ti ele וּלְבָנֶֽיךָ׃
\v 10 בְּקֹ֥דֶשׁ הַקֳּדָשִׁ֖ים תֹּאכֲלֶ֑נּוּ todo macho ele a-ele santidade ele-será- para-ti
\v 11 e-este לְּךָ֞ oferta-de מַתָּנָ֗ם para-todo תּוֹנֻפֹת a-ti Israel para-ti נְתַתֶּ֣יךָ וְלִבְנֵ֥י וְלִבְנוֹתֵיכֶ֖ם contigo por-tempo eternidade ele puro em-casa-tua comerá a-ele
\v 12 todo חֵּ֣לֶב Yit-shar e-todo gordura תִּירוֹשׁ וְדַגַּֽן רֵאשִׁ֤יתָם que a-ti a-yhwh para-ti נְתַתֶּ֣יךָ׃
\v 13 בְּכֻרֵ֤י todo que em-terra que a-ti será para-ti yihye todo puro em-casa-tua comerão
\v 14 todo herem a-ti será será
\v 15 todo pêter rechem para-todo carne que e-sobre-os-animais para-יהוה em-homem e-com-o-gado ele-será- para-ti somente pede o-homem את primogênito-de o-homem e-a em-o-primeiro-nato a-animais o-imundo tífdeh
\v 16 úpfdúyav de-filho-de novo tífdeh b'urkakkha prata cinco-de escalam em-siclo a-santidade vinte ele ela
\v 17 porém b'bkór- shór ou b'bkór keshév não b'bkór 'ez eles você livrará santo-de eles a o sangue deles tu lançarás sobre o-altar e-a seu óleo tu ungi mulher para-aroma tranquilidade para-יהוה
\v 18 e a carne deles ser- para-ti como a visão a oferta de levita e o desejo a-ti será será
\v 19 todas ofertas os-santos que irámu filhos-de Israel para-יהוה dei a-ti úlebánécha vélibnóteicha contigo por-tempo eternidade beríth eternidade ela ela-foi yhwh a-ti a-ti úlezáraz'acha contigo
\v 20 E-disse yhwh a Arão não não tinhal vécheléq a-ti será a-ti entre vós eu no-meio-de vénaḥlát'echa em-meio-de filhos-de Israel
\v 21 e-para-filhos-de Levi eis dei todo maʿásér em-Israel para herança substituição sua servidão que eles servos a avodat tenda-de encontro
\v 22 e-não se aproximem ainda filhos-de Israel a tenda reunião para-levar pecado para a morte
\v 23 e servir-se-ão o levita ele a serviço-dele tenda encontro e-eles levem עֲוֺנָ֑ם eternidade eterno para-gerações-vossas e-dentro filhos-de não não herdarão herança
\v 24 que a dezimo filhos-de Israel que levantar-se-ão dei oferta dei aos levitas para herança a-eles no-meio-de eu-disse a-eles não filhos-de Israel não herdarão herança
\v 25 e-falou yhwh a Moisés dizendo
\v 26 e-a os levitas diga e-dirás אֲלֵהֶם֒ porque תִ֠קְחוּ de-a filhos-de dei a-vós הַֽמַּעֲשֵׂ֗ר que נָתַ֧תִּי nós מֵאִתָּ֖ם yhwh וַהֲרֵמֹתֶ֤ם do-que-ele yhwh decimo de הַֽמַּעֲשֵֽׂר׃
\v 27 וְנֶחְשַׁ֥ב a-vós תְּרוּמַתְכֶ֑ם כַּדָּגָן֙ de הַגֹּ֔רֶן וְכַֽמְלֵאָ֖ה de a-cavidade:
\v 28 assim תָּרִ֤ימוּ também vós yhwh de-toda de-todo a vossas décimas que תִּקְח֔וּ de-com filhos-de Israel nós do-que-ele yhwh oferta-de yhwh para-Aarão o-sacerdote
\v 29 de-toda a vossos donativos תָּרִ֕ימוּ a todo yhwh yhwh de-todo nós a מִקְדְּשׁ֖וֹ de-nós
\v 30 e-dirás a-eles בַּהֲרִֽימְכֶ֤ם a nós dele וְנֶחְשַׁב֙ aos levitas kituba'at goren e kituba'at jaque:
\v 31 e-voces-comeram ele em-todo lugar vós e vossa casa ele a-vós ele a-vós substituição vossa obra em-tenda encontro
\v 32 e-não levantai-vos sobre-ele erro levantastes-vos nós gordura-sua de-ele não santos filhos-de Israel não desvendastes e-não morrais;
\c 19
\p
\v 1 e-falou yhwh a Moisés dizendo אַהֲרֹן para-dizer
\v 2 esta lei ha-torah que yhwh dizendo dizendo disse a filhos-de Israel e-eles-tomem a-te frutificai vermelho puro que não-há nela מום que não subiu sobre-ela sobre
\v 3 ונתתם a-ela a Elazar o-sacerdote e-sairá a-ela a de-fora para-o-machane e-ele-degolará a-ela diante-de-ele
\v 4 e-tome אלעזר o-sacerdote מדמהה בקצבעהו e-aspergirá a face-de face-de tenda-de encontro מדמהה sete vezes
\v 5 e-queimará a הפרה לאعينו a עוריה e-a בשרתה e-a dama-hu sobre פרשה ישורף׃
\v 6 e-tome o-sacerdote árvore ארז ואזוב ושני tela e arremessou a em fogueira da vaca
\v 7 e enxaguou suas vestes o-sacerdote e lavou seu corpo em água e-depois virá a o-acampamento e-o-contaminará o-sacerdote até no entardecer
\v 8 e o queimou a-ela היה-מכס בגדיו em água e-lavará a-carne-dele nas-águas ויטמא até הערבה׃
\v 9 ואסף homem טהור a אפר הפרה והניח de-fora para-o-acampamento em-o-loco puro והיהת לאדת filhos-de Israel לְמִשְׁמֶ֛רֶת לְמֵ֥י נִדָּ֖ה חַטָּ֥את ela
\v 10 וְ֠כִבֶּס הָאֹסֵ֨ף a אֵ֤פֶר הַפָּרָה֙ a as-roupas-seu וְטָמֵ֖א até a-tarde וְֽהָיְתָ֞ה aos-filhos-de Israel e-no ger eternidade no-entre-vocês para-a-lei eternidade
\v 11 da-pessoa-que-tocou no-morte para-todo homem homem e-impuro sete dias
\v 12 ele será-limpo- no-dia no-dia o-terceiro e no dia ha-shevi-i será-limpo e-se no-dia será purificado no dia o terceiro não ha-shevi-i não será purificado
\v 13 todo o que tocou em morto o-homem o-homem que morre e-não yhwh a tabernáculo yhwh aquela e-ser-cortado que a-essa de-Israel porque água menstruação será זֹרַ֤ק sobre-ele nele será a-ele טֻמְאָת֥וֹ nele-verso
\v 14 esta ha-torah homem porque יָמ֣וּת בְּאֹ֑הֶל todo הַבּ֤א a הָאֹ֙הֶל֙ e-todo que בָּאֹ֔הֶל ele-se-tornará-impuro sete dias
\v 15 e-tudo instrumento פָת֔וּחַ que não-há צָמִ֥יד פָּתִ֖יל sobre-ele ele ela
\v 16 e-tudo que irá sobre face-de o-campo no santuário- espada homem na morte ou em homem ou no sepulcro ele-se-tornará-impuro sete dias
\v 17 e-tomarão para se tornar impuro do pó de queimadura a-oferta-pelo-pecado e colocou sobre-ele águas vida a כֶּֽלִי׃
\v 18 e-tome arqueiro e imergir בַּמַּיִם֮ homem טָהוֹר֒ וְהִזָּ֤ה sobre הָאֹ֙הֶל֙ e-sobre todo os-vasos e-sobre הַנְּפָשׁ֖וֹת que foram- nome e-sobre הַנֹּגֵ֗עַ בַּעֶ֙צֶם֙ ou בֶֽחָלָ֔ל ou בַמֵּ֖ת ou בַקָּֽבֶר׃
\v 19 e separou o puro sobre no-dia no-dia o terceiro e-no-dia o sétimo no-dia no-dia o-sétimo e lavou suas vestes e-lavará nas-aguas e purificou no-o-crepúsculo
\v 20 e-homem que será contaminado e-não será santificado e-ser-cortado aquela a-essa do-meio-de que porque yhwh santuário yhwh tame águas-de niddah não ele sobre-ele a-vós ela
\v 21 e-será lhem para a lei eternidade e este águas-de niddah purificará as-roupas-seu e o que tocou em-águas-de a niddah ele-se-tornará-impuro até no entanto
\v 22 e-tudo que [הַטָּמֵ֖א] [יִטְמָ֑א] [וְהַנֶּ֥פֶשׁ] [הַנֹּגַ֖עַת] [תִּטְמָ֥א] [עַד־הָעָֽרֶב׃] até
\c 20
\p
\v 1 e-vieram filhos-de Israel todo הָ֨עֵדָ֤ה no deserto- צִן֙ no-mês הָֽרִאשׁ֔וֹן e-habitou o-povo בְּקָדֵ֑שׁ e-morreu nome Miryā' Vatikkāber nome
\v 2 e-não águas águas Lāʿēdāh Vayikkāhalū sobre Moisés e-sobre Aharon
\v 3 Vayyarēb o-povo com Moisés dizendo dizendo Ve'lū Gāvānū Biggāʿ Akhēnu yhwh yhwh
\v 4 [וְלָמָ֤ה] [הֲבֵאתֶם֙] a yhwh yhwh a [לָמ֣וּת] este [אֲנַ֖חְנוּ] nome
\v 5 וְלָמָ֤ה הֶֽעֱלִיתֻ֙נוּ֙ do-Egito לְהָבִ֣יא a-nós a o-lugar a-má não לא ׀ lugar semente וּתְאֵנָ֤ה וְגֶ֙פֶן֙ וְרִמּ֔וֹן e-aquém não-havia lishtho
\v 6 E-veio Moisés e-Aharon de-diante-de o-a congregação a porta-de tenda encontro e-caíram sobre peneyhem E-viu glória-de- yhwh a-eles
\v 7 e-falou yhwh a Moisés
\v 8 toma a o-a vara e-reúne-te tu a-as assembleias tu e-Aharôn irmão-teu e-convirais a o-a pedra le-einehem a-eles águas וְהוֹצֵאתָ֨ a-eles águas de o-a pedra e-irrigará-vos a a-congregação e-a na-as Urã
\v 9 E-tomou Moisés a o mâtê yhwh yhwh como ordenou-o
\v 10 vayiqhûlû Moisés e-Aharon a a-congregação a E-disse a-eles E-disse a-eles ouvi por-favor os môrîm a-vós o-sela esta nôtsi'â a-vós águas
\v 11 vayyârêm Moisés a mão-sua vayyakkh a o sêlakh com o mâtê-hû águas vayyats'û águas muitos vatash'tô a-congregação e em Ur:
\v 12 E-disse yhwh a Moisés e-a Aharon- porque não vocês crístes em-mim para santificá-me aos-olhos-de não Israel portanto não trouvéis a a-eles esta a a-terra que dei para-eles
\v 13 eles águas-de em Meribá que רבו filhos-de Israel a yhwh e foi santificado em-eles
\v 14 e-enviou Moisés מלאכים santificação a rei Edom disse disse אָחִ֣יךָ tu tu soubeste a todo a tentação que e nos acharam
\v 15 e desceram nos pais Egito-para e-nos-abrigamos em-Egito dias muitos e-levaram-no-nós para-nós Egito e-para-os-pais-nossos:
\v 16 e-chamamos a yhwh E-ouviu nossa-voz e-enviou an anjo e-nos-saiu de-Egito e-eis nós em-sanidade cidade extremidade no-seu-limite:
\v 17 nós-fomos-queimados- agora não não נַעֲבֹר֙ em-campo וּבְכֶ֔רֶם e-não נִשְׁתֶּ֖ה águas-de o-caminho-de caminho o-rei não não נִטֶּה֙ direita até até que נַעֲבֹ֖ר גְּבוּלֶֽךָ׃
\v 18 E-disse a-ele Edom não passes em-mim para-que-não com-a-espada אֵצֵ֥א לִקְרָאתֶֽךָ׃
\v 19 e-disseram a-ele filhos-de Israel בַּֽמְסִלָּ֣ה נַעֲלֶה֒ e-se dos-teus-mãos nós-berremos eu e-das-minhas e-eu-darei das-mãos somente não-há palavra com-meus-pés eu-passarei
\v 20 E-disse não passem e-saiu Edom ao-encontro-dele no-povo pesado e-na-mão forte
\v 21 e recusou-se Edom deu a Israel passar por seu limite e-virou Israel dele
\v 22 e-partiram desde o Santuário e chegaram a filhos-de Israel todo a-congregação Hor a-montanha
\v 23 E-disse yhwh a Moisés e-a Aarao em Hor o-monte dizendo fronteira-de terra-de Edom para-dizer
\v 24 se juntou Arão a que não não virá a dei que dei sobre Israel sobre que meritem a o meu lamei mərivá:
\v 25 qach a Arão e-a Elazar eles veha'ala eles hor a-montanha
\v 26 vehapshet a Arão a as-roupas-seu vehilbashtam a Eleazar filho-seu e-Aharon ye'asaf e-ele-morreu nome
\v 27 E-fez Moisés como ordenou yhwh e-eles-subiram a hor o-monte aos-olhos-de todo הָעֵדָֽה׃
\v 28 e estendeu Moisés a Arão a eles e vestiu eles a Eleazar seu-filho E-morreu Aarao nome na-cabeça o-monte e desceu Moisés Elazar de a-montanha
\v 29 e-eles-viram todo que porque tremeu Aarão e choraram a dia trinta dia todo casa Israel
\c 21
\p
\v 1 E-ouviu o cananeu rei-de Arad habitou que porque veio o-caminho-de caminho os atarim e lutou em-Israel e-o havia-se nós sevi:
\v 2 e-darrou Israel neder a-yhwh E-disse se deu dar-ias-te a o-povo este por-mi e-acharrei-te a suas-cidades:
\v 3 E-ouviu yhwh com-voz Israel E-colocou a o-kenaani e-acharrou a-eles E-chamou suas-cidades E-chamou nome-de o-lugar Hormá
\v 4 e saíram do monte o-montanha o-caminho-de mar-de Suf [אֶת־אֶ֣רֶץ] a terra Edom e faltou alma-de o-povo no-caminho
\v 5 e-falou o-povo em Elohim, e em Moisés, por-que levai-nos do-Egito para-morrer no-deserto que não-há pão e-não-há águas e nossas almas faltou em pão o queleque:
\v 6 e enviou yhwh no povo a as serpentes as ardentes e picaram a o-povo E-morreu com muito מִיִּשְׂרָאֵֽל׃
\v 7 E-veio o-povo a Moisés e-disseram nos arrependemos porque falamos em-יהוה e a ti intercede a yhwh וְיָסֵ֥ר מֵעָלֵ֖ינוּ a הַנָּחָ֑שׁ e-ele-orou Moisés por-causa-de o-povo
\v 8 E-disse yhwh a Moisés a-ti a-ti שָׂרָ֔ף ele ele sobre נֵ֑ס e-foi ele הַנָּשׁ֔וּךְ bom a-ele e-viveu
\v 9 E-fez Moisés נְחַ֣שׁ bronze וַיְשִׂמֵ֖הוּ sobre הַנֵּ֑ס e-foi se נָשַׁ֤ךְ o nāchāš a homem e olhou a nāchāš a nāchōšet e-viveu
\v 10 e-partiram filhos-de Israel e-acamparam nas ōvot
\v 11 e-partiram de ōvot e acamaram-se nas uiyê os abarim bamidbar que sobre face-de Moabe do mizraḥ o-sol
\v 12 de-lá NASAU e-acamparam BENACHAL Zerede
\v 13 MISHAM NASAU VA'YACHNU ME'EBER ARNON que no-deserto HAYOTZEA MIGVUL HA'EMORI que ארנון fronteira Moabe entre Moabe e-entre o-amorreu
\v 14 sobre [יֵֽאָמַ֔ר] [בְּסֵ֖פֶר] [מִלְחֲמֹ֣ת] yhwh yhwh a [וְאֶת־הַנְּחָלִ֖ים] [אַרְנֽוֹן] e-[OBJ]
\v 15 ואשעד הנהליים que na-tah לשבט ער וְנִשְׁעַ֖ן לִגְב֥וּל Moabe
\v 16 e-de-lá בְּאֵ֑רָה ela הַבְּאֵ֗ר que disse yhwh לְמֹשֶׁ֔ה אֱסֹף֙ a o-povo a-eles a-eles águas
\v 17 então יָשִׁ֣יר Israel a הַשִּׁירָ֖ה esta עֲלִ֥י בְאֵ֖ר anu- a-ela
\v 18 be'er chafaruhah sarim karuhah nedivei o-povo bimakhokek bemish'anaotam וּמִמִּדְבָּר matnah
\v 19 u-mimatnah נַחֲלִיאֵ֑ל וּמִנַּחֲלִיאֵ֖ל בָּמֽוֹת׃
\v 20 [וּמִבָּמ֗וֹת] [הַגַּיְא֙] que [בִּשְׂדֵ֣ה] Moabe cabeça [הַפִּסְגָּ֑ה] [וְנִשְׁקָ֖פָה] sobre face-de
\v 21 e-estendeu Israel mensageiros a סִיחֹ֥ן dizendo o-amorreu para-dizer
\v 22 passarei בְאַרְצֶ֗ךָ não נִטֶּה֙ em-campo וּבְכֶ֔רֶם não נִשְׁתֶּ֖ה águas-de בְאֵ֑ר בְּדֶ֤רֶךְ o-rei iremos até que נַעֲבֹ֖ר גְּבֻלֶֽךָ׃
\v 23 e-não deu סִיחֹ֣ן a Israel עֲבֹ֣ר בִּגְבֻלוֹ֒ וַיֶּאֱסֹ֨ף סיחון a todo povo-dele e-saiu para Israel הַמִדְבָּרָה E-veio יָהְצָה וַיִּלָּחֶם em-Israel
\v 24 e-ferrou-o Israel à-boca-de espada וַיִּירַשׁ a sua-terra מֵאַרְנֹן até que até filhos-de Amom porque עַז guvul filhos-de Amon
\v 25 E-tomou Israel a todo as-cidades estes e-habitou Israel em-todo cidades-de o amorreu בְּחֶשְׁבּוֹן e-em-todo בְּנֹתֶיהָ׃
\v 26 que Hesbom cidade סיחון rei o-amorreu ela e-ele נִלְחַ֗ם בְּמֶ֤לֶךְ Moabe הָֽרִאשׁ֔וֹן E-tomou a todo אַרְצ֛וֹ מִיָּד֖וֹ até אַרְנֹֽן׃
\v 27 sobre assim dirao הַמֹּשְׁלִ֖ים בֹּ֣אוּ Hesbom תִּבָּנֶ֥ה וְתִכּוֹנֵ֖ן cidade סיחון׃
\v 28 porque fogo יָצְאָה מֵחֶשְׁבּוֹן לֶהָבָה de-Quiriate סִיחֹן אָכְלָה֙ עָר Moabe בעלים בּamoֹת אַרְנֹן׃
\v 29 אוֹי־ a-ti Moabe אבדת dar como-mosh deu seus-filhos פליטים ובנותיו בשbit para-rei-de אמורי סיחון׃
\v 30 ונيراָם אביד חֶשְׁבּוֹן até דיבון e-nashim até no-pach até me-idba:
\v 31 e-habitou Israel em-terra-de o-amorreu
\v 32 e-estendeu Moisés leraggel a yaazer e-eles-conquistaram benotayha a ha-amori que nome
\v 33 e-voltaram-se va-yala'u o-caminho-de Basã e-saiu Ogue rei-de Basã ele ele e-todo povo-dele que Edrei
\v 34 E-disse yhwh a Moisés ele que a-ele dei ele נָתַ֧תִּי ele e-a para-ele amav e-a terra-dele e-farás a-ele como fizeste a-Siom rei o amorreu que habitante em-Hesbom
\v 35 e-eles-feriram ele e-a filhos-dele e-a todo seu-povo até para-não deixar-restar para-ele sarayid e-possuíram a terra-dele
\c 22
\p
\v 1 e-partiram filhos-de Israel e-acamparam בְּעַֽרְב֣וֹת Moabe מעבר לְיַרְדֵּ֥ן יְרֵחֽוֹ׃
\v 2 E-viu [בָּלָ֖ק] filho-de [OBJ] a todo que fez Israel
\v 3 וַיָּ֨גָר Moabe de-diante-de o-povo muito que chefe-de ele וַיָּ֣קָץ de-diante-de de-diante-de filhos-de Israel
\v 4 E-disse Moabe a anciaos-de Midiã עַתָּ֞ה יְלַחֲךֵ֤י o convocados a todo nos arredores verde השור a verdejo o-campo e Balac filho-de aquela rei le-moav em-o tempo aquela
\v 5 e-enviou anjos a Balaão filho-de em Avo Potora terra sobre o rio dizendo eis seu povo sair a-ele eis eis que povo a-terra de-Egito eis כיסאה a olho a-terra e-ele habitou [sem-traducao]
\v 6 e-agora [לְכָה־נָּ֨א] [אָֽרָה־לִּ֜י] [אֶת־הָעָ֣ם] [הַזֶּ֗ה] a ele este porque [אוּכַל֙] [נַכֶּה־בּ֔וֹ] [וַאֲגָרְשֶׁ֖נּוּ] [מִן־הָאָ֑רֶץ] que [יָדַ֗עְתִּי] nele [אֲשֶׁר־תְּבָרֵךְ֙] de a-terra porque [יוּאָֽר] [OBJ] que
\v 7 e-foram זִקְנֵ֤י Moabe e-os-idosos Midian וּקְסָמִ֖ים em-mão-deles e-vieram a בִּלְעָ֔ם a-ele a-ele palavras-de בָלָֽק׃
\v 8 E-disse a-eles לִ֤ינוּ aqui a-noite וַהֲשִׁבֹתִ֤י vos palavra como יְדַבֵּר yhwh a-mim e-habitaram senhores-de- Moabe com בִּלְעָם׃
\v 9 E-veio Elohim a E-disse quem מִ֛י os homens contigo
\v 10 E-disse [בִּלְעָ֖ם] a o-Elohim [בֶּן־צִפֹּ֛ר] filho-de [מוֹאָ֖ב] rei Moabe enviou
\v 11 eis o-povo הַיֹּצֵ֣א do-Egito וַיְכַ֖ס a a-terra a-terra agora לְכָ֤ה ele para-mim a-ele talvez אוּכַ֛ל para-lutar nele e-o-gerar-s-tei:
\v 12 E-disse Elohim a não andarás תלך não não ta-or que o-povo ele -bar-kh ela
\v 13 E-levantou -bil-ay-am de-manhã E-disse a príncipes-de -bal-ak ide que -ar-tse-khem yhwh -me-ay-en yhwh -le-ti-ti -la-ha-lo-kh com-vos
\v 14 va-y-qa-ru-mu príncipes-de Moabe e-vieram a בלָק e-disseram מֵאֵ֥ן בִּלְעָ֖ם andou com-nosso:
\v 15 e-continuou ainda בלָק enviou sārim muitos וְנִכְבָּדִ֖ים destas
\v 16 [וַיָּבֹ֖אוּ] a [וַיֹּ֣אמְרוּ] a-ele [כֹּ֤ה] disse disse [בֶּן־צִפּ֔וֹר] filho-de [תִמָּנַ֖ע] a por-favor
\v 17 porque כABBד muito e-tudo e-todo que dizerás a-mim אֶעֱשֶׂה וּלְכָה- agora קָבָה- para-mim a o-povo a-esta
\v 18 e-respondeu balac E-disse a servos-de -bal-ak se dê para-mim בָּלָק enchei não prata וְזָהָב não yhwh לַעֲבֹר֙ a boca-minha yhwh meu-Elohim para-fazer קְטַנָה ou גְדוֹלָה׃
\v 19 e-agora שָׁבוּ por-favor בָּזֶה também a-noite a-noite וְאֵ֣דְעָה yhwh יָסַף yhwh palavra comigo
\v 20 E-veio Elohim a בִּלְעָם֮ noite E-disse a-ele se a-ti a-ti vieram os-homens levantou vai com-eles וְאַ֗ךְ a a-palavra ele falarei a-ti ele תַעֲשֶׂה׃
\v 21 E-levantou [בִּלְעָם֙] de-manhã [וַֽיַּחֲבֹ֖שׁ] a [וַיֵּ֖לֶךְ] E-andou com
\v 22 e-acendeu-se- certamente Elohim ele andando E yhwh anjo yhwh a-ele adversário a-ele e-ele monta sobre seu-ásvo e-dois-de seus-jovens com-ele
\v 23 E-viu o-ásvo a yhwh yhwh estava-parado no-caminho e sua espada cortou em-mão-de-ele inclinou-se o-ásvo de ela foi no-campo e-ele-feriu Balaão a a avestruz para atirá-la הַדָּֽרֶךְ׃
\v 24 e-yaa-amod anjo yhwh no abismo dos vinhedos o muro de-este e o muro deste-lado
\v 25 E-viu a avestruz a yhwh yhwh ela foi pressionada a הַקִּ֔יר ela foi pressionada a perna Balaão a haqir e-foz para matá-la:
\v 26 e-foz anjo-de yhwh passar e-yaa-amod em-o-loco estreito que não-há caminho para se inclinar direita e-esquerda
\v 27 E-viu a-avã a yhwh yhwh debaixo debaixo-de bilã-am e-acendeu-se- tambem bilã-am e-feriu a a-avã no-palmo:
\v 28 e-abri yhwh a boca-de E-disse e ela disse para-Balaão a-ti que a-ti porque bateu-me este três pés:
\v 29 E-disse Balaão para-o-avestruz que exaltou-se em-mim se há espada que porque agora mataste-te:
\v 30 E-disse a egípcia a balac eu eu a tua egípcia que cavalguei עָלַ֗י desde o teu até o-dia este a-ti acampei E-disse não כֹּ֑ה E-disse não
\v 31 e revelou-se yhwh a os-olhos-de E-viu E-viu yhwh mensageiro-de yhwh estava de pé em-a-caminho e-sua-espada sela na-sua-mão e ardeu e-prostrou-se para o seu fogo:
\v 32 E-disse a-ele anjo yhwh sobre o-que bateste a em teu jumento este eis eu eis eu eu-saí para o diabo porque e arrastou o-caminho לְנֶגְדִּי׃
\v 33 e vi eu a-jumenta e estendeu diante-de-mim este três as pernas talvez e estendi [מִפָּנַ֔י] que עַתָּ֛ה também [הָרַ֖גְתִּי] [וְאוֹתָ֥הּ] e aquela [sem-traducao]
\v 34 E-disse bil'ám a yhwh yhwh que não não que tu tu stood [בַּדָּ֑רֶךְ] e-agora e-agora se mau a-mim [sem-traducao] a-mim
\v 35 E-disse anjo-de yhwh a balac vai com os-homens [אֲשֶׁר־אֲדַבֵּ֥ר] a ele que falarei a-ti a-ele דַבֵּר E-andou בִּלְעָם com príncipes-de בָלָק׃
\v 36 E-ouviu בָלָק׃ que veio בִּלְעָם e-saiu לִקְרָאתֹ a cidade Moabe que sobre fronteira Arnon que בִּקְצֵה a-fronteira
\v 37 E-disse בָלָק׃ a בִּלְעָם הֲלֹא֩ enviou shalachti a-ti para-chamar- para-ti por-que não não a-mim o-aumenta-se-realmente- não posso como-sua-glória:
\v 38 E-disse bil'ám a balak eis-que- eu-vim- a-ti agora poderia posso palavra coisa-alguma a-palavra que ser-feitos- ele por-me ele אֲדַבֵּֽר׃
\v 39 E-andou בִּלְעָ֖ם com בָּלָ֑ק e-vieram Quiriate חֻצֽוֹת׃
\v 40 e-ele-imolou בָּלָ֖ק manhã וָצֹ֑אן וַיְשַׁלַּ֣ח לְבִלְעָ֔ם וְלַשָּׂרִ֖ים que com-ele
\v 41 e-houve em-a-manhã E-tomou בָּלָק֙ a בלעם ויהלוּ nas cavernas E-viu E-viu de-lá extremidade o-povo
\c 23
\p
\v 1 E-disse בלעם a בלק בנה- para-mim בוזה sete Mizbóqot והכן para-mim neste sete פָרִ֖ים e-sete איילים׃
\v 2 E-fez בלק como palavra בלעם e-subiu בלק וּבִלְעָם פר ואיל em-o-altar
\v 3 E-disse [בִּלְעָ֜ם] [לְבָלָ֗ק] [הִתְיַצֵּב֮] sobre [וְאֵֽלְכָ֗ה] [אוּלַ֞י] [יִקָּרֵ֤ה] yhwh yhwh [וּדְבַ֥ר] [מַה־יַּרְאֵ֖נִי] que para-ti [וַיֵּ֖לֶךְ] a-ti E-andou
\v 4 וַיִּקָּ֥ר Elohim a E-disse a-ele a-ele a shib-aat הַֽמִּזְבְּחֹת֙ עָרַ֔כְתִּי וָאַ֛עַל פָּ֥ר וָאַ֖יִל em-o-altar
\v 5 e-ele-posto yhwh palavra בְּפִ֣י בִלְעָ֑ם E-disse volta a בָּלָ֖ק e-assim תְדַבֵּֽר׃
\v 6 e-estabeleceu-se a-ele e-eis está-postado sobre ele ele e-todo príncipes-de Moabe
\v 7 e-levantou [מְשָׁל֖וֹ] E-disse de [יַנְחֵ֨נִי] [בָלָ֤ק] [מֶֽלֶךְ־מוֹאָב֙] rei-de [לְכָה֙] [אָֽרָה־לִּ֣י] [יַעֲקֹ֔ב] [וּלְכָ֖ה] [זֹעֲמָ֥ה] [יִשְׂרָאֵֽל] Jacó Israel
\v 8 que אֵקֹב não קְבֹה El וּמָה אֵזֹם não זָעַם yhwh
\v 9 porque [צֻרִים֙] [אֶרְאֶ֔נּוּ] [וּמִגְּבָע֖וֹת] [אֲשׁוּרֶ֑נּוּ] [הֶן־עָם֙] [לְבָדָ֣ד] povo [וּבַגּוֹיִ֖ם] não [יִתְחַשָּֽׁב] não
\v 10 quem מָנָה֙ o-pó Jacó וּמִסְפָּ֖ר a רֹ֣בַע Israel תּוֹמֹ֤ת morrendo morte-de יְשָׁרִ֔ים וְתֵהַ֥י אַחֲרִיתִ֖י como-ele-verso-final
\v 11 E-disse בְּלָק֙ a בִּלְעָ֔ם מֶה fiz-te- a-mim לָקֹ֤ב אֹיְבַ֙י֙ לְקַחְתִּ֔יךָ e-eis ברכת abençoou
\v 12 [וַיַּ֖עַן] E-disse [הֲלֹ֗א] a que [יָשִׂ֤ים] yhwh [בְּפִ֔י] ele [אֶשְׁמֹ֖ר] [לְדַבֵּֽר]
\v 13 E-disse a-ele בלק נא ITHI a lugar-de outro que [מִשָּׁ֔ם] de-lá no-entanto [תִרְאֶ֔ה] verás não não תִרְאֶ֑ה e o quebamos- yhwh de-lá
\v 14 e tomou-o- campo- observando a cabeça E-edificou e-construiu sete [וַיַּ֛עַל] e-subiu פר ואיל em-o-altar
\v 15 E-disse a בלק estabeleceu-se assim sobre seu holocausto e-eu eu queirei assim-:
\v 16 e chamou-se yhwh a בִּלְעָ֔ם e-colocou palavra E-disse E-disse volta a בָּלָ֖ק e-assim תְדַבֵּֽר׃
\v 17 E-veio a-ele e eis estava de pé sobre oferta dele e-príncipes-de Moabe E-disse a-ele a-ele בלק yhwh palavra yhwh
\v 18 e-levantou מְשָׁל֖וֹ E-disse levantou בָּלָק֙ e-ouviu ouvireis até eu filho-de-ele Cipora:
\v 19 não homem El e enganará e-filho-de homem e se arrependerá disse disse e-não fazê-lo-á e falará e-não e levantará-se
\v 20 eis abençoou tomarei e abençoe e-não eu trarei
\v 21 não ele olhou אָוֶן em Jacó e-não viu yhwh em-Israel yhwh Elohim-dele com-ele e a trombeta rei em-ele
\v 22 El que me trazem de-Egito como asas רְאֵ֖ם a-ele
\v 23 que não de serpentes em Jacó e-não kesem em-Israel ka'et ye'amor le-ya'akov u-le-yishra'el que- pa'al El
\v 24 eis povo kalabiya' ya'qum ve-ka'ari não não יִשְׁכַּב֙ até yo'chal te'ref e-sangue- traspassados יִשְׁתֶּֽה׃
\v 25 E-disse בָּלָק֙ a בִּלְעָ֔ם não cabo- não não também abençoou não -eu-bendirei;
\v 26 e-respondeu בִּלְעָ֔ם E-disse a בלָק הלוא eu-falei dizendo dizendo todo yhwh ele yhwh ele -farei;
\v 27 E-disse בָּלָק֙ a בִּלְעָ֔ם venha- agora eu-pegarei-te- a lugar outro אוּלַ֤י -irá- aos-olhos-de o-Elohim -e-receberá-o- yhwh de-lá
\v 28 E-tomou בָּלָ֖ק a בִּלְעָ֑ם cabeça -o-fulgor- -o-reflexo- sobre face-de הַיְשִׁימֹֽן׃
\v 29 E-disse -bil-ay-am a בלק בנה- para-mim בוזה sete Mizbóqot והכן para-mim neste sete פָרִ֖ים e-sete איילים׃
\v 30 E-fez בלק como disse בִּלְעָ֑ם e-subiu פר ואיל em-o-altar
\c 24
\p
\v 1 E-viu balac que bom be-einei yhwh para-abençoar a Israel e-não andou Kéfa'im- em-vez ao-encontro-de Néchasim herdar-os a הַמִּדְבָּ֖ר faces-suas
\v 2 e-ele-leva Bil'á'am a E-viu E-viu a Israel שֹׁכֵ֖ן para-os-de-sua-fração espírito sobre-ele espírito Elohim
\v 3 e-levantou מְשָׁל֖וֹ E-disse oráculo-de -bil-ay-am -seu-filho Bé'ór Úne'óm Ha'geber שְׁתֻ֥ם a-fonte
\v 4 oráculo-de ouviu palavras-de El que Macháze' Shaddai Yecháze' caído וּגְל֥וּי Olhos:
\v 5 que [אֹהָלֶ֖יךָ] [יַעֲקֹ֑ב] Jacó [יִשְׂרָאֵֽל] Israel
\v 6 [כִּנְחָלִ֣ים] [נִטָּ֔יוּ] [כְּגַנֹּ֖ת] sobre rio [כַּאֲהָלִים֙] plantar yhwh [כַּאֲרָזִ֖ים] sobre águas
\v 7 יִֽזַּל־ águas de-sua-moistura e-seu-herdeiro em-aquas muitos e-eleva-lo de-Agag seu-rei e-eleve-se sua-majestade
\v 8 El que-o-saia do-Egito como-um-penacho רְאֵ֖ם a-ele יֹאכַ֞ל nações צָרָ֗יו וְעַצְמֹתֵיהֶ֛ם יְגָרֵ֖ם וְחִצָּ֥יו יִמְחָֽץ׃
\v 9 [כָּרַ֨ע] [שָׁכַ֧ב] [כַּאֲרִ֛י] [וּכְלָבִ֖יא] quem [יְקִימֶ֑נּוּ] [מְבָרֲכֶ֣יךָ] [בָר֔וּךְ] [וְאֹרְרֶ֖יךָ] maldito
\v 10 e-acendeu-se- אַ֤ף בָּלָק֙ a בִּלְעָ֔ם E-disse a כַּפָּ֑יו E-disse בָלָק׃ a balac לָקֹ֤ב אֹֽיְבַי֙ קְרָאתִ֔יךָ e-eis בֵּרַ֣ךְ abençoou este três vezes
\v 11 e-agora ברח- a-ti a מקומך- dissesse כב- אכ kabbedkha- yhwh מנעה- yhwh מקבוד-׃
\v 12 E-disse [בִּלְעָ֖ם] a [הֲלֹ֗א] também também a [אֵלַ֖י] que dizendo
\v 13 se dê para-mim בלק enchei ביתו- não וזהב- não אכלנו yhwh a boca-de yhwh para-fazer tobah ou yhwh ele que que yhwh ele אֲדַבֵּֽר׃
\v 14 e-agora eis-me הולך לעמי לְכוּ איעצך que ele-fará o-povo este לעמך באחרית os dias
\v 15 e-levantou מְשָׁל֖וֹ E-disse oráculo-de -bil-ay-am -seu-filho בעור וneaum הגבר שְׁתֻ֥ם a-fonte
\v 16 oráculo-de ouviu palavras-de El conhecimento דַּעַת עֶלְי֑וֹן מַחֲזֵ֤ה Shaddai יָחֱזֶ֔ה caído וּגְל֥וּי Olhos:
\v 17 אֶרְאֶ֙נּוּ֙ e-não עַתָּ֔ה אֲשׁוּרֶ֖נּוּ e-não קָר֑וֹב caminho estrela מִיַּעֲקֹ֗ב וְקָ֥ם שֵׁ֙בֶט֙ de-Israel וּמָחַץ֙ פַּאֲתֵ֣י Moabe וְקַרְקַ֖ר todo filhos-de Sete
\v 18 e-será Edom יְרֵשָׁ֗ה ve-hâyâ: יְרֵשָׁ֛ה Seir אֹיְבָ֑יו וְיִשְׂרָאֵ֖ל fez força
\v 19 [וְיֵ֖רְדְּ] [מִֽיַּעֲקֹ֑ב] [וְהֽ͏ֶאֱבִ֥יד] [שָׂרִ֖יד] [מֵעִֽיר]
\v 20 E-viu a Amaleque e-levantou מְשָׁל֖וֹ E-disse primeira nações Amaleque וְאַחֲרִית֖וֹ עֲדֵ֥י perdi-se
\v 21 E-viu a [וַיִּשָּׂ֥א] e-levantou [וַיֹּאמַ֑ר] E-disse [מֽוֹשָׁבֶ֔ךָ] [וְשִׂ֥ים] [בַּסֶּ֖לַע] [קִנֶּֽךָ]
\v 22 que se será para queimar קָ֑יִן até que Aššúrā serás queimado
\v 23 e-levantou מְשָׁל֖וֹ E-disse Ah! quem יִחְיֶה por causa dele El
\v 24 e carneiros da-mão-de cabras e se humilhem Assíria e se humilhem do outro lado do rio e-também ele עַד־ perdi-se
\v 25 E-levantou בִּלְעָ֔ם E-andou e-estabeleceu-se לִמְקוֹם־ e-também andar andou para-caminho-dele
\c 25
\p
\v 1 e-habitou Israel בָּשָׂטִים e-esperou o-povo para zinar a filhas-de Moabe
\v 2 וַתִּקְרֶאנָ para-o-povo לְזִבְחֵי אֱלֹהֵיהֶן e-comeu o-povo וַיִּשְׁתַּחֲווּ לֵאֱלֹהֵיהֶן׃
\v 3 וַיִּצְמָד Israel לְבַ֣עַל פּוּאֹר e-acendeu-se- yhwh yhwh em-Israel
\v 4 E-disse yhwh a Moisés qach a todo cabeças-de o-povo diante eles a-yhwh em-frente-de o-sol e voltando-se nós também yhwh מִיִּשְׂרָאֵֽל׃
\v 5 E-disse Moisés a os juízes Israel mataram homem seus-homens os que estavam presos a Baal P'or
\v 6 e-eis homem dos filhos de Israel veio e aproximou-se a irmãos-de-ele a a midianita aos-olhos-de Moisés e-perante-os-olhos-de todo congregação-de filhos-de Israel e-eles chorando entrada-de tenda encontro
\v 7 E-viu Pinhas filho-de Eleazar filho-de Aarao o-sacerdote E-levantou E-tomou a-congregação E-tomou romach em-mão-sua
\v 8 E-veio aḥar homem-de Israel a [אֶת־שְׁנֵיהֶ֔ם] vayidkor a dois-deles a homem Israel e-a de-cima-de a qovatāh vatʿazar hammegfā de-sobre filhos-de Israel
\v 9 וַיִּהְיוּ os-mortos bammegfā quatro e-vinte mil
\v 10 e-falou yhwh a Moisés
\v 11 pinḥas filho-de El'azar filho-de Aarão o-sacerdote de-cima-de a minha-furia de-sobre filhos-de Israel bqenaʾo a minha-quina que e-não כִלִּ֥יתִי a filhos-de Israel בְּקִנְאָתִֽי׃
\v 12 portanto disse eis-me deu a-ele a aliança-minha
\v 13 וְהָ֤יְתָה para-ele וּלְזַרְע֣וֹ apos-ele berith כְּהֻנַּ֣ת eternidade debaixo que קִנֵּא֙ לֵֽאלֹהָ֔יו e-o expiou sobre filhos-de Israel
\v 14 [וְשֵׁם֩] homem Israel [הַמֻּכֶּ֗ה] que [הֻכָּה֙] a [זִמְרִ֖י] [בֶּן־סָל֑וּא] filho-de [בֵֽית־אָ֖ב] [לַשִּׁמְעֹנִֽי] casa-de pai
\v 15 e-nome-de הָֽאִשָּׁ֧ה הַמֻּכָּ֛ה הַמִּדְיָנִ֖ית כָּזְבִּ֣י filha-de Zur cabeça אֻמּ֥וֹת casa-de ele בְּמִדְיָ֖ן ela
\v 16 e-falou yhwh a Moisés
\v 17 [צָר֖וֹר] a [וְהִכִּיתֶ֖ם] [אוֹתָֽם]
\v 18 que [צֹרְרִ֥ים] eles a-vós [בְּנִכְלֵיהֶ֛ם] que a-vós a-vós sobre palavra-de [בַת־נְשִׂ֤יא] e-sobre palavra [הַמֻּכָּ֥ה] [בְיוֹם־הַמַּגֵּפָ֖ה] [עַל־דְּבַר־פְּעֽוֹר] sobre
\v 19 e-houve depois-de a-magga
\c 26
\p
\v 1 E-disse yhwh a e-para e-a el-azar filho-de dizendo o-sacerdote para-dizer
\v 2 sa-u a rosh todo congregação-de filhos-de Israel de-filho-de vinte ano e-para-cima para-casa-de exército todo exército exército em-Israel
\v 3 e-falou Moisés ve-el-azar o-sacerdote eles be-arbat Moabe sobre yar-den dizendo para-dizer
\v 4 מִבֶּ֛ן vinte ano e-para-cima como-que ordenou yhwh a Moisés e-filhos-de Israel que saem da-terra-de Egito
\v 5 reuven primogênito-de Israel filhos-de Rúben cha-noch de-família ha-chanoki le-palua família-de hap-pallu'i:
\v 6 [לְחֶצְרֹ֕ן] família-de [הַֽחֶצְרוֹנִ֑י] [לְכַרְמִ֕י] família-de [הַכַּרְמִֽי]
\v 7 Estas mishpachot הָרֻֽאוּבֵנִ֑י e-foram פְקֻדֵיהֶ֗ם שְׁלֹשָׁ֤ה e-quarenta mil e-sete centenas e-trinta
\v 8 e-filhos-de פַלּ֖וּא אֱלִיאָֽב׃
\v 9 e-filhos-de אֱלִיאָ֔ב נְמוּאֵ֖ל וְדָתָ֣ן e o Abiram ele דָתָ֨ן e Abiram a congregação que הִצּ֜וּ sobre Moisés e-sobre Arão בַּעֲדַת־ Qorach בְּהַצֹּתָ֖ם sobre yhwh
\v 10 וַתִּפְתַּ֨ח a-terra a פִּ֗יהָ eles a-eles e-a קֹ֖רַח em-morte-de a-congregação בַּאֲכֹ֣ל הָאֵ֗שׁ a cinquenta u'ma'ăṭayim homem e-foram para-nês:
\v 11 e-filhos-de קֹ֖רַח não morreram
\v 12 filhos-de Shim`on֮ לְמִשְׁפְּחֹתֵיהֶֽם Li-nemúe'al família-de Ha-nemúe'eli li-yámin família-de hayyáminí li-yákín família-de hayyákín:
\v 13 li-zéraḥ família-de o-zarqi li-shé'ul família-de הַשָּׁאוּלִֽי׃
\v 14 Estas mishpachot הַשִּׁמְעֹנִ֑י dois e-vinte mil e-duzentos
\v 15 filhos-de [גָד֮] [לְמִשְׁפְּחֹתָם֒] [לִצְפ֗וֹן] família-de [הַצְּפוֹנִ֔י] [לְחַגִּ֕י] família-de [הַֽחַגִּ֑י] [לְשׁוּנִ֕י] família-de [הַשּׁוּנִֽי]
\v 16 לְאָזְנִ֕י família-de a orelha para a orelha família-de a orelha:
\v 17 para a arada família-de a arada para Arã família-de a Arã:
\v 18 Estas famílias-de filhos-de Gad conforme-seus-registros quarenta mil e-cinco centenas
\v 19 filhos-de Judá a vergonha e Onan E-morreu a vergonha וְאוֹנָ֖ן em-terra-de כְּנָֽעַן
\v 20 [וַיִּהְי֣וּ] filhos-de [לְמִשְׁפְּחֹתָם֒] [לְשֵׁלָ֗ה] [מִשְׁפַּ֙חַת֙] família-de [לְפֶ֕רֶץ] [מִשְׁפַּ֖חַת] família-de [לְזֶ֕רַח] [מִשְׁפַּ֖חַת] família-de
\v 21 e-foram filhos-de פֶ֔רֶץ לְחֶצְרֹ֕ן família-de הַֽחֶצְרֹנִ֑י para moído família-de o moído:
\v 22 Estas famílias-de Judá conforme-seus-registros seis e-setenta mil e-cinco centenas
\v 23 filhos-de Issacar לְמִשְׁפְּחֹתָ֔ם toula família-de o toula: para púah família-de púah:
\v 24 para yashob família-de o yashob: para shemerôn família-de הַשֿׁמְרֹנִֽי׃
\v 25 Estas famílias-de יִשָּׂשכָ֖ר conforme-seus-registros quatro e-sessenta mil e-três centenas
\v 26 filhos-de [זְבוּלֻן֮] [לְמִשְׁפְּחֹתָם֒] [לְסֶ֗רֶד] família-de [הַסַּרְדִּ֔י] [לְאֵל֕וֹן] família-de [הָאֵלֹנִ֑י] [לְיַ֨חְלְאֵ֔ל] família-de [הַיַּחְלְאֵלִֽי]
\v 27 Estas famílias-de הַזְּבוּלֹנִ֖י conforme-seus-registros sessenta mil e-cinco centenas
\v 28 filhos-de José segundo-famílias-deles ménashé E Efraim:
\v 29 filhos-de Menasheh para Machir\ de-família o meu Machir\ e Machir\ gerou a Galaad para Gileade\ família-de o meu Gileade:
\v 30 Estas filhos-de Gileade Iezer\ família-de o meu Iezer\ para a parte\ família-de a minha parte:
\v 31 [וְאַ֨שְׂרִיאֵ֔ל] família-de [הָֽאַשְׂרִֽאֵלִ֑י] [וְשֶׁ֕כֶם] família-de [הַשִּׁכְמִֽי]
\v 32 [וּשְׁמִידָ֕ע] família-de [הַשְּׁמִידָעִ֑י] [וְחֵ֕פֶר] família-de [הַֽחֶפְרִֽי]
\v 33 וּצְלָפְחָ֣ד filho-de חֵ֗פֶר a-ele havu que filhos porque se filhas ve-shem filhas-de tslafhad machla ve-noa chagla de-Malka vetirzah
\v 34 Estas mishpachot Manassés u-pikdeihem dois e-cinquenta mil e-sete centenas
\v 35 Estas filhos-de efrayim לְמִשְׁפְּחֹתֵיהֶֽם leshutelach família-de o-shotalchi le-beker família-de ha-bakri le-tachan família-de ha-tachani
\v 36 e-estes filhos-de shotalach le-eran família-de ha-erani
\v 37 Estas [מִשְׁפְּחֹ֤ת] filhos-de Efraim lipkudehem dois e-trinta mil e-cinco Estas estes filhos-de José para-famílias-deles
\v 38 filhos-de [בִנְיָמִן֮] [לְמִשְׁפְּחֹתָם֒] [לְבֶ֗לַע] família-de [הַבַּלְעִ֔י] [לְאַשְׁבֵּ֕ל] família-de [הָֽאַשְׁבֵּלִ֑י] [לַאֲחִירָ֕ם] família-de [הָאֲחִירָמִֽי]
\v 39 לִשְׁפוּפָם família-de הַשּׁוּפָמִי לְחוּפָם família-de o choepamí:
\v 40 e-foram filhos-de beláu árdd vé naamán família-de há ardí lén naamán família-de hán naami:
\v 41 Estas filhos-de Benjamim segundo-famílias-deles ú pukédiehem cinco e-quarenta mil e-seis centenas
\v 42 Estas filhos-de dán לְמִשְׁפְּחֹתָ֔ם lésuacham família-de Estas estes famílias-de דָּ֖ן para-famílias-deles
\v 43 todo famílias-de הַשׁוּחָמִ֖י quatro אַרְבָּעָ֧ה e-sessenta mil e-quatro centenas
\v 44 filhos-de que [לְמִשְׁפְּחֹתָם֒] [לְיִמְנָ֗ה] família-de [הַיִּמְנָ֔ה] [לְיִשְׁוִ֕י] família-de [הַיִּשְׁוִ֑י] [לִבְרִיעָ֕ה] família-de [הַבְּרִיעִֽי]
\v 45 aos-filhos-de בְרִיעָ֔ה לְחֶ֕בֶר família-de o hebrui para malakiel família-de o malakielí:
\v 46 e-nome-de filha-de que sarach:
\v 47 Estas famílias-de filhos-de que conforme-seus-registros três e-cinquenta mil e-quatro centenas
\v 48 filhos-de Nafthali לְמִשְׁפְּחֹתָ֔ם para yachzeil família-de o yachzeili para guni família-de o guni:
\v 49 para yetzer família-de o yetziri para completar família-de o que completará:
\v 50 Estas famílias-de Naftali segundo-famílias-deles e suas contas cinco e-quarenta mil e-quatro centenas
\v 51 Estas contas de filhos-de Israel seis-de centenas mil e mil sete centenas e-trinta
\v 52 e-falou yhwh a Moisés
\v 53 para os elohim separte a-terra na-inheritance em-número nomes:
\v 54 para muitos תַּרְבֶּה֙ herança-sua e para poucos תַּמְעִ֖יט sua herança homem de-conformidade-com seus registros seja-dado herança-dele
\v 55 somente por sorteio será dividido a a-terra para nomes carruagens- pais-deles terão herança
\v 56 sobre boca-minha o sorteio será dividido entre entre muito em pequenas porções
\v 57 ve-Eleh פקודים הַלּוּיִם לְמִשְׁפְּחֹתֵיהֶֽם לְגֵרְשׁוֹן família-de הַגֵּ֣רְשֻׁנּי לִקְהַת família-de o-coatita para-Merari família-de הַמררי׃
\v 58 Estas mishpachot לוּי da família הַלִיבני família-de הַחֵברוני família-de הַמָחללי de-família הַמָUSHי família-de a febre e-Coate gerou a Amram:
\v 59 e o nome de mulher-de Amram Jochébed filha-de Levi que ela-deu-à-luz ela para Levi em-Egito e-deu-à-luz para Amram a Arão e-a Moisés e-a Miriam אֲחֹתָֽם׃
\v 60 foi gerado para Arão a Nadabe e-a אביהו a Elazar e-a aitamar:
\v 61 E-morreu Nadabe וַאֲבִיה֑וּא בהקריבוֹם fogo- זרעה yhwh yhwh
\v 62 e-foram פקודיהם שלושה e-vinte mil todo macho de-filho-de que e-para-cima não não no-meio-de בתוך filhos-de que porque a-eles deu no-meio-de נחלא em-meio-de filhos-de Israel
\v 63 Estas pikuday Moisés Elazar o-sacerdote que פקדוּ a filhos-de Israel בערות sobre sobre Jordão יְרֵחֽוֹ׃
\v 64 e Bealéh não foi homem dos Piquedei Moisés e-Aarão o-sacerdote que Piquedoo a filhos-de Israel em-deserto-de Sinai
\v 65 porque yhwh a-eles morrendo morrer yamatu no-deserto e-não Natar que homem porque se Kalev filho-de yefunneh e Josué filho-de Nun:
\c 27
\p
\v 1 e Tikkabnáh filhas-de Tsélapachad filho-de Chéfer filho-de Gil'ad filho-de Machir filho-de Manassés [שְׁמ֣וֹת] מְנַשֶּׁ֣ה filho-de José e-estes nomes-de filhas-as Machlah Noah e-Chagla e-Milcah e-Tirzah:
\v 2 e-estavam-se diante-de Moisés e-diante-de Eleazar o-sacerdote e-diante-de os-negros e-todo a-congregação porta dizendo encontro para-dizer
\v 3 nosso-pai morreu no-o-deserto וְה֨וּא não no-meio-de em-meio-de a congregação הַנּוֹעָדִ֛ים sobre yhwh בַּעֲדַת־ קֹ֑רַח porque a-ele morreu e-filhos não a-ele a-ele
\v 4 por-que יִגָּרַ֤ע nome-de אָבִ֙ינוּ֙ do-meio-de que porque a-ele filho filho dá- no-meio-de אֲחֻזָּ֔ה em-meio-de irmãos-de אָבִֽינוּ׃
\v 5 e-ele-se-aproximou Moisés a diante-de yhwh
\v 6 E-disse yhwh a Moisés
\v 7 assim filhas-de צְלָפְחָד֮ דֹּבְרֹת֒ deu תִּתֵּ֤ן a-eles achuzat herança no-meio-de irmãos pai-deles e transferireis a herança o-pai-deles elas
\v 8 e-a filhos-de Israel dizendo dizendo homem porque morre a-ele não-há a-ele e transferireis a seu-pai a filha dele
\v 9 e-se a-ele a-ele filha e-dareis a seu-pai aos irmãos
\v 10 e-se a-ele a-ele [וּנְתַתֶּ֥ם] [אֶת־נַחֲלָת֖וֹ] a seu-pai
\v 11 e-se não-há אַחִים֮ לְאָבִיו֒ ונתתם a נַחֲלָת֗וֹ a-ele o-próximo a-ele מִמִּשְׁפַּחְתּ֖וֹ וְיָרַ֣שׁ a-ela e será para-filhos-de Israel para a lei מִשְׁפָּט yhwh ordenou yhwh a Moisés
\v 12 E-disse yhwh a folhas-de עֲלֵ֛ה a monte-de הָעֲבָרִ֖ים este וּרְאֵה֙ dei a-terra que dei para-filhos-de Israel
\v 13 וְרָאִ֣יתָה a-ela e congregareis-vos a seu povo também tu como congregareis-vos Aarão irmão-teu
\v 14 como-que querestes minha boca בְּמִדְבַּר־ cobre em disputa testemunho para santificarei-vos-me em água eles הֵ֛ם águas-de מריבה santo sobre צין
\v 15 e-falou Moisés a dizendo
\v 16 ele guardará yhwh Elohim-de הרוחות para-todo carne homem sobre הָעֵדָֽה׃
\v 17 que sairá em-frente-a-eles e-que virá em-frente-de-eles e-que יוציאים e-que יביאם e-não תהיה yhwh yhwh -o rebanho que não-há a-eles راعה
\v 18 E-disse yhwh a Moisés toma a-ti a Yehoshua filho-de Nun homem que espírito nele וסמכת a mão-tua sobre-ele
\v 19 והעמדת ele diante-de Eleazar o-sacerdote וְלִפְנֵ֖י todo a-congregação ele ele per-ey-nay-hem
\v 20 e-tu-darás mh hodcha sobre-ele para-que eles-ouvirão todo congregação-de filhos-de Israel
\v 21 e diante de Elazar o-sacerdote ele se levantará e perguntará a-ele em julgamento dos brilhantes diante-de yhwh sobre de-seu-boca saírem e-sobre ele virão ele e-todo filhos-de Israel com-ele e-todo הָעֵדָֽה׃
\v 22 E-fez Moisés como ordenou yhwh ele E-tomou a Josué e o levantou diante-de Eleazar o-sacerdote וְלִפְנֵ֖י todo הָעֵדָֽה׃
\v 23 e apoiou a suas mãos sobre-ele e ordenou-lhe como yhwh yhwh por-mão-de Moisés
\c 28
\p
\v 1 e-falou yhwh a Moisés
\v 2 ordene a filhos-de Israel e-dirás a-eles a oferecimento-me pão-me mulher-meu cheiro aromático-me guardem le-hakriv yhwh no-sua-celebração:
\v 3 e-dirás a-eles este a-mulher que aproximareis a-yhwh cordeiros filhos-de ano témimim dois para-o-dia holocausto תָמִֽיד׃
\v 4 a um um farás e-[OBJ] e-[OBJ] [הַשֵּׁנִ֔י] o-segundo entre entre
\v 5 vá'ăśerít hā'ăyfá farinha-fina léminnáchah bəlulá bəšémen kāṯı̂ṯ quarto deste vinho
\v 6 ōlát permanente hā'ăśāyah em-monte-de Sinai para-aroma agradavel mulher a-yhwh
\v 7 véniskó רביעית deste vinho לכּבשׂ o-primeiro no-santo ה Sark נסך bebida a-yhwh
\v 8 e-את o carneiro o-segundo vós-fará entre הערביים כמנחת הבקר וכנסכו farás mulher aroma-de agradavel a-yhwh
\v 9 וביום הַשָּׁבָת dois כבשים filhos-de ano [עֶשְׂרֹנִ֗ים] e-dois עֶשְׂרֹנִ֗ים סֹ֧לֶת oferta misturada em-o-óleo וְנִסְכּֽוֹ׃
\v 10 oferta-que-subiu שַׁבַּ֖ת בְּשַׁבַּתּ֑וֹ sobre oferta-que-subiu a-perpétua וְנִסְכָּֽהּ׃
\v 11 וּבְרָאשֵׁי֙ חָדְשֵׁיכֶ֔ם vós-oferecereis holocausto a-yhwh פָּרִ֨ים filhos-de manhã dois um um cordeiros filhos-de ano sete temimim-
\v 12 e-três עֶשְׂרֹנִ֗ים farinha-a oferta-de-cereais em-estado-de-mistura no-óleo -para-o-par o-primeiro e-dois -dez-unhas farinha-a oferta-de-cereais em-estado-de-mistura no-óleo para-o-carneiro o-primeiro
\v 13 [וְעִשָּׂרֹ֣ן] [עִשָּׂר֗וֹן] farinha-a oferta-de-cereais em-estado-de-mistura no-óleo לכּבשׂ o-primeiro עֹלָה֙ aroma agradavel mulher a-yhwh
\v 14 [וְנִסְכֵּיהֶ֗ם] metade [הַהִין֩] será [לַפָּ֜ר] [וּשְׁלִישִׁ֧ת] [הַהִ֣ין] [לָאַ֗יִל] [וּרְבִיעִ֥ת] [הַהִ֛ין] לכּבשׂ vinho esta oferta-que-subiu novo [בְּחָדְשׁ֔וֹ] le-chadshi ha-shana
\v 15 [וּשְׂעִ֨יר] [עִזִּ֥ים] um para-pecado a-yhwh sobre [הַתָּמִ֛יד] [יֵעָשֶׂ֖ה] será-fazido וְנִסְכּֽוֹ׃
\v 16 [וּבַחֹ֣דֶשׁ] o-primeiro בְּאַרְבָּעָ֥ה dez dia para-o-mês Pésach a-yhwh
\v 17 e na quinta dez dia para-o-mes este comemore- sete dias não-fermentados ser-aco-lido
\v 18 no-dia הָרִאשׁ֖וֹן מִקְרָא- santidade todo não servico não fazeis:
\v 19 [וְהִקְרַבְתֶּ֨ם] mulher [עֹלָה֙] a-yhwh [פָּרִ֧ים] filhos-de manhã dois um um [כְבָשִׂים֙] [בְּנֵ֣י] filhos-de ano [יִהְי֥וּ] a-vós
\v 20 [וּמִ֨נְחָתָ֔ם] farinha-fina em-estado-de-mistura com-o-açúcar שְׁלֹשָׁ֨ה עֶשְׂרֹנִ֜ים [לַפָּ֗ר] e-dois [עֶשְׂרֹנִ֛ים] para-o-carneiro façam
\v 21 [עִשָּׂר֤וֹן] [עִשָּׂרוֹן֙] farás לכּבשׂ o-primeiro [לְשִׁבְעַ֖ת] [הַכְּבָשִֽׂים]
\v 22 [וּשְׂעִ֥יר] pecado um para-ter-expiação sobre-vós
\v 23 [מִלְּבַד֙] holocausto-de a-manhã que [לְעֹלַ֣ת] [הַתָּמִ֑יד] farão a Estas
\v 24 [כָּאֵ֜לֶּה] [תַּעֲשׂ֤וּ] para o dia sete dias pão mulher aroma-de agradavel a-yhwh sobre [יֵעָשֶׂ֖ה] [וְנִסְכּֽוֹ] será-fazido וְנִסְכּֽוֹ׃
\v 25 e-no-dia o-sétimo מִקְרָא- será a-vós a-vós todo não servico não fazeis:
\v 26 e-no-dia-de [הַבִּכּוּרִ֗ים] [בְּהַקְרִ֨יבְכֶ֜ם] [מִנְחָ֤ה] nova a-yhwh [בְּשָׁבֻעֹ֖תֵיכֶ֑ם] מִֽקְרָא־ será a-vós a-vós todo não servico não fazeis:
\v 27 וְהִקְרַבְתֶּ֨ם oferta por odor agradável a-yhwh [פָּרִ֧ים] filhos-de manhã dois um um sete [בְּנֵ֥י] filhos-de anos
\v 28 [וּמִנְחָתָ֔ם] farinha-fina em-estado-de-mistura com-o-açúcar שְׁלֹשָׁ֤ה [עֶשְׂרֹנִים֙] [לַפָּ֣ר] o-primeiro segundo deas onças para-o-carneiro o-primeiro
\v 29 [עִשָּׂרוֹן֙] [עִשָּׂר֔וֹן] [לַכֶּ֖בֶשׂ] o-primeiro [לְשִׁבְעַ֖ת] [הַכְּבָשִֽׂים]
\v 30 [שְׂעִ֥יר] cabras um para-ter-expiação sobre-vós
\v 31 [מִלְּבַ֞ד] [עֹלַ֧ת] [הַתָּמִ֛יד] [וּמִנְחָת֖וֹ] fazeis-vós [תְּמִימִ֥ם] [יִהְיוּ־לָכֶ֖ם] a-vós [sem-traducao]
\c 29
\p
\v 1 [וּבַחֹ֨דֶשׁ] הַשְׁבִיעִ֜י no-primeiro no mês מִֽקְרָא־ será a-vós a-vós todo não servico dia fareis será a-vós será a-vós
\v 2 e-fareis [עֹלָ֜ה] por odor agradável a-yhwh [פַּ֧ר] filho-de um um um um cordeiros filhos-de ano sete temimim-
\v 3 [וּמִנְחָתָ֔ם] farinha-fina em-estado-de-mistura com-o-açúcar שְׁלֹשָׁ֤ה [עֶשְׂרֹנִים֙] para-o-touro segundo [עֶשְׂרֹנִ֖ים] [לָאָֽיִל]
\v 4 [וְעִשָּׂר֣וֹן] um [לַכֶּ֖בֶשׂ] o-primeiro [לְשִׁבְעַ֖ת] [הַכְּבָשִֽׂים]
\v 5 e o carneiro- um um חטא para-ter-expiação sobre-vós
\v 6 [מִלְּבַד֩] [עֹלַ֨ת] [הַחֹ֜דֶשׁ] [וּמִנְחָתָ֗הּ] [וְעֹלַ֤ת] הַתָּמִיד֙ [וּמִנְחָתָ֔הּ] [וְנִסְכֵּיהֶ֖ם] [כְּמִשְׁפָּטָ֑ם] para-aroma agradavel mulher a-yhwh
\v 7 [וּבֶעָשׂוֹר֩] para-o-mês הַשְׁבִיעִ֜י este מִֽקְרָא־ será a-vós a-vós וְעִנִּיתֶ֖ם a não todo não não fazeis:
\v 8 וְהִקְרַבְתֶּ֨ם holocausto a-yhwh aroma agradavel [פַּ֧ר] filho-de um um um um кָבָשִׂ֤ים filhos-de ano sete a-vós a-ti a-vós
\v 9 [וּמִנְחָתָ֔ם] farinha-fina em-estado-de-mistura com-o-açúcar שְׁלֹשָׁ֤ה [עֶשְׂרֹנִים֙] para-o-touro segundo deas onças para-o-carneiro o-primeiro
\v 10 [עִשָּׂרוֹן֙] [עִשָּׂר֔וֹן] [לַכֶּ֖בֶשׂ] o-primeiro [לְשִׁבְעַ֖ת] [הַכְּבָשִֽׂים]
\v 11 Seir um um חטא [חַטַּ֤את] [הַכִּפֻּרִים֙] [וְעֹלַ֣ת] [הַתָּמִ֔יד] o-contínuo e-sua-oferta-de-cereais [sem-traducao]
\v 12 [וּבַחֲמִשָּׁה֩] dez dia no-mês o-sétimo מִֽקְרָא־ será a-vós a-vós todo não servico não fareis ve-chag-getem [שִׁבְעַ֥ת] a-yhwh sete dias
\v 13 וְהִקְרַבְתֶּ֨ם [עֹלָ֜ה] mulher רֵ֤יחַ agradável a-yhwh [פָּרִ֧ים] filhos-de manhã três dez carneiros dois cordeiros quatro ano quatro dez [sem-traducao] ser-ão
\v 14 [וּמִנְחָתָ֔ם] farinha-fina em-estado-de-mistura com-o-açúcar שְׁלֹשָׁ֨ה עֶשְׂרֹנִ֜ים [לַפָּ֣ר] o-primeiro לשלושה dez [פָּרִ֔ים] segundo [עֶשְׂרֹנִים֙] para-a-ove o-primeiro [לִשְׁנֵ֖י] ha-eilim-
\v 15 [וְעִשָּׂרוֹׄן֙[4]] [עִשָּׂר֔וֹן] [לַכֶּ֖בֶשׂ] o-primeiro dez [עָשָׂ֖ר]
\v 16 e o carneiro- um um חטא [עֹלַ֣ת] holocausto-de o-contínuo [וְנִסְכָּֽהּ׃] וְנִסְכָּֽהּ׃
\v 17 e-no-dia haseni [פָּרִ֧ים] filhos-de manhã dois dez carneiros dois cordeiros quatro ano quatro dez temimim-
\v 18 [וּמִנְחָתָ֣ם] [וְנִסְכֵּיהֶ֡ם] [לַ֠פָּרִים] [לָאֵילִ֧ם] [וְלַכְּבָשִׂ֛ים] [בְּמִסְפָּרָ֖ם] como-o-julgamento
\v 19 e o carneiro- um um חטא [עֹלַ֣ת] holocausto-de o-contínuo e-sua-oferta-de-cereais [sem-traducao]
\v 20 [וּבַיּ֧וֹם] o-terceiro [פָּרִ֥ים] ashtei- dez carneiros dois cordeiros quatro ano quatro dez temimim-
\v 21 [וּמִנְחָתָ֣ם] [וְנִסְכֵּיהֶ֡ם] [לַ֠פָּרִים] [לָאֵילִ֧ם] [וְלַכְּבָשִׂ֛ים] [בְּמִסְפָּרָ֖ם] como-o-julgamento
\v 22 [וּשְׂעִ֥יר] pecado um [מִלְּבַד֙] holocausto-de o-contínuo e-sua-oferta-de-cereais וְנִסְכָּֽהּ׃
\v 23 [וּבַיּ֧וֹם] o-quarto [פָּרִ֥ים] [עֲשָׂרָ֖ה] carneiros dois cordeiros filhos-de quatro quatro dez temimim-
\v 24 [מִנְחָתָ֣ם] [וְנִסְכֵּיהֶ֡ם] [לַ֠פָּרִים] [לָאֵילִ֧ם] [וְלַכְּבָשִׂ֛ים] [בְּמִסְפָּרָ֖ם] como-o-julgamento
\v 25 e o carneiro- um um חטא [עֹלַ֣ת] holocausto-de o-contínuo [וְנִסְכָּֽהּ׃] וְנִסְכָּֽהּ׃
\v 26 [וּבַיּ֧וֹם] [הַחֲמִישִׁ֛י] [פָּרִ֥ים] [תִּשְׁעָ֖ה] carneiros dois cordeiros filhos-de quatro quatro dez temimim-
\v 27 [וּמִנְחָתָ֣ם] [וְנִסְכֵּיהֶ֡ם] [לַ֠פָּרִים] [לָאֵילִ֧ם] [וְלַכְּבָשִׂ֛ים] [בְּמִסְפָּרָ֖ם] como-o-julgamento
